{%- comment %} ══════════════════════════════════════════════════════════
   STYLES
══════════════════════════════════════════════════════════ {% endcomment %}
<style>
/* ─────────────────────────────────────────────────────────
   Tokens & Reset
───────────────────────────────────────────────────────── */
#{{ sid }},
#{{ sid }}-search,
#{{ sid }}-drawer,
#{{ sid }}-bar {
  --ph3-cream:   #FDFCF9;
  --ph3-stone:   #1C1917;
  --ph3-accent:  #D97757;
  --ph3-warm:    #F5EFE6;
  --ph3-muted:   #78716C;
  --ph3-border:  #EAE5DD;
  --ph3-success: #6DB87A;
  --ph3-r:       12px;
  --ph3-r-sm:    8px;
  --ph3-ease:    cubic-bezier(0.22, 1, 0.36, 1);
  --ph3-spring:  cubic-bezier(0.34, 1.56, 0.64, 1);
  --ph3-h:       66px;
  --ph3-strip-h: 34px;
  font-family: inherit;
}

/* ─────────────────────────────────────────────────────────
   ANNOUNCEMENT BAR
───────────────────────────────────────────────────────── */
#{{ sid }}-bar {
  position:   relative;
  z-index:    200;
  background: var(--bar-bg, var(--ph3-accent));
  color:      var(--bar-fg, #fff);
  height:     36px;
  display:    flex;
  align-items:center;
  overflow:   hidden;
  transition: max-height 0.40s ease, opacity 0.30s ease;
  max-height: 36px;
}
#{{ sid }}-bar.ph3-bar--gone {
  max-height: 0;
  opacity:    0;
  pointer-events: none;
}
.ph3-bar__marquee {
  flex:     1;
  overflow: hidden;
  position: relative;
}
.ph3-bar__track {
  display:   flex;
  width:     max-content;
  animation: ph3-marquee 28s linear infinite;
}
@keyframes ph3-marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.ph3-bar__item {
  display:     inline-flex;
  align-items: center;
  gap:         20px;
  padding:     0 40px;
  font-size:   0.78rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.ph3-bar__link {
  color:           inherit;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.ph3-bar__dot {
  font-size:   0.65rem;
  opacity:     0.6;
}
.ph3-bar__close {
  position:      absolute;
  right:         14px;
  top:           50%;
  transform:     translateY(-50%);
  background:    none;
  border:        none;
  cursor:        pointer;
  color:         inherit;
  opacity:       0.75;
  padding:       6px;
  border-radius: 50%;
  line-height:   0;
  transition:    opacity 0.2s ease, background 0.2s ease;
  z-index:       2;
}
.ph3-bar__close:hover  { opacity:1; background:rgba(0,0,0,0.12); }

/* ─────────────────────────────────────────────────────────
   HEADER BASE
───────────────────────────────────────────────────────── */
#{{ sid }} {
  position:    relative;
  z-index:     100;
  background:  var(--ph3-cream);
  border-bottom: 1px solid var(--ph3-border);
  transition:  box-shadow 0.35s ease, border-color 0.35s ease,
               background 0.35s ease;
}
#{{ sid }}.ph3--sticky { position: sticky; top: 0; }
#{{ sid }}.ph3--scrolled {
  background:    rgba(253, 252, 249, 0.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:    0 2px 24px rgba(28,25,23,0.08);
  border-color:  transparent;
}

/* ─────────────────────────────────────────────────────────
   UTILITY STRIP (top micro-bar)
───────────────────────────────────────────────────────── */
.ph3__strip {
  border-bottom: 1px solid var(--ph3-border);
  background:    var(--ph3-warm);
  height:        var(--ph3-strip-h);
  display:       flex;
  align-items:   center;
  overflow:      hidden;
  transition:    height 0.35s ease, opacity 0.35s ease;
}
#{{ sid }}.ph3--scrolled .ph3__strip {
  height:  0;
  opacity: 0;
  pointer-events: none;
}
.ph3__strip-inner {
  width:       100%;
  {% comment %} max-width:   1380px; {% endcomment %}
  margin:      0 auto;
  padding:     0 clamp(16px, 4vw, 60px);
  display:     flex;
  align-items: center;
  justify-content: space-between;
  gap:         12px;
}
.ph3__strip-left {
  display:     flex;
  align-items: center;
  gap:         6px;
  font-size:   0.73rem;
  color:       var(--ph3-muted);
  margin:      0;
  font-weight: 500;
}
.ph3__strip-left svg { color: var(--ph3-accent); flex-shrink:0; }
.ph3__strip-right {
  display:     flex;
  align-items: center;
  gap:         2px;
}
.ph3__strip-link {
  font-size:       0.73rem;
  color:           var(--ph3-muted);
  text-decoration: none;
  font-weight:     500;
  padding:         3px 10px;
  border-radius:   var(--ph3-r-sm);
  transition:      color 0.2s ease, background 0.2s ease;
  white-space:     nowrap;
}
.ph3__strip-link:hover { color: var(--ph3-stone); background: var(--ph3-border); }
.ph3__strip-link--static { cursor:default; }
.ph3__strip-link--static:hover { background:none; color:var(--ph3-muted); }

/* ─────────────────────────────────────────────────────────
   MAIN NAV ROW
───────────────────────────────────────────────────────── */
.ph3__main { height: var(--ph3-h); }
.ph3__main-inner {
  height:          100%;
  {% comment %} max-width:       1380px; {% endcomment %}
  margin:          0 auto;
  padding:         0 clamp(16px, 4vw, 60px);
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  gap:             24px;
}

/* ─────────────────────────────────────────────────────────
   LOGO
───────────────────────────────────────────────────────── */
.ph3__logo {
  text-decoration: none;
  flex-shrink:     0;
  display:         inline-flex;
  align-items:     center;
}
.ph3__logo-img {
  max-width:  var(--ph3-logo-w);
  max-height: 46px;
  object-fit: contain;
  display:    block;
  transition: max-height 0.35s ease;
}
#{{ sid }}.ph3--scrolled .ph3__logo-img { max-height: 36px; }

.ph3__logo-mark {
  display:     flex;
  align-items: center;
  gap:         10px;
}
.ph3__logo-icon {
  flex-shrink: 0;
  display:     flex;
  align-items: center;
  transition:  transform 0.55s var(--ph3-spring);
}
.ph3__logo:hover .ph3__logo-icon { transform: rotate(-8deg) scale(1.08); }
.ph3__logo-name {
  font-size:      1.45rem;
  font-weight:    800;
  color:          var(--ph3-stone);
  letter-spacing: -0.025em;
  line-height:    1;
}

/* ─────────────────────────────────────────────────────────
   DESKTOP NAV
───────────────────────────────────────────────────────── */
.ph3__nav {
  flex:            1;
  display:         flex;
  justify-content: center;
}
.ph3__nav-list {
  display:     flex;
  align-items: center;
  gap:         2px;
  list-style:  none;
  margin:      0;
  padding:     0;
}
.ph3__item { position: relative; }

/* Nav link — pill style */
.ph3__link {
  display:         inline-flex;
  align-items:     center;
  gap:             4px;
  padding:         7px 15px;
  border-radius:   100px;
  font-size:       0.91rem;
  font-weight:     600;
  color:           var(--ph3-stone);
  text-decoration: none;
  background:      none;
  border:          none;
  cursor:          pointer;
  white-space:     nowrap;
  font-family:     inherit;
  transition:
    background 0.22s ease,
    color      0.22s ease,
    transform  0.22s var(--ph3-spring);
  position: relative;
}
.ph3__link:hover,
.ph3__link--active,
.ph3__link--btn[aria-expanded="true"] {
  background: var(--ph3-warm);
  color:      var(--ph3-accent);
}
.ph3__link:focus-visible {
  outline:        2px solid var(--ph3-accent);
  outline-offset: 2px;
}

/* Sale link */
.ph3__link--sale {
  color: #C1441C;
  font-weight: 700;
}
.ph3__link--sale:hover {
  background: rgba(193,68,28,0.09);
  color: #C1441C;
}
.ph3__sale-dot {
  width:         7px;
  height:        7px;
  border-radius: 50%;
  background:    #C1441C;
  flex-shrink:   0;
  animation:     ph3-sale-pulse 1.4s ease-in-out infinite;
}
@keyframes ph3-sale-pulse {
  0%,100% { opacity:1; transform:scale(1);    box-shadow: 0 0 0 0 rgba(193,68,28,0.4); }
  50%     { opacity:0.8; transform:scale(1.2); box-shadow: 0 0 0 4px rgba(193,68,28,0); }
}

/* Chevron */
.ph3__chevron {
  display:    flex;
  align-items:center;
  opacity:    0.5;
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.ph3__link--btn[aria-expanded="true"] .ph3__chevron {
  transform: rotate(180deg);
  opacity:   1;
}

/* ─────────────────────────────────────────────────────────
   MEGA MENU
───────────────────────────────────────────────────────── */
.ph3__mega {
  position:    absolute;
  top:         calc(100% + 14px);
  left:        50%;
  transform:   translateX(-50%) translateY(-6px);
  width:       min(800px, 94vw);
  background:  #fff;
  border:      1px solid var(--ph3-border);
  border-radius: 20px;
  box-shadow:
    0 4px 6px rgba(28,25,23,0.04),
    0 20px 60px rgba(28,25,23,0.12);
  opacity:       0;
  visibility:    hidden;
  pointer-events:none;
  transition:
    opacity    0.28s ease,
    transform  0.28s var(--ph3-ease),
    visibility 0.28s;
  z-index:    400;
  overflow:   hidden;
}
/* Caret */
.ph3__mega::before {
  content:     '';
  position:    absolute;
  top:         -6px;
  left:        50%;
  transform:   translateX(-50%) rotate(45deg);
  width:       12px;
  height:      12px;
  background:  #fff;
  border-top:  1px solid var(--ph3-border);
  border-left: 1px solid var(--ph3-border);
  border-radius: 3px 0 0 0;
}
/* Open state */
.ph3__item--mega:hover .ph3__mega,
.ph3__item--mega .ph3__link--btn[aria-expanded="true"] ~ .ph3__mega {
  opacity:       1;
  visibility:    visible;
  pointer-events:auto;
  transform:     translateX(-50%) translateY(0);
}

.ph3__mega-wrap {
  display: grid;
  grid-template-columns: 1fr 200px;
}
.ph3__mega-cols {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap:     0;
  padding: 28px;
}
.ph3__mega-col {
  padding: 0 20px 0 0;
  border-right: 1px solid var(--ph3-border);
}
.ph3__mega-col:first-child  { padding-left: 0; }
.ph3__mega-col:last-child   { border-right: none; padding-right: 0; }

.ph3__mega-head {
  font-size:      0.72rem;
  font-weight:    700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  color:          var(--ph3-accent);
  margin:         0 0 12px;
  padding-left:   2px;
}
.ph3__mega-list {
  list-style: none;
  margin:     0;
  padding:    0;
  display:    flex;
  flex-direction: column;
  gap:        2px;
}
.ph3__mega-link {
  display:         block;
  padding:         6px 10px;
  border-radius:   var(--ph3-r-sm);
  font-size:       0.87rem;
  color:           var(--ph3-muted);
  font-weight:     500;
  text-decoration: none;
  transition:      background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}
.ph3__mega-link:hover {
  background: var(--ph3-warm);
  color:      var(--ph3-stone);
  transform:  translateX(3px);
}
.ph3__mega-link:focus-visible {
  outline: 2px solid var(--ph3-accent);
  outline-offset: 2px;
}

/* Promo card */
.ph3__mega-promo {
  background:    var(--ph3-warm);
  border-left:   1px solid var(--ph3-border);
  display:       flex;
  flex-direction:column;
  overflow:      hidden;
}
.ph3__mega-promo-img { flex:1; overflow:hidden; min-height:130px; }
.ph3__mega-promo-photo {
  width:      100%;
  height:     100%;
  object-fit: cover;
  display:    block;
  transition: transform 0.55s ease;
}
.ph3__mega-promo:hover .ph3__mega-promo-photo { transform:scale(1.06); }
.ph3__mega-promo-placeholder {
  flex:       1;
  background: linear-gradient(135deg,
    rgba(217,119,87,0.15),
    rgba(217,119,87,0.06)
  );
  display:    flex;
  align-items:flex-end;
}
.ph3__mega-promo-body {
  padding: 18px;
}
.ph3__mega-promo-badge {
  display:        inline-block;
  font-size:      0.68rem;
  font-weight:    700;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color:          var(--ph3-accent);
  background:     rgba(217,119,87,0.13);
  padding:        4px 10px;
  border-radius:  100px;
  margin-bottom:  8px;
}
.ph3__mega-promo-title {
  font-size:   0.92rem;
  font-weight: 700;
  color:       var(--ph3-stone);
  margin:      0 0 12px;
  line-height: 1.3;
}
.ph3__mega-promo-cta {
  display:         inline-flex;
  align-items:     center;
  gap:             5px;
  font-size:       0.80rem;
  font-weight:     700;
  color:           var(--ph3-accent);
  text-decoration: none;
  transition:      gap 0.25s ease;
}
.ph3__mega-promo-cta:hover { gap: 8px; }

/* ─────────────────────────────────────────────────────────
   SIMPLE DROPDOWN
───────────────────────────────────────────────────────── */
.ph3__drop {
  position:    absolute;
  top:         calc(100% + 14px);
  left:        50%;
  transform:   translateX(-50%) translateY(-6px);
  min-width:   210px;
  background:  #fff;
  border:      1px solid var(--ph3-border);
  border-radius: var(--ph3-r);

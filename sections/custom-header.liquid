{% comment %}
  ╔══════════════════════════════════════════════════════════════════╗
  ║  SECTION  : Pet Shop Header — Redesigned                         ║
  ║  Style    : Warm Editorial / Organic D2C                         ║
  ║  Palette  : Cream #FDFCF9 · Stone #1C1917 · Terracotta #D97757  ║
  ║  Version  : 3.0.0                                                ║
  ║                                                                  ║
  ║  WHAT'S NEW                                                      ║
  ║  • Pill-style nav links with warm hover fills                    ║
  ║  • Two-tier header: utility bar + main nav bar                   ║
  ║  • Floating mega-menu with image cards                           ║
  ║  • Animated logo paw-print wordmark                              ║
  ║  • Warm gradient announcement bar                                ║
  ║  • Mobile drawer with warm palette + pet emoji accents           ║
  ║  • Backdrop-blur glass header on scroll                          ║
  ╚══════════════════════════════════════════════════════════════════╝
{% endcomment %}

{%- liquid
  assign sid          = 'ph3-' | append: section.id
  assign s            = section.settings

  assign bg_default   = '#FDFCF9'
  assign accent_def   = '#D97757'
  assign stone_def    = '#1C1917'
  assign muted_def    = '#78716C'
  assign border_def   = '#EAE5DD'

  assign logo_img     = s.logo_image
  assign logo_text    = s.logo_text    | default: shop.name
  assign logo_w       = s.logo_max_width | default: 150
  assign main_menu    = s.main_menu

  assign bar_bg       = s.announcement_bg    | default: '#D97757'
  assign bar_fg       = s.announcement_fg    | default: '#FFFFFF'
  assign bar_text     = s.announcement_text  | default: '🐾 Free shipping on orders $50+ &nbsp;·&nbsp; Code: PETLOVE for 10% off &nbsp;·&nbsp; Vet-approved products'
  assign bar_url      = s.announcement_url
  assign bar_dismiss  = s.announcement_dismissible

  assign show_search  = s.show_search
  assign show_account = s.show_account
  assign show_cart    = s.show_cart
  assign show_whislist = s.show_wishlist
  assign sticky       = s.enable_sticky
  assign show_progress = s.show_scroll_progress
-%}

{%- comment %} ══════════════════════════════════════
  ANNOUNCEMENT BAR
══════════════════════════════════════ {% endcomment %}
{%- if s.show_announcement_bar and bar_text != blank %}
<div
  id="{{ sid }}-bar"
  class="ph3-bar"
  style="--bar-bg:{{ bar_bg }}; --bar-fg:{{ bar_fg }};"
  role="region"
  aria-label="Announcement"
  data-ph3-bar
>
  <div class="ph3-bar__marquee" aria-live="polite">
    <div class="ph3-bar__track" aria-hidden="true">
      {%- for i in (1..4) %}
        <span class="ph3-bar__item">
          {%- if bar_url != blank %}
            <a href="{{ bar_url }}" class="ph3-bar__link">{{ bar_text }}</a>
          {%- else %}
            {{ bar_text }}
          {%- endif %}
          <span class="ph3-bar__dot" aria-hidden="true">✦</span>
        </span>
      {%- endfor %}
    </div>
  </div>

  {%- if bar_dismiss %}
    <button
      class="ph3-bar__close"
      aria-label="Dismiss announcement"
      data-ph3-bar-close
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  {%- endif %}
</div>
{%- endif %}


{%- comment %} ══════════════════════════════════════
  MAIN HEADER
══════════════════════════════════════ {% endcomment %}
<header
  id="{{ sid }}"
  class="ph3{% if sticky %} ph3--sticky{% endif %}"
  style="
    --ph3-cream:  {{ s.bg_color   | default: bg_default }};
    --ph3-stone:  {{ s.text_color | default: stone_def  }};
    --ph3-accent: {{ s.accent_color | default: accent_def }};
    --ph3-muted:  {{ s.text_muted   | default: muted_def  }};
    --ph3-border: {{ s.border_color | default: border_def }};
    --ph3-logo-w: {{ logo_w }}px;
  "
  role="banner"
  data-ph3-header
>

  {%- comment %} ── TOP UTILITY STRIP ── {% endcomment %}
  <div class="ph3__strip">
    <div class="ph3__strip-inner">

      <p class="ph3__strip-left">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
             aria-hidden="true">
          <path d="M12 2L3 7V12C3 16.418 7.03 20.592 12 22C16.97 20.592
                   21 16.418 21 12V7L12 2Z"
                stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M9 12L11 14L15 10" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ s.strip_text | default: 'Vet-approved • Ethically sourced • Loved by 50k+ pet parents' }}
      </p>

      <nav class="ph3__strip-right" aria-label="Secondary navigation">
        {%- if show_account %}
          <a
            href="{{ customer | default: routes.account_login_url }}"
            class="ph3__strip-link"
          >
            {%- if customer %}Hi, {{ customer.first_name }}
            {%- else %}Sign In{% endif %}
          </a>
        {%- endif %}
        <a href="/pages/help" class="ph3__strip-link">Help</a>
        <a href="/pages/track-order" class="ph3__strip-link">Track Order</a>

        {%- comment %} Currency selector placeholder {% endcomment %}
        <span class="ph3__strip-link ph3__strip-link--static">🇺🇸 USD</span>
      </nav>

    </div>
  </div>

  {%- comment %} ── MAIN NAV ROW ── {% endcomment %}
  <div class="ph3__main" data-ph3-main>
    <div class="ph3__main-inner">

      {%- comment %} LOGO {% endcomment %}
      <a
        href="{{ routes.root_url }}"
        class="ph3__logo"
        aria-label="{{ logo_text }} — home"
      >
        {%- if logo_img != blank %}
          {{
            logo_img
            | image_url: width: 400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '150, 220, 300, 400',
              alt: logo_text,
              class: 'ph3__logo-img'
          }}
        {%- else %}
          <span class="ph3__logo-mark" aria-label="{{ logo_text }}">
            <span class="ph3__logo-icon" aria-hidden="true">
              <svg width="36" height="36" viewBox="0 0 48 48"
                   fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="22"
                        fill="var(--ph3-accent)" opacity="0.12"/>
                <ellipse cx="16" cy="14" rx="5" ry="7"
                         fill="var(--ph3-accent)"/>
                <ellipse cx="32" cy="14" rx="5" ry="7"
                         fill="var(--ph3-accent)"/>
                <ellipse cx="9"  cy="24" rx="4" ry="5.5"
                         fill="var(--ph3-accent)" opacity="0.75"/>
                <ellipse cx="39" cy="24" rx="4" ry="5.5"
                         fill="var(--ph3-accent)" opacity="0.75"/>
                <ellipse cx="24" cy="32" rx="10" ry="8"
                         fill="var(--ph3-accent)"/>
              </svg>
            </span>
            <span class="ph3__logo-name">{{ logo_text }}</span>
          </span>
        {%- endif %}
      </a>

      {%- comment %} DESKTOP NAV {% endcomment %}
      <nav class="ph3__nav" aria-label="Main navigation" data-ph3-nav>
        <ul class="ph3__nav-list" role="list">

          {%- comment %} ── SHOP (mega) ── {% endcomment %}
          <li class="ph3__item ph3__item--mega" data-ph3-item>
            <button
              class="ph3__link ph3__link--btn"
              aria-haspopup="true"
              aria-expanded="false"
              data-ph3-mega-btn
            >
              Shop
              <span class="ph3__chevron" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round"
                        stroke-linejoin="round"/>
                </svg>
              </span>
            </button>

            <div class="ph3__mega" data-ph3-mega role="region" aria-label="Shop menu">
              <div class="ph3__mega-wrap">

                {%- comment %} Link columns from menu OR dummy {% endcomment %}
                <div class="ph3__mega-cols">

                  <div class="ph3__mega-col">
                    <p class="ph3__mega-head">🐶 Dogs</p>
                    <ul class="ph3__mega-list" role="list">
                      <li><a href="/collections/dog-food"      class="ph3__mega-link">Dog Food & Treats</a></li>
                      <li><a href="/collections/dog-toys"      class="ph3__mega-link">Toys & Play</a></li>
                      <li><a href="/collections/dog-grooming"  class="ph3__mega-link">Grooming</a></li>
                      <li><a href="/collections/dog-beds"      class="ph3__mega-link">Beds & Comfort</a></li>
                      <li><a href="/collections/dog-collars"   class="ph3__mega-link">Collars & Leashes</a></li>
                      <li><a href="/collections/dog-health"    class="ph3__mega-link">Health & Wellness</a></li>
                    </ul>
                  </div>

                  <div class="ph3__mega-col">
                    <p class="ph3__mega-head">🐱 Cats</p>
                    <ul class="ph3__mega-list" role="list">
                      <li><a href="/collections/cat-food"      class="ph3__mega-link">Cat Food & Treats</a></li>
                      <li><a href="/collections/cat-toys"      class="ph3__mega-link">Toys & Enrichment</a></li>
                      <li><a href="/collections/cat-litter"    class="ph3__mega-link">Litter & Hygiene</a></li>
                      <li><a href="/collections/cat-beds"      class="ph3__mega-link">Beds & Trees</a></li>
                      <li><a href="/collections/cat-grooming"  class="ph3__mega-link">Grooming</a></li>
                      <li><a href="/collections/cat-health"    class="ph3__mega-link">Health & Wellness</a></li>
                    </ul>
                  </div>

                  <div class="ph3__mega-col">
                    <p class="ph3__mega-head">🐠 Small Pets</p>
                    <ul class="ph3__mega-list" role="list">
                      <li><a href="/collections/bird"          class="ph3__mega-link">Birds</a></li>
                      <li><a href="/collections/fish"          class="ph3__mega-link">Fish & Aquatics</a></li>
                      <li><a href="/collections/rabbit"        class="ph3__mega-link">Rabbits</a></li>
                      <li><a href="/collections/hamster"       class="ph3__mega-link">Hamsters & Rodents</a></li>
                      <li><a href="/collections/reptile"       class="ph3__mega-link">Reptiles</a></li>
                    </ul>
                  </div>

                </div>

                {%- comment %} Featured promo card {% endcomment %}
                <div class="ph3__mega-promo">
                  {%- assign mp = section.blocks | where: 'type', 'mega_promo' | first %}
                  {%- if mp != blank and mp.settings.promo_image != blank %}
                    <div class="ph3__mega-promo-img">
                      {{
                        mp.settings.promo_image
                        | image_url: width: 480
                        | image_tag:
                          loading: 'lazy',
                          widths: '240,360,480',
                          alt: mp.settings.promo_title,
                          class: 'ph3__mega-promo-photo'
                      }}
                    </div>
                    <div class="ph3__mega-promo-body">
                      <span class="ph3__mega-promo-badge">
                        {{ mp.settings.promo_badge | default: '🔥 Hot Deal' }}
                      </span>
                      <p class="ph3__mega-promo-title">
                        {{ mp.settings.promo_title | default: 'New Arrivals' }}
                      </p>
                      <a href="{{ mp.settings.promo_url | default: '/collections/new' }}"
                         class="ph3__mega-promo-cta">
                        {{ mp.settings.promo_cta | default: 'Shop Now' }}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             aria-hidden="true">
                          <path d="M5 12H19M19 12L12 5M19 12L12 19"
                                stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    </div>
                  {%- else %}
                    <div class="ph3__mega-promo-placeholder">
                      <div class="ph3__mega-promo-body">
                        <span class="ph3__mega-promo-badge">🔥 This Week</span>
                        <p class="ph3__mega-promo-title">New Arrivals Just Dropped</p>
                        <a href="/collections/new" class="ph3__mega-promo-cta">
                          Shop New
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                               aria-hidden="true">
                            <path d="M5 12H19M19 12L12 5M19 12L12 19"
                                  stroke="currentColor" stroke-width="2.5"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      </div>
                    </div>
                  {%- endif %}
                </div>

              </div>
            </div>
          </li>

          {%- comment %} ── BRANDS (dropdown) ── {% endcomment %}
          <li class="ph3__item ph3__item--drop" data-ph3-item>
            <button
              class="ph3__link ph3__link--btn"
              aria-haspopup="true"
              aria-expanded="false"
              data-ph3-mega-btn
            >
              Brands
              <span class="ph3__chevron" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </span>
            </button>

            <div class="ph3__drop" data-ph3-mega role="region" aria-label="Brands menu">
              <ul class="ph3__drop-list" role="list">
                <li><a href="/collections/royal-canin"   class="ph3__drop-link">Royal Canin</a></li>
                <li><a href="/collections/hills"         class="ph3__drop-link">Hill's Science Diet</a></li>
                <li><a href="/collections/purina"        class="ph3__drop-link">Purina Pro Plan</a></li>
                <li><a href="/collections/kong"          class="ph3__drop-link">KONG</a></li>
                <li><a href="/collections/frontline"     class="ph3__drop-link">Frontline</a></li>
                <li><a href="/collections/blue-buffalo"  class="ph3__drop-link">Blue Buffalo</a></li>
                <li class="ph3__drop-divider" role="separator"></li>
                <li>
                  <a href="/collections/brands" class="ph3__drop-link ph3__drop-link--all">
                    All Brands →
                  </a>
                </li>
              </ul>
            </div>
          </li>

          {%- comment %} ── PET CARE (dropdown) ── {% endcomment %}
          <li class="ph3__item ph3__item--drop" data-ph3-item>
            <button
              class="ph3__link ph3__link--btn"
              aria-haspopup="true"
              aria-expanded="false"
              data-ph3-mega-btn
            >
              Pet Care
              <span class="ph3__chevron" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9L12 15L18 9" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </span>
            </button>

            <div class="ph3__drop" data-ph3-mega role="region" aria-label="Pet Care menu">
              <ul class="ph3__drop-list" role="list">
                <li><a href="/blogs/tips/grooming"  class="ph3__drop-link">🛁 Grooming Tips</a></li>
                <li><a href="/blogs/tips/nutrition" class="ph3__drop-link">🥣 Nutrition Guides</a></li>
                <li><a href="/blogs/tips/training"  class="ph3__drop-link">🎾 Training Advice</a></li>
                <li><a href="/blogs/tips/health"    class="ph3__drop-link">💊 Health Basics</a></li>
                <li><a href="/blogs/tips"           class="ph3__drop-link">📖 All Articles</a></li>
              </ul>
            </div>
          </li>

          {%- comment %} ── Simple links ── {% endcomment %}
          <li class="ph3__item">
            <a href="/collections/sale" class="ph3__link ph3__link--sale">
              <span class="ph3__sale-dot" aria-hidden="true"></span>
              Sale
            </a>
          </li>

          <li class="ph3__item">
            <a href="/pages/about" class="ph3__link">Our Story</a>
          </li>

          {%- comment %} Dynamic links from Shopify menu (supplementary) {% endcomment %}
          {%- if main_menu != blank %}
            {%- for link in linklists[main_menu].links %}
              {%- unless link.title == 'Shop' or link.title == 'Brands'
                   or link.title == 'Pet Care' or link.title == 'Sale'
                   or link.title == 'Our Story' %}
                <li class="ph3__item">
                  <a
                    href="{{ link.url }}"
                    class="ph3__link{% if link.active %} ph3__link--active{% endif %}"
                  >
                    {{ link.title }}
                  </a>
                </li>
              {%- endunless %}
            {%- endfor %}
          {%- endif %}

        </ul>
      </nav>

      {%- comment %} UTILITY ICONS {% endcomment %}
      <div class="ph3__utils">

        {%- if show_search %}
          <button
            class="ph3__icon-btn"
            aria-label="Open search"
            aria-expanded="false"
            data-ph3-search-open
          >
            <svg width="20" height="20" viewBox="0 0 24 24"
                 fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5"
                      stroke="currentColor" stroke-width="2"/>
              <path d="M21 21L16.5 16.5"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round"/>
            </svg>
          </button>
        {%- endif %}

        {%- if show_whislist %}
          <a
            href="/pages/wishlist"
            class="ph3__icon-btn"
            aria-label="Wishlist"
          >
            <svg width="20" height="20" viewBox="0 0 24 24"
                 fill="none" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                       a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                       1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif %}

        {%- if show_cart %}
          <a
            href="{{ routes.cart_url }}"
            class="ph3__icon-btn ph3__cart"
            aria-label="Cart — {{ cart.item_count }} items"
            data-ph3-cart
          >
            <svg width="20" height="20" viewBox="0 0 24 24"
                 fill="none" aria-hidden="true">
              <path d="M6 2L3 6V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1
                       21 20V6L18 2H6Z"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="3" y1="6" x2="21" y2="6"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round"/>
              <path d="M16 10C16 12.21 14.21 14 12 14C9.79 14 8 12.21 8 10"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {%- if cart.item_count > 0 %}
              <span class="ph3__cart-badge" data-ph3-cart-count aria-hidden="true">
                {{ cart.item_count }}
              </span>
            {%- endif %}
          </a>
        {%- endif %}

        {%- comment %} Hamburger (mobile) {% endcomment %}
        <button
          class="ph3__burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="{{ sid }}-drawer"
          data-ph3-burger
        >
          <span class="ph3__burger-box" aria-hidden="true">
            <span class="ph3__burger-line ph3__burger-line--a"></span>
            <span class="ph3__burger-line ph3__burger-line--b"></span>
            <span class="ph3__burger-line ph3__burger-line--c"></span>
          </span>
        </button>

      </div>
    </div>
  </div>

  {%- comment %} Scroll progress {% endcomment %}
  {%- if show_progress %}
    <div class="ph3__progress" data-ph3-progress aria-hidden="true"></div>
  {%- endif %}

</header>


{%- comment %} ══════════════════════════════════════
  SEARCH OVERLAY
══════════════════════════════════════ {% endcomment %}
{%- if show_search %}
<div
  id="{{ sid }}-search"
  class="ph3-search"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  data-ph3-search
  hidden
>
  <div class="ph3-search__veil" data-ph3-search-close aria-hidden="true"></div>

  <div class="ph3-search__box">
    <div class="ph3-search__row">
      <svg class="ph3-search__icon" width="22" height="22"
           viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7.5" stroke="currentColor" stroke-width="2"/>
        <path d="M21 21L16.5 16.5" stroke="currentColor"
              stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        id="{{ sid }}-search-input"
        class="ph3-search__input"
        type="search"
        placeholder="{{ s.search_placeholder | default: 'Search pets, products, tips…' }}"
        autocomplete="off"
        aria-label="Search"
        data-ph3-search-input
      >
      <button
        class="ph3-search__close"
        aria-label="Close search"
        data-ph3-search-close
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             aria-hidden="true">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor"
                stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="ph3-search__suggestions" data-ph3-suggestions>
      <p class="ph3-search__suggest-label">Trending searches</p>
      <div class="ph3-search__chips">
        {%- assign chips = s.search_quick_tags | default: 'Dog Food, Cat Toys, Flea Treatment, Dog Beds, Cat Litter, Puppy Starter Kit' | split: ',' %}
        {%- for chip in chips %}
          <button class="ph3-search__chip" data-ph3-chip="{{ chip | strip }}">
            {{ chip | strip }}
          </button>
        {%- endfor %}
      </div>
    </div>

    <div
      class="ph3-search__results"
      data-ph3-search-results
      aria-live="polite"
    ></div>
  </div>
</div>
{%- endif %}


{%- comment %} ══════════════════════════════════════
  MOBILE DRAWER
══════════════════════════════════════ {% endcomment %}
<div
  id="{{ sid }}-drawer"
  class="ph3-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  data-ph3-drawer
  hidden
>
  <div class="ph3-drawer__veil" data-ph3-drawer-close aria-hidden="true"></div>

  <div class="ph3-drawer__panel">

    {%- comment %} Panel header {% endcomment %}
    <div class="ph3-drawer__head">
      <a href="{{ routes.root_url }}" class="ph3-drawer__logo" tabindex="-1">
        {%- if logo_img != blank %}
          {{
            logo_img
            | image_url: width: 200
            | image_tag: loading: 'lazy', alt: logo_text, class: 'ph3-drawer__logo-img'
          }}
        {%- else %}
          <span class="ph3-drawer__logo-text">
            <span aria-hidden="true">🐾</span>
            {{ logo_text }}
          </span>
        {%- endif %}
      </a>
      <button
        class="ph3-drawer__x"
        aria-label="Close menu"
        data-ph3-drawer-close
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             aria-hidden="true">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor"

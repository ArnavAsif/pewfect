<script>
(function () {
  'use strict';

  const sid  = '{{ sid }}';
  const S    = (sel, ctx) => (ctx || document).querySelector(sel);
  const SA   = (sel, ctx) => [...(ctx || document).querySelectorAll(sel)];
  const noMo = () => window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  /* ── Refs ───────────────────────────────────────────── */
  const header   = document.getElementById(sid);
  const bar      = document.getElementById(sid + '-bar');
  const search   = document.getElementById(sid + '-search');
  const drawer   = document.getElementById(sid + '-drawer');
  if (!header) return;

  const burger       = S('[data-ph3-burger]',       header);
  const searchOpen   = S('[data-ph3-search-open]',  header);
  const progressBar  = S('[data-ph3-progress]',     header);

  /* ══════════════════════════════════════════════════════
     SCROLL — shrink + progress
  ══════════════════════════════════════════════════════ */
  let rafPending = false;
  function onScroll() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      header.classList.toggle('ph3--scrolled', window.scrollY > 24);
      if (progressBar) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.width = max > 0
          ? ((window.scrollY / max) * 100).toFixed(2) + '%'
          : '0%';
      }
      rafPending = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ══════════════════════════════════════════════════════
     ANNOUNCEMENT BAR — dismiss + pause marquee on hover
  ══════════════════════════════════════════════════════ */
  if (bar) {
    const barClose  = S('[data-ph3-bar-close]', bar);
    const barTrack  = S('.ph3-bar__track',      bar);
    const storeKey  = 'ph3-bar-' + sid;

    if (sessionStorage.getItem(storeKey)) {
      bar.classList.add('ph3-bar--gone');
    }
    if (barClose) {
      barClose.addEventListener('click', () => {
        bar.classList.add('ph3-bar--gone');
        sessionStorage.setItem(storeKey, '1');
      });
    }
    if (barTrack) {
      bar.addEventListener('mouseenter', () => barTrack.style.animationPlayState = 'paused');
      bar.addEventListener('mouseleave', () => barTrack.style.animationPlayState = 'running');
    }
  }

  /* ══════════════════════════════════════════════════════
     MEGA / DROP — hover + keyboard
  ══════════════════════════════════════════════════════ */
  SA('[data-ph3-item]', header).forEach(item => {
    const btn  = S('[data-ph3-mega-btn]', item);
    const menu = S('[data-ph3-mega]',     item);
    if (!btn || !menu) return;

    let closeTimer;

    const open  = () => { clearTimeout(closeTimer); btn.setAttribute('aria-expanded','true'); };

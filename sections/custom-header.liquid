  });

  /* ══════════════════════════════════════════════════════
     FOCUS TRAP
  ══════════════════════════════════════════════════════ */
  function trapFocus(el) {
    const nodes = SA([
      'a[href]', 'button:not([disabled])',
      'input', 'textarea', '[tabindex]:not([tabindex="-1"])'
    ].join(','), el).filter(n => !n.closest('[hidden]'));

    if (!nodes.length) return () => {};
    const first = nodes[0], last = nodes[nodes.length - 1];

    function onTab(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
      else            { if (document.activeElement === last)  { e.preventDefault(); first.focus(); } }
    }
    el.addEventListener('keydown', onTab);
    first.focus();
    return () => el.removeEventListener('keydown', onTab);
  }

  /* ══════════════════════════════════════════════════════
     MOBILE DRAWER
  ══════════════════════════════════════════════════════ */
  let drawerUnlockFocus = null;

  function openDrawer() {
    if (!drawer) return;
    drawer.removeAttribute('hidden');
    burger && burger.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
    drawerUnlockFocus = trapFocus(drawer);
    drawer.addEventListener('keydown', escDrawer);
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.setAttribute('hidden','');
    burger && burger.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
    drawerUnlockFocus && drawerUnlockFocus();
    drawer.removeEventListener('keydown', escDrawer);
    burger && burger.focus();
  }
  function escDrawer(e) { if (e.key === 'Escape') closeDrawer(); }

  if (burger) burger.addEventListener('click', openDrawer);
  SA('[data-ph3-drawer-close]', drawer || document).forEach(el =>
    el.addEventListener('click', closeDrawer)
  );

  /* Drawer accordion */
  SA('[data-ph3-drawer-toggle]', drawer || document).forEach(toggle => {
    toggle.addEventListener('click', () => {
      const subId = toggle.getAttribute('aria-controls');
      const sub   = document.getElementById(subId);
      if (!sub) return;
      const open  = toggle.getAttribute('aria-expanded') === 'true';

      /* Close siblings */
      SA('[data-ph3-drawer-toggle]', drawer).forEach(t => {
        if (t !== toggle) {
          t.setAttribute('aria-expanded','false');
          const s = document.getElementById(t.getAttribute('aria-controls'));
          if (s) s.setAttribute('hidden','');
        }
      });

      toggle.setAttribute('aria-expanded', String(!open));
      open ? sub.setAttribute('hidden','') : sub.removeAttribute('hidden');
    });
  });

  /* ══════════════════════════════════════════════════════
     SEARCH OVERLAY
  ══════════════════════════════════════════════════════ */
  let searchUnlockFocus = null;
  let searchDebounce    = null;

  function openSearch() {
    if (!search) return;
    search.removeAttribute('hidden');
    searchOpen && searchOpen.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
    searchUnlockFocus = trapFocus(search);
    search.addEventListener('keydown', escSearch);
    const inp = S('[data-ph3-search-input]', search);
    if (inp) setTimeout(() => inp.focus(), 60);
  }
  function closeSearch() {
    if (!search) return;
    search.setAttribute('hidden','');
    searchOpen && searchOpen.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
    searchUnlockFocus && searchUnlockFocus();
    search.removeEventListener('keydown', escSearch);
    searchOpen && searchOpen.focus();
  }
  function escSearch(e) { if (e.key === 'Escape') closeSearch(); }

  if (searchOpen) searchOpen.addEventListener('click', openSearch);
  SA('[data-ph3-search-close]', search || document).forEach(el =>
    el.addEventListener('click', closeSearch)
  );

  /* Quick chips */
  const searchInp = S('[data-ph3-search-input]', search);
  SA('[data-ph3-chip]', search || document).forEach(chip => {
    chip.addEventListener('click', () => {
      if (!searchInp) return;
      searchInp.value = chip.dataset.ph3Chip;
      searchInp.dispatchEvent(new Event('input'));
      searchInp.focus();
    });
  });

  /* Predictive search */
  if (searchInp) {
    const resultsWrap  = S('[data-ph3-search-results]', search);
    const suggestWrap  = S('[data-ph3-suggestions]',    search);

    searchInp.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      const q = searchInp.value.trim();
      if (!q) {
        if (resultsWrap) resultsWrap.innerHTML = '';
        if (suggestWrap) suggestWrap.style.display = '';
        return;
      }
      if (suggestWrap) suggestWrap.style.display = 'none';

      searchDebounce = setTimeout(async () => {
        try {
          const r = await fetch(
            `/search/suggest.json?q=${encodeURIComponent(q)}&resources[type]=product&resources[limit]=6`
          );
          const d = await r.json();
          paintResults(d.resources?.results?.products || [], resultsWrap);
        } catch { paintResults([], resultsWrap); }
      }, 260);
    });
  }

  function paintResults(products, wrap) {
    if (!wrap) return;
    if (!products.length) {
      wrap.innerHTML = `<p style="font-size:.85rem;color:var(--ph3-muted);padding:12px 0;">
        No products found. Try something else.
      </p>`;
      return;
    }
    wrap.innerHTML = products.map(p => `
      <a href="${p.url}" class="ph3-result">
        <div class="ph3-result__thumb">
          ${p.featured_image?.url
            ? `<img src="${p.featured_image.url}&width=120" alt="${p.title}" loading="lazy">`
            : '🐾'}
        </div>
        <div class="ph3-result__info">
          <p class="ph3-result__name">${p.title}</p>
          ${p.price
            ? `<p class="ph3-result__price">${fmtMoney(p.price)}</p>`
            : ''}
        </div>
        <svg class="ph3-result__arrow" width="15" height="15"
             viewBox="0 0 24 24" fill="none">
          <path d="M5 12H19M19 12L12 5M19 12L12 19"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round"/>
        </svg>
      </a>
    `).join('');
  }

  function fmtMoney(cents) {
    return new Intl.NumberFormat('en-US', {
      style:'currency', currency:'{{ shop.currency }}'
    }).format(cents / 100);
  }

  /* ══════════════════════════════════════════════════════
     CART COUNT — live update
  ══════════════════════════════════════════════════════ */
  document.addEventListener('cart:updated', e => {
    const count = e.detail?.itemCount ?? 0;
    SA('[data-ph3-cart]', header).forEach(btn => {
      btn.setAttribute('aria-label', `Cart — ${count} item${count !== 1 ? 's' : ''}`);
      let badge = S('[data-ph3-cart-count]', btn);
      if (count > 0) {
        if (!badge) {
          badge = Object.assign(document.createElement('span'), {
            className: 'ph3__cart-badge',
          });
          badge.setAttribute('data-ph3-cart-count','');
          badge.setAttribute('aria-hidden','true');
          btn.appendChild(badge);
        }
        badge.textContent = count > 99 ? '99+' : String(count);
      } else if (badge) badge.remove();
    });
  });

  /* ── Cleanup ────────────────────────────────────────── */
  document.addEventListener('shopify:section:unload', e => {
    if (e.detail.sectionId === '{{ section.id }}') {
      window.removeEventListener('scroll', onScroll);
    }
  });

}());
</script>



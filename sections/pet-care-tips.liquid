  ══════════════════════════════════════════════════════════
{%- endcomment %}

{%- comment %} ── Load GSAP once per page ── {%- endcomment %}
<script>
  (function () {
    if (window.__pctGsap) return;
    window.__pctGsap = 'loading';

    const GSAP = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
    const ST = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';

    function load(src, cb) {
      const s = document.createElement('script');
      s.src = src;
      s.defer = true;
      s.onload = cb;
      document.head.appendChild(s);
    }

    load(GSAP, () =>
      load(ST, () => {
        window.__pctGsap = 'ready';
        document.dispatchEvent(new CustomEvent('pct:gsap-ready'));
      })
    );
  })();
</script>

{%- comment %} ── Per-section logic ── {%- endcomment %}
<script>
(function () {
  'use strict';

  /* ── Utilities ──────────────────────────────────────────── */
  const isMobile    = () => window.matchMedia('(max-width:599px)').matches;
  const noMotion    = () => window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  const $ = (sel, ctx) => (ctx || document).querySelector(sel);
  const $$ = (sel, ctx) => [...(ctx || document).querySelectorAll(sel)];

  /* ── Section ────────────────────────────────────────────── */
  const section = document.getElementById('{{ sid }}');
  if (!section) return;

  const cards    = $$('[data-pct-card]', section);
  const track    = $('[data-pct-track]', section);
  const dotsWrap = $('[data-pct-dots]', section);
  const footer   = $('[data-pct-footer]', section);
  const intro    = $('[data-pct-intro]', section);

  let gsapCtx = null;

  /* ══════════════════════════════════════════════════════════
     MOBILE DOTS
  ══════════════════════════════════════════════════════════ */
  function buildDots() {
    if (!dotsWrap || !cards.length) return;
    dotsWrap.innerHTML = '';

    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'pct__dot' + (i === 0 ? ' pct__dot--active' : '');
      dot.setAttribute('aria-label', `Go to card ${i + 1}`);
      dot.addEventListener('click', () => scrollToCard(i));
      dotsWrap.appendChild(dot);
    });
  }

  function scrollToCard(idx) {
    if (!track || !cards[idx]) return;
    track.scrollTo({
      left:     cards[idx].offsetLeft - parseInt(getComputedStyle(track).paddingLeft),
      behavior: 'smooth',
    });
  }

  function updateDots() {
    if (!track || !dotsWrap) return;
    const dots    = $$('.pct__dot', dotsWrap);
    const trackL  = track.scrollLeft;
    const cardW   = cards[0]?.offsetWidth + parseInt(getComputedStyle(track).gap) || 1;
    const active  = Math.round(trackL / cardW);
    dots.forEach((d, i) => d.classList.toggle('pct__dot--active', i === active));
  }

  /* ══════════════════════════════════════════════════════════
     KEYBOARD NAV (card focus)
  ══════════════════════════════════════════════════════════ */
  function initKeyboard() {
    cards.forEach(card => {
      card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const link = $('a.pct__card-link', card);
          if (link) link.click();
        }
      });
    });
  }

  /* ══════════════════════════════════════════════════════════
     GSAP ANIMATIONS
  ══════════════════════════════════════════════════════════ */
  function initGsap() {
    if (!window.gsap || noMotion()) {
      /* Fallback: make everything visible immediately */
      cards.forEach(c => {
        c.style.opacity   = '1';
        c.style.transform = 'none';
      });
      if (footer) {
        footer.style.opacity   = '1';
        footer.style.transform = 'none';
      }
      if (intro) {
        intro.style.opacity   = '1';
        intro.style.transform = 'none';
      }
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    gsapCtx = gsap.context(() => {

      /* ── 1. Section intro reveal ──────────────────────── */
      if (intro) {
        gsap.set(intro, { opacity: 0, y: 30 });
        gsap.to(intro, {
          opacity:  1,
          y:        0,
          duration: 0.80,
          ease:     'power3.out',
          scrollTrigger: {
            trigger: intro,
            start:   'top 82%',
            once:    true,
          },
        });
      }

      /* ── 2. Cards staggered scroll-reveal ─────────────── */
      if (!isMobile()) {
        /* Desktop: ScrollTrigger per card for fine control */
        cards.forEach((card) => {
          const delay = parseInt(card.dataset.delay || 0) / 1000;

          gsap.set(card, {
            opacity:  0,
            y:        48,
            rotateZ:  2,
            scale:    0.97,
          });

          gsap.to(card, {
            opacity:  1,
            y:        0,
            rotateZ:  0,
            scale:    1,
            duration: 0.80,
            delay:    delay,
            ease:     'power3.out',
            scrollTrigger: {
              trigger: card,
              start:   'top 86%',
              once:    true,
            },
          });
        });
      } else {
        /* Mobile: simple batch reveal (no per-card trigger, perf) */
        gsap.set(cards, { opacity: 0, y: 24 });
        gsap.to(cards, {
          opacity:  1,
          y:        0,
          duration: 0.60,
          ease:     'power2.out',
          stagger:  0.08,
          scrollTrigger: {
            trigger: track,
            start:   'top 88%',
            once:    true,
          },
        });
      }

      /* ── 3. Footer CTA reveal ─────────────────────────── */
      if (footer) {
        gsap.to(footer, {
          opacity:  1,
          y:        0,
          duration: 0.65,
          ease:     'power3.out',
          scrollTrigger: {
            trigger: footer,
            start:   'top 90%',
            once:    true,
          },
        });
      }

      /* ── 4. Desktop hover — GSAP-powered ──────────────── */
      if (!isMobile()) {
        cards.forEach(card => {
          const img = $('.pct__card-img', card);

          card.addEventListener('mouseenter', () => {
            gsap.to(card, {
              scale:    1.025,
              duration: 0.50,
              ease:     'power2.out',
            });
            if (img) {
              gsap.to(img, {
                scale:    1.09,
                duration: 0.70,
                ease:     'power2.out',
              });
            }
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              scale:    1,
              duration: 0.55,
              ease:     'power2.inOut',
            });
            if (img) {
              gsap.to(img, {
                scale:    1,
                duration: 0.65,
                ease:     'power2.inOut',
              });
            }
          });
        });
      }

      /* ── 5. Very subtle continuous floating (desktop) ─── */
      if (!isMobile() && {{ s.enable_float_animation | default: false }}) {
        cards.forEach((card, i) => {
          const dir = i % 2 === 0 ? -6 : 6;
          gsap.to(card, {
            y:        dir,
            duration: 4 + i * 0.4,
            ease:     'sine.inOut',
            yoyo:     true,
            repeat:   -1,
            delay:    i * 0.3,
          });
        });
      }

    }, section);
  }

  /* ══════════════════════════════════════════════════════════
     INIT
  ══════════════════════════════════════════════════════════ */
  function boot() {
    buildDots();
    initKeyboard();

    /* Mobile scroll → update dots */
    if (track) {
      track.addEventListener('scroll', updateDots, { passive: true });
    }

    if (window.__pctGsap === 'ready') {
      initGsap();
    } else {
      document.addEventListener('pct:gsap-ready', initGsap, { once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }

  /* ── Theme editor lifecycle ─────────────────────────────── */
  document.addEventListener('shopify:section:unload', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    if (gsapCtx) gsapCtx.revert();
  });
  document.addEventListener('shopify:section:load', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    boot();
  });
  document.addEventListener('shopify:block:select', e => {
    if (!section.contains(e.detail.target)) return;
    const card = e.detail.target.closest('[data-pct-card]');
    if (card) card.scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' });
  });

}());
</script>


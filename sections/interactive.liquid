<script>
(function () {
  'use strict';

  var SID      = '{{ section.id }}';
  var GSAP_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
  var ST_SRC   = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';

  /* ── Load script ── */
  function loadScript(src) {
    return new Promise(function (res, rej) {
      if (document.querySelector('script[src="' + src + '"]')) { res(); return; }
      var s = document.createElement('script');
      s.src = src; s.async = true;
      s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }

  /* ════════════════════════════════════════════
     MAIN INIT
  ════════════════════════════════════════════ */
  function init() {
    var section  = document.getElementById('ips-' + SID);
    if (!section) return;

    var gsap = window.gsap;
    var ST   = window.ScrollTrigger;
    var pref = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isMob = window.matchMedia('(max-width: 767px)').matches;

    if (ST && gsap) gsap.registerPlugin(ST);

    /* ── DOM refs ── */
    var tabs      = section.querySelectorAll('.ips__tab');
    var panels    = section.querySelectorAll('.ips__panel');
    var header    = section.querySelector('.ips__header');
    var tabsWrap  = section.querySelector('.ips__tabs');
    var ambBlobs  = section.querySelectorAll('.ips__ambient-blob');
    var activeAcc = null; /* currently highlighted accessory item */

    /* ════════════════════════════════════════
       ACCENT COLOR PROPAGATION
    ════════════════════════════════════════ */
    function applyAccent(color) {
      section.style.setProperty('--ips-accent', color);
      ambBlobs.forEach(function (b) { b.style.background = color; });
    }

    /* ════════════════════════════════════════
       TAB SWITCHING
    ════════════════════════════════════════ */
    function switchPet(targetTab) {
      if (targetTab.classList.contains('is-active')) return;

      /* Close any open tooltips */
      section.querySelectorAll('.ips__tooltip.is-open').forEach(closeTooltip);

      /* Update tab states */
      tabs.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      targetTab.classList.add('is-active');
      targetTab.setAttribute('aria-selected', 'true');

      /* Accent color update */
      var accent = targetTab.dataset.accent;
      if (accent) applyAccent(accent);

      /* Panel switch */
      var targetPanelId = targetTab.getAttribute('aria-controls');
      var targetPanel   = document.getElementById(targetPanelId);

      panels.forEach(function (panel) {
        if (panel !== targetPanel) {
          if (gsap && !pref) {
            gsap.to(panel, {
              opacity: 0,
              y: -12,
              duration: 0.3,
              ease: 'power2.in',
              onComplete: function () {
                panel.classList.remove('is-active', 'is-visible');
                panel.style.opacity = '';
                panel.style.transform = '';
              }
            });
          } else {
            panel.classList.remove('is-active', 'is-visible');
          }
        }
      });

      if (targetPanel) {
        if (gsap && !pref) {
          gsap.set(targetPanel, { opacity: 0, y: 20 });
          targetPanel.classList.add('is-active');

          requestAnimationFrame(function () {
            gsap.to(targetPanel, {
              opacity: 1,
              y: 0,
              duration: 0.55,
              ease: 'power3.out',
              onStart: function () {
                targetPanel.classList.add('is-visible');
              }
            });

            /* Stagger hotspot pins in */
            var pins = targetPanel.querySelectorAll('.ips__pin');
            gsap.fromTo(pins,
              { scale: 0, opacity: 0 },
              {
                scale: 1,
                opacity: 1,
                duration: 0.45,
                stagger: 0.08,
                ease: 'back.out(2)',
                delay: 0.2
              }
            );

            /* Accessory items in */
            var accItems = targetPanel.querySelectorAll('.ips__accessory-item');
            gsap.fromTo(accItems,
              { x: -16, opacity: 0 },
              {
                x: 0,
                opacity: 1,
                duration: 0.4,
                stagger: 0.06,
                ease: 'power2.out',
                delay: 0.25
              }
            );
          });
        } else {
          targetPanel.classList.add('is-active', 'is-visible');
        }
      }
    }

    /* Tab click */
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () { switchPet(tab); });
    });

    /* Init first panel */
    var firstPanel = section.querySelector('.ips__panel.is-active');
    if (firstPanel) {
      requestAnimationFrame(function () {
        firstPanel.classList.add('is-visible');
        var firstTab = section.querySelector('.ips__tab.is-active');
        if (firstTab && firstTab.dataset.accent) applyAccent(firstTab.dataset.accent);
      });
    }

    /* ════════════════════════════════════════
       TOOLTIP SYSTEM
    ════════════════════════════════════════ */
    var openTooltipEl = null;

    function openTooltip(hotspotEl, pin) {
      var tooltip = hotspotEl.querySelector('.ips__tooltip');
      if (!tooltip) return;
      if (tooltip === openTooltipEl) return;

      /* Close existing */
      if (openTooltipEl) closeTooltip(openTooltipEl);

      /* Flip detection */
      var rect = hotspotEl.getBoundingClientRect();
      var viewW = window.innerWidth;
      if (rect.left > viewW * 0.62) {
        tooltip.classList.add('flip-left');
      } else {
        tooltip.classList.remove('flip-left');
      }

      /* Vertical flip — if near bottom */
      var tooltipH = 340;
      if (rect.top > window.innerHeight - tooltipH - 60) {
        tooltip.style.top = 'auto';
        tooltip.style.bottom = '-12px';
        tooltip.style.transform = tooltip.classList.contains('flip-left')
          ? 'translateY(0) scale(0.88) translateX(8px)'
          : 'translateY(0) scale(0.88) translateX(-8px)';
      } else {
        tooltip.style.top   = '';
        tooltip.style.bottom = '';
        tooltip.style.transform = '';
      }

      tooltip.classList.add('is-open');
      tooltip.removeAttribute('aria-hidden');
      if (pin) pin.setAttribute('aria-expanded', 'true');

      openTooltipEl = tooltip;

      /* GSAP entrance */
      if (gsap && !pref) {
        var img = tooltip.querySelector('.ips__tooltip-img');
        if (img) {
          gsap.fromTo(img,
            { scale: 1.1, opacity: 0 },
            { scale: 1.04, opacity: 1, duration: 0.55, ease: 'power2.out', delay: 0.15 }
          );
        }
      }

      /* Highlight accessory item in list */
      highlightAccessoryItem(hotspotEl.dataset.hotspotId);
    }

    function closeTooltip(tooltipOrHotspot) {
      var tooltip = tooltipOrHotspot.classList.contains('ips__tooltip')
        ? tooltipOrHotspot
        : tooltipOrHotspot.querySelector('.ips__tooltip');

      if (!tooltip || !tooltip.classList.contains('is-open')) return;

      tooltip.classList.remove('is-open');
      tooltip.setAttribute('aria-hidden', 'true');

      var pin = tooltip.closest('.ips__hotspot')
        && tooltip.closest('.ips__hotspot').querySelector('.ips__pin');
      if (pin) pin.setAttribute('aria-expanded', 'false');

      if (tooltip === openTooltipEl) openTooltipEl = null;

      /* Un-highlight accessory item */
      unhighlightAllAccessoryItems();
    }

    /* ════════════════════════════════════════
       ACCESSORY HIGHLIGHT SYNC
    ════════════════════════════════════════ */
    function highlightAccessoryItem(hotspotId) {
      unhighlightAllAccessoryItems();
      var item = section.querySelector('.ips__accessory-item[data-hotspot-target="' + hotspotId + '"]');
      if (!item) return;
      item.classList.add('is-highlighted');
      activeAcc = item;

      /* Scroll into view inside list */
      item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function unhighlightAllAccessoryItems() {
      section.querySelectorAll('.ips__accessory-item.is-highlighted').forEach(function (el) {
        el.classList.remove('is-highlighted');
      });
      activeAcc = null;
    }

    /* ════════════════════════════════════════
       HOTSPOT EVENTS
    ════════════════════════════════════════ */
    function initHotspots() {
      var hotspots = section.querySelectorAll('.ips__hotspot');

      hotspots.forEach(function (hotspot) {
        var pin     = hotspot.querySelector('.ips__pin');
        var tooltip = hotspot.querySelector('.ips__tooltip');
        var closeBtn= hotspot.querySelector('.ips__tooltip-close');

        if (!pin || !tooltip) return;

        /* Desktop: hover */
        if (!isMob) {
          var hoverTimer;

          hotspot.addEventListener('mouseenter', function () {
            clearTimeout(hoverTimer);
            openTooltip(hotspot, pin);

            /* Wiggle pin with GSAP */
            if (gsap && !pref) {
              gsap.to(pin, {
                rotation: 15,
                duration: 0.15,
                ease: 'power2.out',
                yoyo: true,
                repeat: 1,
                onComplete: function () { gsap.set(pin, { rotation: 0 }); }
              });
            }
          });

          hotspot.addEventListener('mouseleave', function () {
            hoverTimer = setTimeout(function () {
              closeTooltip(hotspot);
            }, 250);
          });

          tooltip.addEventListener('mouseenter', function () {
            clearTimeout(hoverTimer);
          });

          tooltip.addEventListener('mouseleave', function () {
            hoverTimer = setTimeout(function () {
              closeTooltip(hotspot);
            }, 250);
          });
        }

        /* Always: click/tap toggle */
        pin.addEventListener('click', function (e) {
          e.stopPropagation();
          if (tooltip.classList.contains('is-open')) {
            closeTooltip(hotspot);
          } else {
            openTooltip(hotspot, pin);
          }
        });

        /* Close button */
        if (closeBtn) {
          closeBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            closeTooltip(hotspot);
          });
        }

        /* Keyboard */
        pin.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (tooltip.classList.contains('is-open')) {
              closeTooltip(hotspot);
            } else {
              openTooltip(hotspot, pin);
            }
          }
          if (e.key === 'Escape') {
            closeTooltip(hotspot);
            pin.focus();
          }
        });
      });
    }

    initHotspots();

    /* Close on outside click */
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.ips__hotspot') && !e.target.closest('.ips__accessory-item')) {
        if (openTooltipEl) {
          var hs = openTooltipEl.closest('.ips__hotspot');
          if (hs) closeTooltip(hs);
        }
        unhighlightAllAccessoryItems();
      }
    });

    /* Escape key global */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && openTooltipEl) {
        var hs = openTooltipEl.closest('.ips__hotspot');
        if (hs) {
          closeTooltip(hs);
          var pin = hs.querySelector('.ips__pin');
          if (pin) pin.focus();
        }
      }
    });

    /* ════════════════════════════════════════
       ACCESSORY ITEM → HOTSPOT TRIGGER
    ════════════════════════════════════════ */
    section.querySelectorAll('.ips__accessory-item').forEach(function (item) {
      function triggerFromItem() {
        var hotspotId = item.dataset.hotspotTarget;
        var hotspot   = section.querySelector('.ips__hotspot[data-hotspot-id="' + hotspotId + '"]');

        if (!hotspot) return;

        var pin = hotspot.querySelector('.ips__pin');

        /* GSAP: bounce the pin */
        if (gsap && !pref) {
          gsap.fromTo(pin,
            { scale: 1 },
            {
              scale: 1.5,
              duration: 0.2,
              ease: 'power2.out',
              yoyo: true,
              repeat: 1,
              onComplete: function () { gsap.set(pin, { scale: 1 }); }
            }
          );
        }

        openTooltip(hotspot, pin);

        /* Scroll pin into view on mobile */
        if (isMob) {
          hotspot.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      item.addEventListener('click', triggerFromItem);
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          triggerFromItem();
        }
      });

      /* Desktop: hover highlight */
      if (!isMob) {
        item.addEventListener('mouseenter', function () {
          var hotspotId = item.dataset.hotspotTarget;
          var hotspot   = section.querySelector('.ips__hotspot[data-hotspot-id="' + hotspotId + '"]');
          if (!hotspot) return;
          var pin = hotspot.querySelector('.ips__pin');

          if (gsap && !pref) {
            gsap.to(pin, { scale: 1.25, duration: 0.3, ease: 'back.out(2)' });
          }

          highlightAccessoryItem(hotspotId);
        });

        item.addEventListener('mouseleave', function () {
          var hotspotId = item.dataset.hotspotTarget;
          var hotspot   = section.querySelector('.ips__hotspot[data-hotspot-id="' + hotspotId + '"]');
          if (!hotspot) return;
          var pin = hotspot.querySelector('.ips__pin');

          if (gsap && !pref && !openTooltipEl) {
            gsap.to(pin, { scale: 1, duration: 0.3, ease: 'power2.out' });
            unhighlightAllAccessoryItems();
          }
        });
      }
    });

    /* ════════════════════════════════════════
       SCROLL ENTRANCE ANIMATION
    ════════════════════════════════════════ */
    if (gsap && ST && !pref) {

      /* Header */
      if (header) {
        var hEls = header.querySelectorAll('.ips__eyebrow, .ips__title, .ips__subtitle');
        gsap.fromTo(hEls,
          { y: 24, opacity: 0 },
          {
            y: 0, opacity: 1,
            duration: 0.7,
            stagger: 0.12,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: header,
              start: 'top 88%',
              once: true
            }
          }
        );
      }

      /* Tabs */
      if (tabsWrap) {
        var tabEls = tabsWrap.querySelectorAll('.ips__tab');
        gsap.fromTo(tabEls,
          { y: 18, opacity: 0 },
          {
            y: 0, opacity: 1,
            duration: 0.55,
            stagger: 0.07,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: tabsWrap,
              start: 'top 88%',
              once: true
            }
          }
        );
      }

      /* Active panel entrance */
      var activePanel = section.querySelector('.ips__panel.is-active');
      if (activePanel) {
        gsap.fromTo(activePanel,
          { opacity: 0, y: 30 },
          {
            opacity: 1, y: 0,
            duration: 0.75,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: activePanel,
              start: 'top 85%',
              once: true,
              onEnter: function () { activePanel.classList.add('is-visible'); }
            }
          }
        );

        /* Hotspot pins stagger */
        var initPins = activePanel.querySelectorAll('.ips__pin');
        gsap.fromTo(initPins,
          { scale: 0, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.5,
            stagger: 0.1,
            ease: 'back.out(2.5)',
            scrollTrigger: {
              trigger: activePanel,
              start: 'top 80%',
              once: true
            }
          }
        );

        /* Pet image */
        var petImg = activePanel.querySelector('.ips__pet-img, .ips__pet-placeholder');
        if (petImg) {
          gsap.fromTo(petImg,
            { scale: 0.9, opacity: 0 },
            {
              scale: 1, opacity: 1,
              duration: 0.85,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: activePanel,
                start: 'top 82%',
                once: true
              }
            }
          );
        }

        /* Info panel items */
        var infoEls = activePanel.querySelectorAll(
          '.ips__pet-badge, .ips__pet-name, .ips__pet-desc, .ips__accessory-list, .ips__shop-all'
        );
        gsap.fromTo(infoEls,
          { x: 24, opacity: 0 },
          {
            x: 0, opacity: 1,
            duration: 0.6,
            stagger: 0.08,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: activePanel,
              start: 'top 82%',
              once: true
            }
          }
        );
      }
    }

  } /* end init */

  /* ── Bootstrap ── */
  loadScript(GSAP_SRC)
    .then(function () { return loadScript(ST_SRC); })
    .then(function () {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          requestAnimationFrame(function () { requestAnimationFrame(init); });
        });
      } else {
        requestAnimationFrame(function () { requestAnimationFrame(init); });
      }
    })
    .catch(function () {
      /* No GSAP: still init without animations */
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    });
})();
</script>


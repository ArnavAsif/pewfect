{% comment %}
  ============================================================
  Interactive Pet Showcase Section
  File: sections/interactive-pet-showcase.liquid
  ============================================================
{% endcomment %}

{%- liquid
  assign section_title    = section.settings.section_title
  assign section_subtitle = section.settings.section_subtitle
  assign bg_color         = section.settings.background_color
  assign active_pet       = section.settings.default_pet
-%}

<section
  class="ips"
  id="ips-{{ section.id }}"
  aria-labelledby="ips-title-{{ section.id }}"
  style="background: {{ bg_color }};"
>

  {%- comment %} ── Ambient background ── {% endcomment %}
  <div class="ips__ambient" aria-hidden="true">
    <div class="ips__ambient-blob ips__ambient-blob--1"></div>
    <div class="ips__ambient-blob ips__ambient-blob--2"></div>
    <div class="ips__ambient-blob ips__ambient-blob--3"></div>
    <div class="ips__ambient-grid"></div>
  </div>

  {%- comment %} ── Header ── {% endcomment %}
  <div class="ips__header">
    <div class="ips__header-inner">
      <div class="ips__eyebrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
        </svg>
        <span>Interactive Experience</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
        </svg>
      </div>
      <h2 class="ips__title" id="ips-title-{{ section.id }}">
        {{ section_title | default: 'Meet Our Happy Pets' }}
      </h2>
      <p class="ips__subtitle">
        {{ section_subtitle | default: 'Hover over accessories to explore products made for your best friend' }}
      </p>
    </div>
  </div>

  {%- comment %} ── Pet Tab Switcher ── {% endcomment %}
  <div class="ips__tabs" role="tablist" aria-label="Select a pet to explore">
    {%- for block in section.blocks -%}
      {%- if block.type == 'pet' -%}
        <button
          class="ips__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          id="ips-tab-{{ block.id }}"
          aria-controls="ips-panel-{{ block.id }}"
          aria-selected="{{ forloop.first }}"
          data-pet-id="{{ block.id }}"
          data-accent="{{ block.settings.accent_color }}"
          {{ block.shopify_attributes }}
        >
          {% comment %} <span class="ips__tab-icon" aria-hidden="true">
            {%- case block.settings.pet_type -%}
              {%- when 'dog' -%}🐶
              {%- when 'cat' -%}🐱
              {%- when 'bird' -%}🦜
              {%- when 'fish' -%}🐠
              {%- when 'rabbit' -%}🐰
              {%- else -%}🐾
            {%- endcase -%}
          </span> {% endcomment %}
          <span class="ips__tab-label">{{ block.settings.pet_name }}</span>
          <span class="ips__tab-indicator" aria-hidden="true"></span>
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment %} ── Main Stage ── {% endcomment %}
  <div class="ips__stage" id="ips-stage-{{ section.id }}">

    {%- for block in section.blocks -%}
      {%- if block.type == 'pet' -%}
        {%- liquid
          assign pet_name    = block.settings.pet_name
          assign pet_image   = block.settings.pet_image
          assign pet_type    = block.settings.pet_type
          assign accent      = block.settings.accent_color
          assign pet_desc    = block.settings.pet_description
          assign pet_fact    = block.settings.fun_fact
        -%}

        <div
          class="ips__panel{% if forloop.first %} is-active{% endif %}"
          id="ips-panel-{{ block.id }}"
          role="tabpanel"
          aria-labelledby="ips-tab-{{ block.id }}"
          data-pet-id="{{ block.id }}"
          data-accent="{{ accent }}"
          style="--ips-accent: {{ accent }};"
        >

          {%- comment %} ── Two-column layout ── {% endcomment %}
          <div class="ips__layout">

            {%- comment %} ── LEFT: Pet Stage ── {% endcomment %}
            <div class="ips__pet-stage">

              {%- comment %} ── Decorative ring ── {% endcomment %}
              <div class="ips__pet-ring" aria-hidden="true">
                <div class="ips__pet-ring-inner"></div>
                <div class="ips__pet-ring-pulse"></div>
                <div class="ips__pet-ring-dots">
                  {%- for i in (1..8) -%}
                    <span class="ips__ring-dot" style="--i: {{ forloop.index }};"></span>
                  {%- endfor -%}
                </div>
              </div>

              {%- comment %} ── Pet Image Container ── {% endcomment %}
              <div class="ips__pet-wrap" id="ips-pet-{{ block.id }}">

                {%- comment %} ── Platform shadow ── {% endcomment %}
                <div class="ips__pet-shadow" aria-hidden="true"></div>

                {%- if pet_image != blank -%}
                  <img
                    class="ips__pet-img"
                    src="{{ pet_image | image_url: width: 900 }}"
                    srcset="
                      {{ pet_image | image_url: width: 500 }} 500w,
                      {{ pet_image | image_url: width: 800 }} 800w,
                      {{ pet_image | image_url: width: 1100 }} 1100w
                    "
                    sizes="(max-width: 767px) 90vw, 50vw"
                    alt="{{ pet_image.alt | default: pet_name | escape }}"
                    loading="{{ forloop.first | ternary: 'eager', 'lazy' }}"
                    decoding="async"
                    width="{{ pet_image.width }}"
                    height="{{ pet_image.height }}"
                  >
                {%- else -%}
                  {%- comment %} Placeholder SVG per pet type ── {% endcomment %}
                  <div class="ips__pet-placeholder" aria-label="{{ pet_name }} illustration">
                    {%- case pet_type -%}
                      {%- when 'dog' -%}
                        <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <defs>
                            <radialGradient id="dogGrad-{{ block.id }}" cx="50%" cy="40%" r="55%">
                              <stop offset="0%" stop-color="{{ accent }}22"/>
                              <stop offset="100%" stop-color="{{ accent }}08"/>
                            </radialGradient>
                          </defs>
                          <circle cx="200" cy="200" r="180" fill="url(#dogGrad-{{ block.id }})"/>
                          <!-- Dog body -->
                          <ellipse cx="200" cy="270" rx="90" ry="70" fill="#c8a882"/>
                          <!-- Dog head -->
                          <circle cx="200" cy="175" r="72" fill="#d4b896"/>
                          <!-- Ears -->
                          <ellipse cx="148" cy="140" rx="28" ry="42" fill="#b8966e" transform="rotate(-15 148 140)"/>
                          <ellipse cx="252" cy="140" rx="28" ry="42" fill="#b8966e" transform="rotate(15 252 140)"/>
                          <!-- Face -->
                          <ellipse cx="185" cy="185" rx="10" ry="12" fill="#3d2b1f"/>
                          <ellipse cx="215" cy="185" rx="10" ry="12" fill="#3d2b1f"/>
                          <circle cx="187" cy="182" r="3" fill="#fff" opacity="0.8"/>
                          <circle cx="217" cy="182" r="3" fill="#fff" opacity="0.8"/>
                          <ellipse cx="200" cy="205" rx="20" ry="14" fill="#c17f5a"/>
                          <ellipse cx="200" cy="210" rx="12" ry="7" fill="#e8a080"/>
                          <!-- Nose -->
                          <ellipse cx="200" cy="200" rx="10" ry="7" fill="#3d2b1f"/>
                          <!-- Tail -->
                          <path d="M285 250 Q340 200 330 160" stroke="#c8a882" stroke-width="18" fill="none" stroke-linecap="round"/>
                          <!-- Paws -->
                          <ellipse cx="160" cy="335" rx="30" ry="20" fill="#c8a882"/>
                          <ellipse cx="240" cy="335" rx="30" ry="20" fill="#c8a882"/>
                        </svg>
                      {%- when 'cat' -%}
                        <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <defs>
                            <radialGradient id="catGrad-{{ block.id }}" cx="50%" cy="40%" r="55%">
                              <stop offset="0%" stop-color="{{ accent }}22"/>
                              <stop offset="100%" stop-color="{{ accent }}08"/>
                            </radialGradient>
                          </defs>
                          <circle cx="200" cy="200" r="180" fill="url(#catGrad-{{ block.id }})"/>
                          <!-- Body -->
                          <ellipse cx="200" cy="275" rx="80" ry="68" fill="#a0846a"/>
                          <!-- Head -->
                          <circle cx="200" cy="175" r="68" fill="#b8967a"/>
                          <!-- Ears -->
                          <polygon points="148,120 130,65 175,105" fill="#a0846a"/>
                          <polygon points="252,120 270,65 225,105" fill="#a0846a"/>
                          <polygon points="150,115 136,75 170,108" fill="#e8b4b0"/>
                          <polygon points="250,115 264,75 230,108" fill="#e8b4b0"/>
                          <!-- Eyes -->
                          <ellipse cx="178" cy="175" rx="14" ry="16" fill="#2d5a27"/>
                          <ellipse cx="222" cy="175" rx="14" ry="16" fill="#2d5a27"/>
                          <ellipse cx="178" cy="175" rx="6" ry="14" fill="#1a1a1a"/>
                          <ellipse cx="222" cy="175" rx="6" ry="14" fill="#1a1a1a"/>
                          <circle cx="182" cy="170" r="3" fill="#fff" opacity="0.9"/>
                          <circle cx="226" cy="170" r="3" fill="#fff" opacity="0.9"/>
                          <!-- Nose -->
                          <polygon points="200,198 194,208 206,208" fill="#d4756a"/>
                          <!-- Whiskers -->
                          <line x1="130" y1="205" x2="188" y2="210" stroke="#6b5040" stroke-width="1.5" opacity="0.6"/>
                          <line x1="130" y1="215" x2="188" y2="215" stroke="#6b5040" stroke-width="1.5" opacity="0.6"/>
                          <line x1="212" y1="210" x2="270" y2="205" stroke="#6b5040" stroke-width="1.5" opacity="0.6"/>
                          <line x1="212" y1="215" x2="270" y2="215" stroke="#6b5040" stroke-width="1.5" opacity="0.6"/>
                          <!-- Tail -->
                          <path d="M275 300 Q330 260 320 200 Q310 160 290 170" stroke="#a0846a" stroke-width="16" fill="none" stroke-linecap="round"/>
                          <!-- Paws -->
                          <ellipse cx="165" cy="338" rx="28" ry="18" fill="#a0846a"/>
                          <ellipse cx="235" cy="338" rx="28" ry="18" fill="#a0846a"/>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <circle cx="200" cy="200" r="150" fill="{{ accent }}15" stroke="{{ accent }}30" stroke-width="2"/>
                          <text x="200" y="220" text-anchor="middle" font-size="100" fill="{{ accent }}60">🐾</text>
                        </svg>
                      {%- endcase -%}
                  </div>
                {%- endif -%}

                {%- comment %} ── Hotspot Pins ── {% endcomment %}
                {%- assign hotspot_count = 0 -%}
                {%- for inner_block in section.blocks -%}
                  {%- if inner_block.type == 'hotspot' and inner_block.settings.parent_pet == block.id -%}
                    {%- assign hotspot_count = hotspot_count | plus: 1 -%}
                    {%- liquid
                      assign hs_label    = inner_block.settings.hotspot_label
                      assign hs_product  = inner_block.settings.hotspot_product
                      assign hs_x        = inner_block.settings.position_x
                      assign hs_y        = inner_block.settings.position_y
                      assign hs_color    = inner_block.settings.hotspot_color
                      assign hs_icon     = inner_block.settings.hotspot_icon
                      assign hs_desc     = inner_block.settings.hotspot_description
                      assign hs_price    = inner_block.settings.hotspot_price
                      assign hs_link     = inner_block.settings.hotspot_link
                      assign hs_img      = inner_block.settings.hotspot_product_image
                      assign hs_index    = forloop.index
                    -%}

                    <div
                      class="ips__hotspot"
                      id="ips-hs-{{ inner_block.id }}"
                      style="
                        left: {{ hs_x }}%;
                        top: {{ hs_y }}%;
                        --hs-color: {{ hs_color }};
                      "
                      data-hotspot-id="{{ inner_block.id }}"
                      data-index="{{ hotspot_count }}"
                      {{ inner_block.shopify_attributes }}
                    >
                      {%- comment %} ── Pin button ── {% endcomment %}
                      <button
                        class="ips__pin"
                        aria-label="View {{ hs_label | escape }} details"
                        aria-expanded="false"
                        aria-controls="ips-tooltip-{{ inner_block.id }}"
                        type="button"
                      >
                        <span class="ips__pin-pulse" aria-hidden="true"></span>
                        <span class="ips__pin-pulse ips__pin-pulse--2" aria-hidden="true"></span>
                        <span class="ips__pin-core" aria-hidden="true">
                          {%- case hs_icon -%}
                            {%- when 'collar' -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="9"/>
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>
                              </svg>
                            {%- when 'toy' -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                              </svg>
                            {%- when 'food' -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                                <line x1="6" y1="1" x2="6" y2="4"/>
                                <line x1="10" y1="1" x2="10" y2="4"/>
                                <line x1="14" y1="1" x2="14" y2="4"/>
                              </svg>
                            {%- when 'bed' -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M2 4v16M2 8h20v12H2"/>
                                <path d="M2 14h20"/>
                                <path d="M6 14v-4h4v4"/>
                                <path d="M14 14v-4h4v4"/>
                              </svg>
                            {%- when 'medicine' -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                                <circle cx="12" cy="12" r="3"/>
                                <line x1="12" y1="9" x2="12" y2="15"/>
                                <line x1="9" y1="12" x2="15" y2="12"/>
                              </svg>
                            {%- else -%}
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                              </svg>
                          {%- endcase -%}
                        </span>
                        <span class="ips__pin-number" aria-hidden="true">{{ hotspot_count }}</span>
                      </button>

                      {%- comment %} ── Tooltip Card ── {% endcomment %}
                      <div
                        class="ips__tooltip"
                        id="ips-tooltip-{{ inner_block.id }}"
                        role="tooltip"
                        aria-hidden="true"
                      >
                        <div class="ips__tooltip-inner">

                          {%- comment %} Tooltip header ── {% endcomment %}
                          <div class="ips__tooltip-header">
                            <div class="ips__tooltip-tag" style="background: {{ hs_color }}20; color: {{ hs_color }};">
                              {{ hs_icon | capitalize | default: 'Product' }}
                            </div>
                            <button
                              class="ips__tooltip-close"
                              aria-label="Close {{ hs_label | escape }} details"
                              type="button"
                            >
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                              </svg>
                            </button>
                          </div>

                          {%- comment %} Tooltip image ── {% endcomment %}
                          {%- if hs_img != blank -%}
                            <div class="ips__tooltip-img-wrap">
                              <img
                                class="ips__tooltip-img"
                                src="{{ hs_img | image_url: width: 300 }}"
                                alt="{{ hs_img.alt | default: hs_label | escape }}"
                                loading="lazy"
                                decoding="async"
                                width="{{ hs_img.width }}"
                                height="{{ hs_img.height }}"
                              >
                            </div>
                          {%- elsif hs_product != blank -%}
                            <div class="ips__tooltip-img-wrap">
                              <img
                                class="ips__tooltip-img"
                                src="{{ hs_product.featured_image | image_url: width: 300 }}"
                                alt="{{ hs_product.featured_image.alt | default: hs_product.title | escape }}"
                                loading="lazy"
                                decoding="async"
                              >
                            </div>
                          {%- else -%}
                            <div class="ips__tooltip-img-placeholder" style="background: {{ hs_color }}15;" aria-hidden="true">
                              <span style="font-size: 32px;">
                                {%- case hs_icon -%}
                                  {%- when 'collar' -%}🦮
                                  {%- when 'toy' -%}🎾
                                  {%- when 'food' -%}🍖
                                  {%- when 'bed' -%}🛏️
                                  {%- when 'medicine' -%}💊
                                  {%- else -%}🐾
                                {%- endcase -%}
                              </span>
                            </div>
                          {%- endif -%}

                          {%- comment %} Tooltip body ── {% endcomment %}
                          <div class="ips__tooltip-body">
                            <h4 class="ips__tooltip-title">
                              {%- if hs_product != blank -%}
                                {{ hs_product.title }}
                              {%- else -%}
                                {{ hs_label }}
                              {%- endif -%}
                            </h4>
                            {%- if hs_desc != blank -%}
                              <p class="ips__tooltip-desc">{{ hs_desc }}</p>
                            {%- elsif hs_product != blank -%}
                              <p class="ips__tooltip-desc">{{ hs_product.description | strip_html | truncate: 80 }}</p>
                            {%- endif -%}

                            <div class="ips__tooltip-footer">
                              <div class="ips__tooltip-price">
                                {%- if hs_product != blank -%}
                                  {%- if hs_product.compare_at_price > hs_product.price -%}
                                    <span class="ips__tooltip-price-compare">{{ hs_product.compare_at_price | money }}</span>
                                  {%- endif -%}
                                  <span class="ips__tooltip-price-main">{{ hs_product.price | money }}</span>
                                {%- elsif hs_price != blank -%}
                                  <span class="ips__tooltip-price-main">{{ hs_price }}</span>
                                {%- endif -%}
                              </div>
                              {%- if hs_link != blank or hs_product != blank -%}
                                <a
                                  href="{{ hs_product.url | default: hs_link }}"
                                  class="ips__tooltip-cta"
                                  aria-label="Shop {{ hs_label | escape }}"
                                >
                                  <span>Shop Now</span>
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                  </svg>
                                </a>
                              {%- endif -%}
                            </div>
                          </div>

                        </div>
                        <div class="ips__tooltip-arrow" aria-hidden="true"></div>
                      </div>

                    </div>
                  {%- endif -%}
                {%- endfor -%}

              </div>

              {%- comment %} ── Fun fact bubble ── {% endcomment %}
              {%- if pet_fact != blank -%}
                <div class="ips__fact-bubble" aria-label="Fun fact about {{ pet_name | escape }}">
                  <div class="ips__fact-icon" aria-hidden="true">💡</div>
                  <p class="ips__fact-text">{{ pet_fact }}</p>
                </div>
              {%- endif -%}

            </div>

            {%- comment %} ── RIGHT: Info + Hotspot List ── {% endcomment %}
            <div class="ips__info-panel">

              {%- comment %} ── Pet identity ── {% endcomment %}
              <div class="ips__pet-identity">
                <div class="ips__pet-badge" style="background: {{ accent }}18; border-color: {{ accent }}30;">
                  <span class="ips__pet-badge-dot" style="background: {{ accent }};"></span>
                  <span class="ips__pet-badge-label">{{ pet_type | capitalize }}</span>
                </div>
                <h3 class="ips__pet-name">{{ pet_name }}</h3>
                {%- if pet_desc != blank -%}
                  <p class="ips__pet-desc">{{ pet_desc }}</p>
                {%- endif -%}
              </div>

              {%- comment %} ── Accessory list ── {% endcomment %}
              <div class="ips__accessory-list">
                <div class="ips__accessory-list-header">
                  <span class="ips__accessory-list-title">Explore Accessories</span>
                  <span class="ips__accessory-count" aria-live="polite">
                    {%- assign pet_hs_count = 0 -%}
                    {%- for inner_block in section.blocks -%}
                      {%- if inner_block.type == 'hotspot' and inner_block.settings.parent_pet == block.id -%}
                        {%- assign pet_hs_count = pet_hs_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {{ pet_hs_count }} items
                  </span>
                </div>

                <div class="ips__accessory-items">
                  {%- assign item_idx = 0 -%}
                  {%- for inner_block in section.blocks -%}
                    {%- if inner_block.type == 'hotspot' and inner_block.settings.parent_pet == block.id -%}
                      {%- assign item_idx = item_idx | plus: 1 -%}
                      <div
                        class="ips__accessory-item"
                        data-hotspot-target="{{ inner_block.id }}"
                        style="--hs-color: {{ inner_block.settings.hotspot_color }};"
                        tabindex="0"
                        role="button"
                        aria-label="Highlight {{ inner_block.settings.hotspot_label | escape }} on pet"
                      >
                        <div class="ips__accessory-num" style="background: {{ inner_block.settings.hotspot_color }}18; color: {{ inner_block.settings.hotspot_color }};">
                          {{ item_idx }}
                        </div>
                        <div class="ips__accessory-content">
                          <span class="ips__accessory-name">{{ inner_block.settings.hotspot_label }}</span>
                          {%- if inner_block.settings.hotspot_price != blank or inner_block.settings.hotspot_product != blank -%}
                            <span class="ips__accessory-price">
                              {%- if inner_block.settings.hotspot_product != blank -%}
                                {{ inner_block.settings.hotspot_product.price | money }}
                              {%- else -%}
                                {{ inner_block.settings.hotspot_price }}
                              {%- endif -%}
                            </span>
                          {%- endif -%}
                        </div>
                        <div class="ips__accessory-arrow" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

              {%- comment %} ── Shop all CTA ── {% endcomment %}
              {%- if block.settings.shop_all_link != blank -%}
                <a

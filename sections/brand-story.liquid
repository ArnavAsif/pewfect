{%- comment %} ══════════════════════════════════════════════════════════
   JAVASCRIPT
══════════════════════════════════════════════════════════ {% endcomment %}

<script>
/* ── Load GSAP once per page ─────────────────────────────── */
(function () {
  if (window.__bsGsap) return;
  window.__bsGsap = 'loading';
  const G = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
  const T = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
  function load(src, cb) {
    const el = document.createElement('script');
    el.src = src; el.defer = true; el.onload = cb;
    document.head.appendChild(el);
  }
  load(G, () => load(T, () => {
    window.__bsGsap = 'ready';
    document.dispatchEvent(new CustomEvent('bs:gsap-ready'));
  }));
}());
</script>

<script>
(function () {
  'use strict';

  const sid    = '{{ sid }}';
  const noMo   = () => window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  const mobile = () => window.matchMedia('(max-width:767px)').matches;
  const S      = (sel, ctx) => (ctx || document).querySelector(sel);
  const SA     = (sel, ctx) => [...(ctx || document).querySelectorAll(sel)];

  const section = document.getElementById(sid);
  if (!section) return;

  const layout = '{{ layout }}';

  /* ── DOM refs ─────────────────────────────────────────── */
  const mediaWrap    = S('[data-bs-media-wrap]',  section);
  const mediaEl      = S('[data-bs-media]',        section);
  const mediaImg     = S('[data-bs-img]',          section);
  const contentEl    = S('[data-bs-content]',      section);
  const labelEl      = S('[data-bs-label]',        section);
  const headLines    = SA('.bs__heading-inner',    section);
  const accentMark   = S('[data-bs-mark]',         section);
  const bodyEl       = S('[data-bs-body]',         section);
  const valuesEl     = S('[data-bs-values]',       section);
  const ctaEl        = S('[data-bs-cta]',          section);
  const quoteEl      = S('[data-bs-quote]',        section);
  const vertLine     = S('.bs__vert-line-fill',    section);
  const emotionCard  = S('[data-bs-float]',        section);
  const blurShape    = S('.bs__img-blur-shape',    section);

  let ctx = null;

  /* ══════════════════════════════════════════════════════
     INIT ANIMATIONS
  ══════════════════════════════════════════════════════ */
  function initAnimations () {
    if (!window.gsap) {
      revealAll(); return;
    }
    if (noMo()) { revealAll(); return; }

    gsap.registerPlugin(ScrollTrigger);

    ctx = gsap.context(() => {

      /* ── Common trigger config ────────────────────────── */
      const triggerBase = {
        trigger: section,
        start:   'top 78%',
        once:    true,
      };

      /* ══════════════════════════════════════════════════
         1. PARALLAX — image moves slower than scroll
      ══════════════════════════════════════════════════ */
      const parallaxTarget = layout === 'overlay' ? mediaEl : mediaImg;

      if (parallaxTarget && {{ enable_parallax | default: true | json }}) {
        const intensity = mobile() ? 10 : 22;
        gsap.to(parallaxTarget, {
          yPercent: intensity,
          ease:     'none',
          scrollTrigger: {
            trigger: section,
            start:   'top bottom',
            end:     'bottom top',
            scrub:   1.6,
          },
        });
      }

      /* ── Blur shape parallax (split layouts) ─────────── */
      if (blurShape && layout !== 'overlay') {
        gsap.to(blurShape, {
          yPercent: -14,
          ease:     'none',
          scrollTrigger: {
            trigger: section,
            start:   'top bottom',
            end:     'bottom top',
            scrub:   2,
          },
        });
      }

      /* ══════════════════════════════════════════════════
         2. IMAGE SCALE on scroll (subtle zoom-in)
      ══════════════════════════════════════════════════ */
      if (mediaImg && !mobile()) {
        gsap.to(mediaImg, {
          scale:    1.08,
          ease:     'none',
          scrollTrigger: {
            trigger: section,
            start:   'top bottom',
            end:     'center top',
            scrub:   2,
          },
        });
      }

      /* ══════════════════════════════════════════════════
         3. MEDIA FRAME reveal
      ══════════════════════════════════════════════════ */
      const mediaRevealTarget = layout === 'overlay'
        ? null
        : S('.bs__img-frame', section);

      if (mediaRevealTarget) {
        gsap.fromTo(mediaRevealTarget,
          { opacity:0, x: layout === 'split-right' ? -40 : 40, scale:0.94 },
          {
            opacity:  1,
            x:        0,
            scale:    1,
            duration: 1.10,
            ease:     'power3.out',
            scrollTrigger: {
              ...triggerBase,
              start: 'top 80%',
            },
          }
        );
      }

      /* ══════════════════════════════════════════════════
         4. TEXT ELEMENTS — staggered reveal
      ══════════════════════════════════════════════════ */
      const tl = gsap.timeline({
        scrollTrigger: {
          ...triggerBase,
          start: 'top 75%',
        },
        defaults: { ease:'power3.out' },
      });

      /* Vertical line draw */
      if (vertLine) {
        tl.to(vertLine, { height:'100%', duration:0.90 }, 0);
      }

      /* Label */
      if (labelEl) {
        tl.to(labelEl, {
          opacity:1, y:0, duration:0.55,
        }, 0.15);
      }

      /* Heading lines — cascade */
      if (headLines.length) {
        tl.to(headLines, {
          opacity:  1,
          y:        '0%',
          duration: 0.70,
          stagger:  0.12,
          ease:     'power3.out',
        }, labelEl ? 0.32 : 0.15);
      }

      /* Accent wave mark */
      if (accentMark) {
        tl.to(accentMark, {
          opacity:1, x:0, duration:0.50,
        }, '-=0.35');
      }

      /* Body */
      if (bodyEl) {
        tl.to(bodyEl, {
          opacity:1, y:0, duration:0.60,
        }, '-=0.38');
      }

      /* Values */
      if (valuesEl) {
        const items = SA('.bs__value-item', valuesEl);
        tl.to(items, {
          opacity:  1,
          y:        0,
          duration: 0.45,
          stagger:  0.08,
        }, '-=0.35');
        gsap.set(items, { opacity:0, y:12 });
      }

      /* CTA */
      if (ctaEl) {
        tl.to(ctaEl, {
          opacity:1, y:0, duration:0.55,
          ease:'back.out(1.4)',
        }, '-=0.30');
      }

      /* Quote */
      if (quoteEl) {
        tl.to(quoteEl, {
          opacity:1, x:0, duration:0.60,
          ease:'power2.out',
        }, '-=0.25');
      }

      /* ══════════════════════════════════════════════════
         5. EMOTION CARD reveal
      ══════════════════════════════════════════════════ */
      if (emotionCard) {
        gsap.to(emotionCard, {
          opacity:  1,
          y:        0,
          scale:    1,
          duration: 0.65,
          delay:    0.90,
          ease:     'back.out(1.6)',
          scrollTrigger: triggerBase,
        });
        gsap.set(emotionCard, { scale:0.85, y:16 });
      }

      /* ══════════════════════════════════════════════════
         6. SECTION EXIT — gentle fade & drift up
      ══════════════════════════════════════════════════ */
      if (!mobile()) {
        gsap.to(section, {
          opacity:   0.70,
          yPercent:  -3,
          ease:      'none',
          scrollTrigger: {
            trigger: section,
            start:   'bottom 30%',
            end:     'bottom top',
            scrub:   true,
          },
        });
      }

    }, section);
  }

  /* ── Fallback: reveal all ─────────────────────────────── */
  function revealAll () {
    const els = [
      labelEl, accentMark, bodyEl,
      valuesEl, ctaEl, quoteEl, emotionCard,
    ];
    els.forEach(el => {
      if (!el) return;
      el.style.opacity   = '1';
      el.style.transform = 'none';
    });
    headLines.forEach(el => {
      el.style.opacity   = '1';
      el.style.transform = 'none';
    });
    if (vertLine) vertLine.style.height = '100%';

    const mediaFrame = S('.bs__img-frame', section);
    if (mediaFrame) {
      mediaFrame.style.opacity   = '1';
      mediaFrame.style.transform = 'none';
    }
  }

  /* ── Boot ───────────────────────────────────────────────── */
  function boot() {
    if (window.__bsGsap === 'ready') {
      initAnimations();
    } else {
      document.addEventListener('bs:gsap-ready', initAnimations, { once:true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once:true });
  } else {
    boot();
  }

  /* ── Theme editor ─────────────────────────────────────── */
  document.addEventListener('shopify:section:unload', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    if (ctx) ctx.revert();
  });
  document.addEventListener('shopify:section:load', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    boot();
  });

}());
</script>



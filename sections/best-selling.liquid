      "content": "✍️ Content"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Best Selling Products"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Subtitle",
      "default": "Handpicked favourites your pets will absolutely love."
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "🛍️ Products"
    },
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Product Collection",
      "info": "Select a collection to pull products from automatically."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max Products to Show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "🎨 Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FDF9F4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF7A35",
      "info": "Used for buttons, badges, eyebrow text and progress bar."
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Style",
      "options": [
        { "value": "default", "label": "Default (white card)" },
        { "value": "minimal", "label": "Minimal (no shadow)" },
        { "value": "bordered", "label": "Bordered" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "⚙️ Behaviour"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4,
      "info": "Seconds between slides. Only active if autoplay is enabled."
    },
    {
      "type": "header",
      "content": "🏷️ Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Star Ratings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show 'Best Seller' Badge",
      "default": true,
      "info": "Shown on first 3 products automatically."
    }
  ],
  "presets": [
    {
      "name": "🛒 Best Sellers Slider",
      "category": "Products"
    }
  ]
}

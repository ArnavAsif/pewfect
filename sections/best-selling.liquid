     FALLBACK — make everything visible (no GSAP)
  ───────────────────────────────────────────────────── */
  function revealAll(section) {
    section.querySelectorAll('.bsp__slide').forEach(function (slide) {
      slide.style.cssText += 'opacity:1!important;transform:none!important;';
    });
  }

  /* ─────────────────────────────────────────────────────
     FALLBACK NAV — native scroll, no GSAP required
  ───────────────────────────────────────────────────── */
  function fallbackNav(section) {
    var slides  = section.querySelectorAll('.bsp__slide');
    var outer   = section.querySelector('.bsp__outer');
    var prevBtn = section.querySelector('.bsp__nav-btn--prev');
    var nextBtn = section.querySelector('.bsp__nav-btn--next');
    var current = 0;

    if (!outer || !slides.length) return;

    outer.style.overflowX      = 'auto';
    outer.style.scrollSnapType = 'x mandatory';
    outer.style.cursor         = 'grab';
    slides.forEach(function (s) { s.style.scrollSnapAlign = 'start'; });

    function scrollTo(idx) {
      current = clamp(idx, 0, slides.length - 1);
      slides[current].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current >= slides.length - 1;
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollTo(current + 1); });
    scrollTo(0);
  }

  /* ─────────────────────────────────────────────────────
     MAIN INIT
  ───────────────────────────────────────────────────── */
  function init() {
    var section  = document.getElementById('bsp-' + SID);
    if (!section) return;

    var gsap      = window.gsap;
    var ST        = window.ScrollTrigger;
    var Draggable = window.Draggable;

    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isMobile       = window.matchMedia('(max-width: 767px)').matches;

    if (!gsap) { revealAll(section); fallbackNav(section); return; }

    if (ST)        gsap.registerPlugin(ST);
    if (Draggable) gsap.registerPlugin(Draggable);

    /* ── DOM refs ── */
    var outer    = section.querySelector('.bsp__outer');
    var track    = section.querySelector('.bsp__track');
    var slides   = section.querySelectorAll('.bsp__slide');
    var prevBtn  = section.querySelector('.bsp__nav-btn--prev');
    var nextBtn  = section.querySelector('.bsp__nav-btn--next');
    var progress = section.querySelector('.bsp__progress-fill');
    var dotsWrap = section.querySelector('.bsp__dots');
    var dragHint = section.querySelector('.bsp__drag-hint');
    var header   = section.querySelector('.bsp__header');

    var totalSlides  = slides.length;
    var currentIndex = 0;
    var isAnimating  = false;
    var autoTimer    = null;

    if (!totalSlides || !track) { revealAll(section); fallbackNav(section); return; }

    /* ─────────────────────────────────────────────
       BUILD DOTS
    ───────────────────────────────────────────── */
    var dots = [];
    slides.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.className = 'bsp__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', 'Go to product ' + (i + 1));
      dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      dot.setAttribute('data-index', i);
      dot.addEventListener('click', function () { goTo(i, true); });
      dotsWrap.appendChild(dot);
      dots.push(dot);
    });

    /* ─────────────────────────────────────────────
       CARD WIDTH HELPER
    ───────────────────────────────────────────── */
    function getCardWidth() {
      if (!slides[0]) return 300;
      var gap = parseFloat(getComputedStyle(track).gap) || 0;
      return slides[0].offsetWidth + gap;
    }

    /* ─────────────────────────────────────────────
       MAX X (prevent over-scroll past last card)
    ───────────────────────────────────────────── */
    function getMaxX() {
      var trackW = track.scrollWidth;
      var outerW = outer.offsetWidth;
      var pad    = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      return -(trackW - outerW - pad);
    }

    /* ─────────────────────────────────────────────
       GET X FOR INDEX
       FIX: removed incorrect + pad offset that was
       shifting cards right on every navigation step
    ───────────────────────────────────────────── */
    function getXForIndex(idx) {
      var cardW = getCardWidth();
      var x     = -(idx * cardW);
      return clamp(x, getMaxX(), 0);
    }

    /* ─────────────────────────────────────────────
       UPDATE UI
    ───────────────────────────────────────────── */
    function updateUI(idx) {
      dots.forEach(function (d, i) {
        var active = i === idx;
        d.classList.toggle('is-active', active);
        d.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (progress) {
        var pct = totalSlides > 1
          ? (idx / (totalSlides - 1)) * 100
          : 100;
        progress.style.width = pct + '%';
      }

      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx >= totalSlides - 1;
    }

    /* ─────────────────────────────────────────────
       GO TO SLIDE
    ───────────────────────────────────────────── */
    function goTo(idx, userAction) {
      if (isAnimating && !userAction) return;
      idx = clamp(idx, 0, totalSlides - 1);

      if (idx === currentIndex && userAction) return;
      currentIndex = idx;

      isAnimating = true;
      var targetX = getXForIndex(idx);

      gsap.to(track, {
        x: targetX,
        duration: prefersReduced ? 0 : 0.72,
        ease: 'power3.out',
        onComplete: function () { isAnimating = false; }
      });

      updateUI(idx);

      if (userAction && AUTOPLAY) {
        stopAutoplay();
        startAutoplay();
      }
    }

    /* ─────────────────────────────────────────────
       NAV BUTTONS
    ───────────────────────────────────────────── */
    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        goTo(currentIndex - 1, true);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        goTo(currentIndex + 1, true);
      });
    }

    /* Initial state */
    updateUI(0);
    gsap.set(track, { x: getXForIndex(0) });

    /* ─────────────────────────────────────────────
       GSAP DRAGGABLE
    ───────────────────────────────────────────── */
    if (Draggable && !isMobile) {
      var draggableInst = Draggable.create(track, {
        type: 'x',
        bounds: {
          minX: getMaxX(),
          maxX: 0
        },
        /* inertia requires paid InertiaPlugin — disabled */
        inertia: false,
        edgeResistance: 0.75,
        snap: {
          x: function (rawX) {
            var cardW = getCardWidth();
            var idx   = Math.round(-rawX / cardW);
            idx = clamp(idx, 0, totalSlides - 1);
            return getXForIndex(idx);
          }
        },
        onDragStart: function () {
          outer.classList.add('is-dragging');
          stopAutoplay();
          hideDragHint();
        },
        onDragEnd: function () {
          outer.classList.remove('is-dragging');

          var currentX = gsap.getProperty(track, 'x');
          var cardW    = getCardWidth();
          var newIdx   = Math.round(-currentX / cardW);
          newIdx = clamp(newIdx, 0, totalSlides - 1);

          if (newIdx !== currentIndex) {
            currentIndex = newIdx;
            updateUI(newIdx);
          }

          if (AUTOPLAY) startAutoplay();
        },
        onClick: function (e) {
          if (Math.abs(this.deltaX) < 5 && Math.abs(this.deltaY) < 5) {
            var link = e.target.closest('a');
            if (link) window.location.href = link.href;
          }
        }
      })[0];

      window.addEventListener('resize', function () {
        if (draggableInst) {
          draggableInst.vars.bounds = {
            minX: getMaxX(),
            maxX: 0
          };
          draggableInst.applyBounds();
        }
        gsap.set(track, { x: getXForIndex(currentIndex) });
        updateUI(currentIndex);
      });

    } else {
      /* Mobile: native scroll */
      if (outer) {
        outer.style.overflowX      = 'auto';
        outer.style.scrollSnapType = 'x mandatory';
        track.style.width          = 'max-content';

        slides.forEach(function (s) {
          s.style.scrollSnapAlign = 'start';
        });

        var scrollTick = false;
        outer.addEventListener('scroll', function () {
          if (scrollTick) return;
          scrollTick = true;
          requestAnimationFrame(function () {
            var idx = Math.round(outer.scrollLeft / getCardWidth());
            idx = clamp(idx, 0, totalSlides - 1);
            if (idx !== currentIndex) {
              currentIndex = idx;
              updateUI(idx);
            }
            scrollTick = false;
          });
        }, { passive: true });
      }
    }

    /* ─────────────────────────────────────────────
       KEYBOARD NAVIGATION
    ───────────────────────────────────────────── */
    outer && outer.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(currentIndex - 1, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(currentIndex + 1, true); }
    });

    /* ─────────────────────────────────────────────
       AUTOPLAY
    ───────────────────────────────────────────── */
    function startAutoplay() {
      if (!AUTOPLAY || prefersReduced) return;
      autoTimer = setInterval(function () {
        var next = currentIndex + 1 >= totalSlides ? 0 : currentIndex + 1;
        goTo(next, false);
      }, AUTOPLAY_SPD);
    }

    function stopAutoplay() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    startAutoplay();

    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', function () {
      if (AUTOPLAY) startAutoplay();
    });

    /* ─────────────────────────────────────────────
       DRAG HINT
    ───────────────────────────────────────────── */
    function showDragHint() {
      if (!dragHint || isMobile) return;
      dragHint.classList.add('is-visible');
      setTimeout(hideDragHint, 2200);
    }

    function hideDragHint() {
      if (dragHint) dragHint.classList.remove('is-visible');
    }

    /* ─────────────────────────────────────────────
       SCROLL ENTRANCE ANIMATIONS
    ───────────────────────────────────────────── */
    if (ST && !prefersReduced) {

      if (header) {
        var hEls = [
          header.querySelector('.bsp__eyebrow'),
          header.querySelector('.bsp__title'),
          header.querySelector('.bsp__subtitle')
        ].filter(Boolean);

        gsap.fromTo(hEls,
          { y: 22, opacity: 0 },
          {
            y: 0, opacity: 1,
            duration: 0.7,
            stagger: 0.1,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: header,
              start: 'top 88%',
              once: true
            }
          }
        );
      }

      gsap.fromTo(slides,
        { y: 32, opacity: 0, scale: 0.97 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.68,
          stagger: 0.09,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: outer,
            start: 'top 85%',
            once: true,
            onEnter: function () {
              setTimeout(showDragHint, 600);
            }
          }
        }
      );

    } else {
      revealAll(section);
    }

    /* ─────────────────────────────────────────────
       ADD TO CART — AJAX
    ───────────────────────────────────────────── */
    section.querySelectorAll('.bsp__atc-form').forEach(function (form) {
      if (!form.action) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var btn       = form.querySelector('.bsp__atc-btn');
        var btnText   = form.querySelector('.bsp__atc-btn-text');
        var variantId = form.querySelector('[name="id"]').value;
        var qty       = form.querySelector('[name="quantity"]')
                          ? form.querySelector('[name="quantity"]').value
                          : 1;

        if (!btn || btn.classList.contains('is-loading')) return;

        btn.classList.add('is-loading');
        var originalText = btnText ? btnText.textContent : '';
        if (btnText) btnText.textContent = 'Adding…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ id: variantId, quantity: parseInt(qty) })
        })
        .then(function (res) {
          if (!res.ok) throw new Error('Cart error');
          return res.json();
        })
        .then(function () {
          btn.classList.remove('is-loading');
          btn.classList.add('is-success');
          if (btnText) btnText.textContent = '✓ Added!';

          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('theme:cart:open', { bubbles: true }));

          fetch('/cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              var bubbles = document.querySelectorAll('.cart-count, .cart__count, [data-cart-count]');
              bubbles.forEach(function (b) { b.textContent = cart.item_count; });
            });

          setTimeout(function () {
            btn.classList.remove('is-success');
            if (btnText) btnText.textContent = originalText;
          }, 2200);
        })
        .catch(function () {
          btn.classList.remove('is-loading');
          if (btnText) {
            btnText.textContent = 'Try again';
            setTimeout(function () { btnText.textContent = originalText; }, 2000);
          }
        });
      });
    });

    /* ─────────────────────────────────────────────
       WISHLIST TOGGLE
    ───────────────────────────────────────────── */
    section.querySelectorAll('.bsp__wishlist').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.toggle('is-active');

        if (gsap) {
          gsap.fromTo(this,
            { scale: 1 },
            {
              scale: 1.35,
              duration: 0.15,
              ease: 'power2.out',
              yoyo: true,
              repeat: 1,
              onComplete: function () {
                gsap.set(this.targets()[0], { scale: 1 });
              }
            }
          );
        }
      });
    });

  } /* end init */

  /* ─────────────────────────────────────────────
     BOOTSTRAP
     FIX: InertiaPlugin removed from chain.
     It is Club GSAP (paid) and 404s on the free
     CDN, which caused the entire .catch() to fire
     before init() ever ran — breaking all buttons
     and drag functionality completely.
  ───────────────────────────────────────────── */
  function bootstrap() {
    loadScript(GSAP_SRC)
      .then(function () {
        return Promise.all([
          loadScript(ST_SRC),
          loadScript(DR_SRC)
        ]);
      })
      .then(function () {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(init);
            });
          });
        } else {
          requestAnimationFrame(function () {
            requestAnimationFrame(init);
          });
        }
      })
      .catch(function () {
        /* GSAP CDN blocked or failed — fall back gracefully */
        var sec = document.getElementById('bsp-' + SID);
        if (sec) {
          revealAll(sec);
          fallbackNav(sec);
        }
      });
  }

  bootstrap();
})();
</script>


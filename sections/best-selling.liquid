{% comment %}
  ============================================================
  Premium Pet Shop — Best Selling Products Slider
  File: sections/best-selling-products.liquid
  ============================================================
{% endcomment %}

{%- liquid
  assign section_title    = section.settings.section_title
  assign section_subtitle = section.settings.section_subtitle
  assign bg_color         = section.settings.background_color
  assign accent_color     = section.settings.accent_color
  assign products         = section.settings.product_collection.products
  assign products_limit   = section.settings.products_limit
  assign show_rating      = section.settings.show_rating
  assign show_badge       = section.settings.show_badge
  assign card_style       = section.settings.card_style
  assign autoplay         = section.settings.autoplay
  assign autoplay_speed   = section.settings.autoplay_speed
-%}

<section
  class="bsp"
  id="bsp-{{ section.id }}"
  aria-labelledby="bsp-title-{{ section.id }}"
  style="--bsp-accent: {{ accent_color }}; background: {{ bg_color }};"
>

  {%- comment %} ── Decorative BG ── {% endcomment %}
  <div class="bsp__bg-deco" aria-hidden="true">
    <div class="bsp__bg-blob bsp__bg-blob--1"></div>
    <div class="bsp__bg-blob bsp__bg-blob--2"></div>
  </div>

  {%- comment %} ── Header ── {% endcomment %}
  <div class="bsp__header">
    <div class="bsp__header-left">
      <div class="bsp__eyebrow" aria-hidden="true">
        <span class="bsp__eyebrow-pip"></span>
        <span class="bsp__eyebrow-pip"></span>
        <span class="bsp__eyebrow-text">Most Loved</span>
      </div>
      <h2 class="bsp__title" id="bsp-title-{{ section.id }}">
        {{ section_title }}
      </h2>
      {%- if section_subtitle != blank -%}
        <p class="bsp__subtitle">{{ section_subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="bsp__header-right">
      {%- if section.settings.view_all_link != blank -%}
        <a
          href="{{ section.settings.view_all_link }}"
          class="bsp__view-all"
          aria-label="View all best selling products"
        >
          <span>View All</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment %} ── Nav Arrows ── {% endcomment %}
      <div class="bsp__nav" aria-label="Slider navigation" role="group">
        <button
          class="bsp__nav-btn bsp__nav-btn--prev"
          id="bsp-prev-{{ section.id }}"
          aria-label="Previous products"
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          class="bsp__nav-btn bsp__nav-btn--next"
          id="bsp-next-{{ section.id }}"
          aria-label="Next products"
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {%- comment %} ── Slider Track ── {% endcomment %}
  <div
    class="bsp__outer"
    id="bsp-outer-{{ section.id }}"
    role="region"
    aria-label="Best selling products carousel"
  >
    <div
      class="bsp__track"
      id="bsp-track-{{ section.id }}"
      aria-live="polite"
    >

      {%- liquid
        if products != blank
          assign product_list = products | limit: products_limit
        endif
      -%}

      {%- if product_list != blank and product_list != empty -%}
        {%- for product in product_list -%}
          {%- liquid
            assign product_image   = product.featured_image
            assign product_title   = product.title
            assign product_price   = product.price | money
            assign compare_price   = product.compare_at_price | money
            assign on_sale         = false
            if product.compare_at_price > product.price
              assign on_sale = true
              assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
            endif
            assign first_variant   = product.first_available_variant
            assign is_available    = product.available
            assign product_url     = product.url
            assign vendor          = product.vendor
            assign product_type    = product.type
          -%}

          <div
            class="bsp__slide"
            data-product-id="{{ product.id }}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ product_title | escape }}, {{ product_price }}"
          >
            <div class="bsp__card bsp__card--{{ card_style }}" tabindex="0">

              {%- comment %} ── Card Image Area ── {% endcomment %}
              <div class="bsp__card-media">

                {%- comment %} ── Badges ── {% endcomment %}
                <div class="bsp__card-badges" aria-hidden="true">
                  {%- if show_badge -%}
                    {%- if forloop.index <= 3 -%}
                      <span class="bsp__badge bsp__badge--hot">
                        🔥 Best Seller
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if on_sale -%}
                    <span class="bsp__badge bsp__badge--sale">
                      -{{ save_pct }}%
                    </span>
                  {%- endif -%}
                  {%- unless is_available -%}
                    <span class="bsp__badge bsp__badge--sold">Sold Out</span>
                  {%- endunless -%}
                </div>

                {%- comment %} ── Wishlist btn ── {% endcomment %}
                <button
                  class="bsp__wishlist"
                  aria-label="Add {{ product_title | escape }} to wishlist"
                  type="button"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>

                {%- comment %} ── Product Image ── {% endcomment %}
                <a
                  href="{{ product_url }}"
                  class="bsp__card-img-link"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- if product_image != blank -%}
                    <img
                      class="bsp__card-img bsp__card-img--primary"
                      src="{{ product_image | image_url: width: 600 }}"
                      srcset="
                        {{ product_image | image_url: width: 300 }} 300w,
                        {{ product_image | image_url: width: 500 }} 500w,
                        {{ product_image | image_url: width: 700 }} 700w
                      "
                      sizes="(max-width: 767px) 72vw, (max-width: 1023px) 38vw, 22vw"
                      alt="{{ product_image.alt | default: product_title | escape }}"
                      loading="lazy"
                      decoding="async"
                      width="{{ product_image.width }}"
                      height="{{ product_image.height }}"
                    >
                    {%- if product.images[1] != blank -%}
                      <img
                        class="bsp__card-img bsp__card-img--secondary"
                        src="{{ product.images[1] | image_url: width: 600 }}"
                        srcset="
                          {{ product.images[1] | image_url: width: 300 }} 300w,
                          {{ product.images[1] | image_url: width: 500 }} 500w,
                          {{ product.images[1] | image_url: width: 700 }} 700w
                        "
                        sizes="(max-width: 767px) 72vw, (max-width: 1023px) 38vw, 22vw"
                        alt="{{ product.images[1].alt | default: product_title | escape }}"
                        loading="lazy"
                        decoding="async"
                        width="{{ product.images[1].width }}"
                        height="{{ product.images[1].height }}"
                        aria-hidden="true"
                      >
                    {%- endif -%}
                  {%- else -%}
                    <div class="bsp__card-img-placeholder" aria-hidden="true">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="1.2" opacity="0.3">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  {%- endif -%}

                  {%- comment %} ── Quick view trigger ── {% endcomment %}
                  <div class="bsp__quick-view" aria-hidden="true">
                    <span>Quick View</span>
                  </div>
                </a>

                {%- comment %} ── Add to Cart (slide-up panel) ── {% endcomment %}
                <div class="bsp__atc-panel" aria-hidden="true">
                  {%- if is_available -%}
                    <form
                      action="/cart/add"
                      method="post"
                      class="bsp__atc-form"
                      data-product-id="{{ product.id }}"
                    >
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <input type="hidden" name="quantity" value="1">

                      {%- comment %} Variant selector if multiple ── {% endcomment %}
                      {%- if product.variants.size > 1 -%}
                        <select
                          name="id"
                          class="bsp__variant-select"
                          aria-label="Select variant for {{ product_title | escape }}"
                        >
                          {%- for variant in product.variants -%}
                            <option
                              value="{{ variant.id }}"
                              {%- unless variant.available %} disabled{%- endunless -%}
                            >
                              {{ variant.title }}
                              {%- unless variant.available %} — Sold out{%- endunless -%}
                            </option>
                          {%- endfor -%}
                        </select>
                      {%- endif -%}

                      <button
                        type="submit"
                        class="bsp__atc-btn"
                        aria-label="Add {{ product_title | escape }} to cart"
                      >
                        <span class="bsp__atc-btn-icon" aria-hidden="true">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2.2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                          </svg>
                        </span>
                        <span class="bsp__atc-btn-text">Add to Cart</span>
                        <span class="bsp__atc-btn-price">{{ product_price }}</span>
                      </button>
                    </form>
                  {%- else -%}
                    <button class="bsp__atc-btn bsp__atc-btn--soldout" disabled>
                      <span>Sold Out</span>
                    </button>
                  {%- endif -%}
                </div>

              </div>

              {%- comment %} ── Card Info ── {% endcomment %}
              <div class="bsp__card-info">

                {%- comment %} ── Vendor / Type ── {% endcomment %}
                {%- if vendor != blank -%}
                  <span class="bsp__card-vendor">{{ vendor }}</span>
                {%- endif -%}

                {%- comment %} ── Title ── {% endcomment %}
                <h3 class="bsp__card-title">
                  <a
                    href="{{ product_url }}"
                    class="bsp__card-title-link"
                    aria-label="{{ product_title | escape }} — {{ product_price }}"
                  >
                    {{ product_title }}
                  </a>
                </h3>

                {%- comment %} ── Rating ── {% endcomment %}
                {%- if show_rating -%}
                  <div
                    class="bsp__card-rating"
                    aria-label="Rating: {{ block.settings.rating | default: '4.8' }} out of 5"
                  >
                    <div class="bsp__stars" aria-hidden="true">
                      {%- for i in (1..5) -%}
                        <svg class="bsp__star bsp__star--filled" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                    <span class="bsp__rating-count">({{ product.metafields.reviews.rating_count | default: '128' }})</span>
                  </div>
                {%- endif -%}

                {%- comment %} ── Price Row ── {% endcomment %}
                <div class="bsp__card-price-row">
                  <span class="bsp__card-price">{{ product_price }}</span>
                  {%- if on_sale -%}
                    <span class="bsp__card-compare">{{ compare_price }}</span>
                    <span class="bsp__card-save">Save {{ save_pct }}%</span>
                  {%- endif -%}
                </div>

                {%- comment %} ── Color swatches (if variants have colors) ── {% endcomment %}
                {%- assign has_color = false -%}
                {%- for option in product.options -%}
                  {%- if option == 'Color' or option == 'Colour' -%}
                    {%- assign has_color = true -%}
                    {%- assign color_option_idx = forloop.index0 -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if has_color -%}
                  <div class="bsp__swatches" aria-label="Available colors" role="group">
                    {%- assign shown_colors = '' -%}
                    {%- for variant in product.variants -%}
                      {%- assign color_val = variant.options[color_option_idx] -%}
                      {%- unless shown_colors contains color_val -%}
                        {%- assign shown_colors = shown_colors | append: color_val | append: ',' -%}
                        <button
                          class="bsp__swatch"
                          style="background-color: {{ color_val | downcase | replace: ' ', '' }};"
                          aria-label="{{ color_val }}"
                          title="{{ color_val }}"
                          type="button"
                        ></button>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

              </div>
            </div>
          </div>

        {%- endfor -%}

      {%- else -%}
        {%- comment %} ── Demo/placeholder cards ── {% endcomment %}
        {%- assign demo_products = 'Premium Dog Food,Cat Wellness Kit,Aquarium Starter,Bird Seed Mix,Pet Grooming Set,Cozy Pet Bed,Interactive Toy,Vitamin Treats' | split: ',' -%}
        {%- assign demo_prices = '$29.99,$34.99,$49.99,$18.99,$44.99,$59.99,$24.99,$19.99' | split: ',' -%}
        {%- assign demo_vendors = 'PawLife,MeowCo,AquaWorld,FeatherFresh,GroomPro,ComfortPets,PlayPets,VitaPets' | split: ',' -%}
        {%- assign demo_colors = '#E8D5C4,#D4C5E2,#C2DFE3,#C8E6C9,#FFE0B2,#E3E8F0,#FFF3E0,#F3E5F5' | split: ',' -%}

        {%- for name in demo_products -%}
          <div class="bsp__slide" data-index="{{ forloop.index0 }}">
            <div class="bsp__card bsp__card--default" tabindex="0">
              <div class="bsp__card-media">
                <div class="bsp__card-badges" aria-hidden="true">
                  {%- if forloop.index <= 3 -%}
                    <span class="bsp__badge bsp__badge--hot">🔥 Best Seller</span>
                  {%- endif -%}
                </div>
                <button class="bsp__wishlist" aria-label="Add to wishlist" type="button">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <div class="bsp__card-img-link">
                  <div
                    class="bsp__card-img-placeholder"
                    style="background: linear-gradient(135deg, {{ demo_colors[forloop.index0] }}, #f0ece4);"
                    aria-hidden="true"
                  >
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1" opacity="0.25">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                  <div class="bsp__quick-view" aria-hidden="true"><span>Quick View</span></div>
                </div>
                <div class="bsp__atc-panel" aria-hidden="true">
                  <div class="bsp__atc-form">
                    <button type="button" class="bsp__atc-btn">
                      <span class="bsp__atc-btn-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                          <line x1="3" y1="6" x2="21" y2="6"/>
                          <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                      </span>
                      <span class="bsp__atc-btn-text">Add to Cart</span>
                      <span class="bsp__atc-btn-price">{{ demo_prices[forloop.index0] }}</span>
                    </button>
                  </div>
                </div>
              </div>
              <div class="bsp__card-info">
                <span class="bsp__card-vendor">{{ demo_vendors[forloop.index0] }}</span>
                <h3 class="bsp__card-title">
                  <span class="bsp__card-title-link">{{ name }}</span>
                </h3>
                <div class="bsp__card-rating" aria-label="Rating: 4.8 out of 5">
                  <div class="bsp__stars" aria-hidden="true">
                    {%- for i in (1..5) -%}
                      <svg class="bsp__star bsp__star--filled" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                  <span class="bsp__rating-count">({{ forloop.index | times: 23 | plus: 45 }})</span>
                </div>
                <div class="bsp__card-price-row">
                  <span class="bsp__card-price">{{ demo_prices[forloop.index0] }}</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>

    {%- comment %} ── Drag hint overlay ── {% endcomment %}
    <div class="bsp__drag-hint" id="bsp-drag-hint-{{ section.id }}" aria-hidden="true">
      <div class="bsp__drag-hint-inner">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M2 9l3 3-3 3M22 9l-3 3 3 3"/>
        </svg>
        <span>Drag to explore</span>
      </div>
    </div>
  </div>

  {%- comment %} ── Progress Bar ── {% endcomment %}
  <div class="bsp__progress-wrap" aria-hidden="true">
    <div class="bsp__progress-track">
      <div
        class="bsp__progress-fill"
        id="bsp-progress-{{ section.id }}"
      ></div>
    </div>
  </div>

  {%- comment %} ── Dots ── {% endcomment %}
  <div
    class="bsp__dots"
    id="bsp-dots-{{ section.id }}"
    role="tablist"
    aria-label="Product slides"
  >
  </div>

</section>

<style>
/* ════════════════════════════════════════════════
   RESET
════════════════════════════════════════════════ */
#bsp-{{ section.id }},
#bsp-{{ section.id }} * {
  box-sizing: border-box;
}

/* ════════════════════════════════════════════════
   SECTION
════════════════════════════════════════════════ */
#bsp-{{ section.id }} {
  --bsp-radius: 20px;
  --bsp-card-w: clamp(240px, 26vw, 310px);
  --bsp-card-h: clamp(320px, 42vw, 440px);
  --bsp-gap: clamp(14px, 1.8vw, 22px);
  --bsp-pad: clamp(20px, 5vw, 80px);
  --bsp-transition: 0.52s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --bsp-atc-h: 76px;

  position: relative;
  width: 100%;
  padding: clamp(52px, 8vw, 100px) 0 clamp(36px, 5vw, 64px);
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ── BG Decoratives ── */
#bsp-{{ section.id }} .bsp__bg-blob {
  position: absolute;
  border-radius: 9999px;
  filter: blur(80px);
  opacity: 0.22;
  pointer-events: none;
  z-index: 0;
}

#bsp-{{ section.id }} .bsp__bg-blob--1 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, #ffb347, #ffcc02);
  top: -160px; left: -100px;
}

#bsp-{{ section.id }} .bsp__bg-blob--2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, #b3e5fc, #4fc3f7);
  bottom: -100px; right: -80px;
}

/* ════════════════════════════════════════════════
   HEADER
════════════════════════════════════════════════ */
#bsp-{{ section.id }} .bsp__header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  padding: 0 var(--bsp-pad);
  margin-bottom: clamp(28px, 4vw, 48px);
  flex-wrap: wrap;
}

#bsp-{{ section.id }} .bsp__header-left {
  flex: 1;
  min-width: 200px;
}

#bsp-{{ section.id }} .bsp__header-right {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

/* Eyebrow */
#bsp-{{ section.id }} .bsp__eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

#bsp-{{ section.id }} .bsp__eyebrow-pip {
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 9999px;
  background: var(--bsp-accent);
  opacity: 0.8;
}

#bsp-{{ section.id }} .bsp__eyebrow-pip:last-of-type {
  width: 4px;
  height: 4px;
  opacity: 0.4;
}

#bsp-{{ section.id }} .bsp__eyebrow-text {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.20em;
  text-transform: uppercase;
  color: var(--bsp-accent);
}

/* Title */
#bsp-{{ section.id }} .bsp__title {
  font-size: clamp(26px, 3.8vw, 48px);
  font-weight: 850;
  line-height: 1.06;
  letter-spacing: -0.035em;
  color: #1a1a1a;
  margin: 0 0 8px;
}

#bsp-{{ section.id }} .bsp__subtitle {
  font-size: clamp(14px, 1.4vw, 17px);
  color: #7a6e65;
  font-weight: 400;
  line-height: 1.6;
  margin: 0;
}

/* View All link */
#bsp-{{ section.id }} .bsp__view-all {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 14px;
  font-weight: 700;
  color: #3a3530;
  text-decoration: none;
  letter-spacing: 0.02em;
  padding: 10px 20px;
  border-radius: 999px;

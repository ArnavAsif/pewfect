{% comment %}
  ============================================================
  SECTION: Premium Deals / Offer Banner
  Purpose: Flash sale marketing block with countdown timer
  Dependencies: GSAP 3.x + ScrollTrigger (loaded via CDN)
  Author: Premium Pet Shop Theme
  Version: 2.0.0
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id       = 'deals-banner-' | append: section.id
  assign end_date         = section.settings.countdown_end_date
  assign end_time         = section.settings.countdown_end_time
  assign badge_text       = section.settings.badge_text
  assign headline         = section.settings.headline
  assign subtext          = section.settings.subtext
  assign cta_text         = section.settings.cta_text
  assign cta_url          = section.settings.cta_url
  assign product_image    = section.settings.product_image
  assign bg_image         = section.settings.background_image
  assign primary_color    = section.settings.primary_color
  assign accent_color     = section.settings.accent_color
  assign enable_parallax  = section.settings.enable_parallax
  assign enable_badge_glow = section.settings.enable_badge_glow
  assign tag_line         = section.settings.tag_line
-%}

{% comment %} ── Build ISO datetime string for JS ── {% endcomment %}
{%- assign end_datetime = end_date | append: 'T' | append: end_time -%}

<section
  id="{{ section_id }}"
  class="deals-banner{% if enable_parallax %} deals-banner--parallax{% endif %}"
  data-section-id="{{ section.id }}"
  data-end-datetime="{{ end_datetime }}"
  aria-label="{{ headline | escape }} - Limited time offer"
  role="region"
>

  {% comment %} ── Background Layer ── {% endcomment %}
  <div class="deals-banner__bg-wrap" aria-hidden="true">
    {% if bg_image != blank %}
      <div
        class="deals-banner__bg-image"
        style="background-image: url('{{ bg_image | image_url: width: 1800 }}');"
        data-parallax-bg
      ></div>
    {% endif %}
    <div class="deals-banner__bg-overlay"></div>
    <div class="deals-banner__bg-gradient"></div>

    {% comment %} Decorative animated orbs {% endcomment %}
    <div class="deals-banner__orb deals-banner__orb--1" aria-hidden="true"></div>
    <div class="deals-banner__orb deals-banner__orb--2" aria-hidden="true"></div>
    <div class="deals-banner__orb deals-banner__orb--3" aria-hidden="true"></div>
  </div>

  {% comment %} ── Inner Container ── {% endcomment %}
  <div class="deals-banner__container">
    <div class="deals-banner__grid">

      {% comment %} ════════════════════════════════════
        LEFT COLUMN — Offer Content
      ════════════════════════════════════ {% endcomment %}
      <div class="deals-banner__content" data-deals-content>

        {% comment %} Flash Sale Tag {% endcomment %}
        {% if tag_line != blank %}
          <div class="deals-banner__tag" aria-label="Sale type">
            <span class="deals-banner__tag-dot" aria-hidden="true"></span>
            <span>{{ tag_line }}</span>
          </div>
        {% endif %}

        {% comment %} Discount Badge {% endcomment %}
        {% if badge_text != blank %}
          <div
            class="deals-banner__badge{% if enable_badge_glow %} deals-banner__badge--glow{% endif %}"
            data-deals-badge
            aria-label="{{ badge_text }}"
            role="text"
          >
            <div class="deals-banner__badge-inner">
              <span class="deals-banner__badge-text">{{ badge_text }}</span>
            </div>
            {% if enable_badge_glow %}
              <div class="deals-banner__badge-glow-ring" aria-hidden="true"></div>
            {% endif %}
          </div>
        {% endif %}

        {% comment %} Headline {% endcomment %}
        {% if headline != blank %}
          <h2 class="deals-banner__headline" data-deals-headline>
            {{ headline }}
          </h2>
        {% endif %}

        {% comment %} Subtext {% endcomment %}
        {% if subtext != blank %}
          <p class="deals-banner__subtext" data-deals-subtext>
            {{ subtext }}
          </p>
        {% endif %}

        {% comment %} ── Countdown Timer ── {% endcomment %}
        <div
          class="deals-banner__countdown"
          data-deals-countdown
          aria-live="polite"
          aria-label="Countdown to end of offer"
          role="timer"
        >
          <div class="deals-banner__countdown-grid">

            <div class="deals-banner__time-block" data-time-block="days">
              <div class="deals-banner__time-display">
                <span class="deals-banner__time-number" data-time-val="days" aria-label="days">
                  <span class="time-top">00</span>
                  <span class="time-bottom">00</span>
                </span>
              </div>
              <span class="deals-banner__time-label">Days</span>
            </div>

            <div class="deals-banner__time-sep" aria-hidden="true">
              <span></span><span></span>
            </div>

            <div class="deals-banner__time-block" data-time-block="hours">
              <div class="deals-banner__time-display">
                <span class="deals-banner__time-number" data-time-val="hours" aria-label="hours">
                  <span class="time-top">00</span>
                  <span class="time-bottom">00</span>
                </span>
              </div>
              <span class="deals-banner__time-label">Hours</span>
            </div>

            <div class="deals-banner__time-sep" aria-hidden="true">
              <span></span><span></span>
            </div>

            <div class="deals-banner__time-block" data-time-block="minutes">
              <div class="deals-banner__time-display">
                <span class="deals-banner__time-number" data-time-val="minutes" aria-label="minutes">
                  <span class="time-top">00</span>
                  <span class="time-bottom">00</span>
                </span>
              </div>
              <span class="deals-banner__time-label">Mins</span>
            </div>

            <div class="deals-banner__time-sep" aria-hidden="true">
              <span></span><span></span>
            </div>

            <div class="deals-banner__time-block" data-time-block="seconds">
              <div class="deals-banner__time-display">
                <span class="deals-banner__time-number" data-time-val="seconds" aria-label="seconds">
                  <span class="time-top">00</span>
                  <span class="time-bottom">00</span>
                </span>
              </div>
              <span class="deals-banner__time-label">Secs</span>
            </div>

          </div>{% comment %} /.countdown-grid {% endcomment %}
        </div>{% comment %} /.countdown {% endcomment %}

        {% comment %} ── CTA Button ── {% endcomment %}
        {% if cta_text != blank %}
          <div class="deals-banner__cta-wrap" data-deals-cta>
            <a
              href="{{ cta_url | default: '#' }}"
              class="deals-banner__cta-btn"
              aria-label="{{ cta_text | escape }} - {{ headline | escape }}"
              role="button"
            >
              <span class="deals-banner__cta-btn-text">{{ cta_text }}</span>
              <span class="deals-banner__cta-btn-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="deals-banner__cta-btn-glow" aria-hidden="true"></span>
            </a>

            {% if section.settings.secondary_cta_text != blank %}
              <a
                href="{{ section.settings.secondary_cta_url | default: '#' }}"
                class="deals-banner__secondary-cta"
                aria-label="{{ section.settings.secondary_cta_text | escape }}"
              >
                {{ section.settings.secondary_cta_text }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% comment %} Trust badges {% endcomment %}
        <div class="deals-banner__trust" data-deals-trust aria-label="Trust indicators">
          <div class="deals-banner__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Free Shipping</span>
          </div>
          <div class="deals-banner__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Vet Approved</span>
          </div>
          <div class="deals-banner__trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>30-Day Returns</span>
          </div>
        </div>

      </div>{% comment %} /.deals-banner__content {% endcomment %}

      {% comment %} ════════════════════════════════════
        RIGHT COLUMN — Product / Pet Image
      ════════════════════════════════════ {% endcomment %}
      <div class="deals-banner__image-col" data-deals-image aria-hidden="true">

        <div class="deals-banner__image-frame">

          {% comment %} Decorative rings {% endcomment %}
          <div class="deals-banner__image-ring deals-banner__image-ring--outer" aria-hidden="true"></div>
          <div class="deals-banner__image-ring deals-banner__image-ring--inner" aria-hidden="true"></div>

          {% if product_image != blank %}
            <div class="deals-banner__product-image">
              {{
                product_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '(max-width: 768px) 90vw, 45vw',
                  alt: headline,
                  class: 'deals-banner__img'
              }}
            </div>
          {% else %}
            {% comment %} Placeholder SVG {% endcomment %}
            <div class="deals-banner__product-image deals-banner__product-image--placeholder">
              <div class="deals-banner__placeholder-icon">
                🐾
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="100" cy="110" r="55" fill="rgba(255,255,255,0.08)"/>
                  <circle cx="75"  cy="65"  r="18" fill="rgba(255,255,255,0.12)"/>
                  <circle cx="125" cy="65"  r="18" fill="rgba(255,255,255,0.12)"/>
                  <circle cx="52"  cy="90"  r="14" fill="rgba(255,255,255,0.10)"/>
                  <circle cx="148" cy="90"  r="14" fill="rgba(255,255,255,0.10)"/>
                  <text x="100" y="125" text-anchor="middle" font-size="52" fill="rgba(255,255,255,0.6)">🐶</text>
                </svg>
              </div>
            </div>
          {% endif %}

          {% comment %} Floating deal card {% endcomment %}
          <div class="deals-banner__float-card deals-banner__float-card--top" aria-hidden="true">
            <div class="deals-banner__float-card-icon">⚡</div>
            <div class="deals-banner__float-card-text">
              <span class="deals-banner__float-card-label">Flash Deal</span>
              <span class="deals-banner__float-card-value">Ends Soon!</span>
            </div>
          </div>

          <div class="deals-banner__float-card deals-banner__float-card--bottom" aria-hidden="true">
            <div class="deals-banner__float-card-stars" aria-label="5 stars rating">
              ★★★★★
            </div>
            <div class="deals-banner__float-card-review">2.4k+ Happy Pet Parents</div>
          </div>

        </div>{% comment %} /.image-frame {% endcomment %}
      </div>{% comment %} /.image-col {% endcomment %}

    </div>{% comment %} /.grid {% endcomment %}
  </div>{% comment %} /.container {% endcomment %}

  {% comment %} ── Expired Overlay ── {% endcomment %}
  <div class="deals-banner__expired" data-deals-expired style="display:none;" role="alert" aria-live="assertive">
    <div class="deals-banner__expired-content">
      <span class="deals-banner__expired-icon" aria-hidden="true">🕐</span>
      <h3>This Offer Has Ended</h3>
      <p>Check out our latest deals!</p>
      <a href="/collections/all" class="deals-banner__cta-btn" aria-label="Browse all products">
        <span class="deals-banner__cta-btn-text">Browse Deals</span>
      </a>
    </div>
  </div>

</section>{% comment %} /#section_id {% endcomment %}


{% comment %} ══════════════════════════════════════════════════════════════
  STYLES
══════════════════════════════════════════════════════════════ {% endcomment %}
<style>
/* ─────────────────────────────────────────────────────────────
   CSS Custom Properties
───────────────────────────────────────────────────────────── */
#{{ section_id }} {
  --db-primary:        {{ primary_color | default: '#FF4D4D' }};
  --db-primary-end:    {{ accent_color  | default: '#FF8A00' }};
  --db-white:          #FFFFFF;
  --db-cream:          #FFF9F0;
  --db-dark:           #0D0D0D;
  --db-card-bg:        rgba(255, 255, 255, 0.07);
  --db-card-border:    rgba(255, 255, 255, 0.15);
  --db-radius:         24px;
  --db-radius-sm:      12px;
  --db-radius-xs:      8px;
  --db-transition:     0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  --db-glow-color:     rgba(255, 77, 77, 0.45);
  --db-section-pad:    clamp(60px, 8vw, 110px);
}

/* ─────────────────────────────────────────────────────────────
   Base Section
───────────────────────────────────────────────────────────── */
#{{ section_id }} {
  position: relative;
  overflow: hidden;
  padding: var(--db-section-pad) 0;
  min-height: 580px;
  display: flex;
  align-items: center;
  background: #0f0f1a;
  isolation: isolate;
}

/* ─────────────────────────────────────────────────────────────
   Background Layers
───────────────────────────────────────────────────────────── */
.deals-banner__bg-wrap {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.deals-banner__bg-image {
  position: absolute;
  inset: -10%;
  background-size: cover;
  background-position: center;
  filter: blur(2px) saturate(0.6);
  transform: scale(1.12);
  will-change: transform;
  transition: transform 0.1s linear;
}

.deals-banner__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(13, 13, 26, 0.94) 0%,
    rgba(13, 13, 26, 0.82) 50%,
    rgba(13, 13, 26, 0.70) 100%
  );
}

.deals-banner__bg-gradient {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 20% 50%, rgba(255, 77, 77, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 80% 50%, rgba(255, 138, 0,  0.10) 0%, transparent 70%);
}

/* Animated orbs */
.deals-banner__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
  animation: orbFloat 8s ease-in-out infinite;
}
.deals-banner__orb--1 {
  width: 400px;
  height: 400px;
  top: -100px;
  left: -80px;
  background: radial-gradient(circle, rgba(255, 77, 77, 0.18), transparent 70%);
  animation-delay: 0s;
}
.deals-banner__orb--2 {
  width: 300px;
  height: 300px;
  bottom: -80px;
  left: 30%;
  background: radial-gradient(circle, rgba(255, 138, 0, 0.14), transparent 70%);
  animation-delay: -3s;
}
.deals-banner__orb--3 {
  width: 350px;
  height: 350px;
  top: 50%;
  right: -60px;
  background: radial-gradient(circle, rgba(255, 77, 77, 0.12), transparent 70%);
  animation-delay: -6s;
}
@keyframes orbFloat {
  0%, 100% { transform: translateY(0px) scale(1);   }
  33%       { transform: translateY(-24px) scale(1.05); }
  66%       { transform: translateY(14px) scale(0.96);  }
}

/* ─────────────────────────────────────────────────────────────
   Container & Grid
───────────────────────────────────────────────────────────── */
.deals-banner__container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 clamp(20px, 5vw, 60px);
}

.deals-banner__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 5vw, 80px);
  align-items: center;
}

/* ─────────────────────────────────────────────────────────────
   LEFT: Content Column
───────────────────────────────────────────────────────────── */
.deals-banner__content {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Flash Sale Tag */
.deals-banner__tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 77, 77, 0.15);
  border: 1px solid rgba(255, 77, 77, 0.35);
  color: #FF8A8A;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 7px 16px;
  border-radius: 100px;
  margin-bottom: 20px;
  width: fit-content;
  backdrop-filter: blur(8px);
}
.deals-banner__tag-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #FF4D4D;
  box-shadow: 0 0 8px #FF4D4D;
  animation: tagPulse 1.4s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes tagPulse {
  0%, 100% { opacity: 1; transform: scale(1);    box-shadow: 0 0 8px  #FF4D4D; }
  50%       { opacity: 0.7; transform: scale(1.3); box-shadow: 0 0 16px #FF4D4D; }
}

/* Discount Badge */
.deals-banner__badge {
  position: relative;
  width: fit-content;
  margin-bottom: 22px;
  cursor: default;
}
.deals-banner__badge-inner {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, var(--db-primary), var(--db-primary-end));
  border-radius: 16px;
  padding: 14px 28px;
  clip-path: polygon(0 0, 96% 0, 100% 50%, 96% 100%, 0 100%, 4% 50%);
}
.deals-banner__badge-text {
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  font-weight: 900;
  color: #fff;
  letter-spacing: -0.01em;
  line-height: 1;
  text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  display: block;
  white-space: nowrap;
}

/* Badge glow */
.deals-banner__badge--glow .deals-banner__badge-inner {
  box-shadow:
    0 0 30px rgba(255, 77, 77, 0.55),
    0 0 60px rgba(255, 138, 0, 0.25),
    0 8px 32px rgba(255, 77, 77, 0.40);
}
.deals-banner__badge-glow-ring {
  position: absolute;
  inset: -8px;
  border-radius: 24px;
  border: 2px solid rgba(255, 77, 77, 0.45);
  animation: glowRingPulse 2s ease-in-out infinite;
  z-index: 0;
}
@keyframes glowRingPulse {
  0%, 100% { opacity: 0.6; transform: scale(1);    box-shadow: 0 0 20px rgba(255,77,77,0.3);  }
  50%       { opacity: 1;   transform: scale(1.04); box-shadow: 0 0 40px rgba(255,77,77,0.55); }
}

/* Headline */
.deals-banner__headline {
  font-size: clamp(1.9rem, 3.8vw, 3.2rem);
  font-weight: 800;
  color: var(--db-white);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 14px;
  text-wrap: balance;
}

/* Subtext */
.deals-banner__subtext {
  font-size: clamp(0.95rem, 1.5vw, 1.15rem);
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.65;
  margin: 0 0 32px;
  max-width: 460px;
  font-weight: 400;
}

/* ─────────────────────────────────────────────────────────────
   Countdown Timer
───────────────────────────────────────────────────────────── */
.deals-banner__countdown {
  margin-bottom: 32px;
}

.deals-banner__countdown-grid {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
}

.deals-banner__time-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.deals-banner__time-display {
  position: relative;
  width: clamp(62px, 9vw, 84px);
  height: clamp(62px, 9vw, 84px);
  background: var(--db-card-bg);
  border: 1px solid var(--db-card-border);
  border-radius: var(--db-radius-sm);
  backdrop-filter: blur(12px);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Inner shine line */
.deals-banner__time-display::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(255,255,255,0.10) 0%,
    rgba(255,255,255,0.03) 48%,
    rgba(0,0,0,0.08) 50%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* Horizontal divider line (flip clock feel) */
.deals-banner__time-display::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1px;
  background: rgba(255, 255, 255, 0.12);
  z-index: 3;
}

.deals-banner__time-number {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  position: relative;
  font-size: clamp(1.4rem, 2.8vw, 2rem);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--db-white);
  letter-spacing: -0.01em;
  line-height: 1;
}

.deals-banner__time-number .time-top,
.deals-banner__time-number .time-bottom {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
}

.deals-banner__time-number .time-top {
  top: 50%;
  transform: translateY(-50%);
}
.deals-banner__time-number .time-bottom {
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
}

.deals-banner__time-label {
  font-size: 0.68rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.50);
  letter-spacing: 0.10em;
  text-transform: uppercase;
}

/* Separator dots */
.deals-banner__time-sep {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 22px;
  flex-shrink: 0;
}
.deals-banner__time-sep span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--db-primary);
  box-shadow: 0 0 8px var(--db-primary);
  animation: sepBlink 1s step-end infinite;
}
.deals-banner__time-sep span:last-child { animation-delay: 0.5s; }
@keyframes sepBlink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.2; }
}

/* Urgent countdown state */
.deals-banner__countdown--urgent .deals-banner__time-display {
  border-color: rgba(255, 77, 77, 0.60);
  box-shadow: 0 0 16px rgba(255, 77, 77, 0.30);
  animation: urgentPulse 0.8s ease-in-out infinite;
}
@keyframes urgentPulse {
  0%, 100% { box-shadow: 0 0 12px rgba(255,77,77,0.25); }
  50%       { box-shadow: 0 0 28px rgba(255,77,77,0.60); }
}

/* ─────────────────────────────────────────────────────────────
   CTA Button
───────────────────────────────────────────────────────────── */
.deals-banner__cta-wrap {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}

.deals-banner__cta-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 36px;
  background: linear-gradient(135deg, var(--db-primary), var(--db-primary-end));
  color: #fff;
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 100px;
  border: none;
  cursor: pointer;
  overflow: hidden;
  transition:
    transform 0.25s var(--db-transition),
    box-shadow 0.25s ease;
  box-shadow:
    0 8px 24px rgba(255, 77, 77, 0.40),
    0 2px 8px rgba(0,0,0,0.20);
  white-space: nowrap;
}

.deals-banner__cta-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: inherit;
}

.deals-banner__cta-btn-text {
  position: relative;
  z-index: 1;
}

.deals-banner__cta-btn-icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
}

.deals-banner__cta-btn-glow {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--db-primary), var(--db-primary-end));
  filter: blur(18px);
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: -1;
}

/* CTA Hover */
.deals-banner__cta-btn:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow:
    0 16px 40px rgba(255, 77, 77, 0.55),
    0 4px 16px rgba(0,0,0,0.25);
}
.deals-banner__cta-btn:hover::before        { opacity: 1; }
.deals-banner__cta-btn:hover .deals-banner__cta-btn-icon  { transform: translateX(4px); }
.deals-banner__cta-btn:hover .deals-banner__cta-btn-glow  { opacity: 0.6; }

.deals-banner__cta-btn:active {
  transform: translateY(0) scale(0.98);
}

/* Secondary CTA */
.deals-banner__secondary-cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.65);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.25);
  padding-bottom: 2px;
  transition: color 0.25s ease, border-color 0.25s ease;
}
.deals-banner__secondary-cta:hover {
  color: #fff;
  border-color: rgba(255,255,255,0.7);
}

/* ─────────────────────────────────────────────────────────────
   Trust Badges
───────────────────────────────────────────────────────────── */
.deals-banner__trust {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}
.deals-banner__trust-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.55);
  font-size: 0.80rem;
  font-weight: 500;
}
.deals-banner__trust-item svg {
  color: rgba(255, 138, 0, 0.85);
  flex-shrink: 0;
}

/* ─────────────────────────────────────────────────────────────
   RIGHT: Image Column
───────────────────────────────────────────────────────────── */
.deals-banner__image-col {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.deals-banner__image-frame {
  position: relative;
  width: 100%;
  max-width: 480px;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Decorative rings */
.deals-banner__image-ring {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
  pointer-events: none;
  animation: ringRotate 20s linear infinite;
}
.deals-banner__image-ring--outer {
  inset: -20px;
  border-width: 1.5px;
  border-color: rgba(255, 77, 77, 0.20) rgba(255,138,0,0.15) transparent transparent;
}
.deals-banner__image-ring--inner {
  inset: -6px;
  border-width: 1px;
  border-color: transparent rgba(255,255,255,0.10) rgba(255,77,77,0.15) transparent;
  animation-direction: reverse;
  animation-duration: 14s;
}
@keyframes ringRotate {
  from { transform: rotate(0deg);   }
  to   { transform: rotate(360deg); }
}

/* Product image container */
.deals-banner__product-image {
  position: relative;
  width: 90%;
  height: 90%;
  border-radius: 50%;
  overflow: hidden;
  background: radial-gradient(circle, rgba(255,77,77,0.12), rgba(13,13,26,0.50));
  border: 1px solid rgba(255,255,255,0.10);
  box-shadow:
    0 0 60px rgba(255, 77, 77, 0.18),
    0 30px 80px rgba(0,0,0,0.45),
    inset 0 1px 0 rgba(255,255,255,0.08);
}

.deals-banner__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.6s ease;
}
.deals-banner__image-frame:hover .deals-banner__img {
  transform: scale(1.05);
}

/* Placeholder */
.deals-banner__product-image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.deals-banner__placeholder-icon {
  font-size: 5rem;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: 0.7;
}
.deals-banner__placeholder-icon svg {
  width: 140px;
  height: 140px;
}

/* Floating cards */
.deals-banner__float-card {
  position: absolute;
  background: rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: var(--db-radius-sm);
  padding: 10px 16px;
  z-index: 10;
  white-space: nowrap;
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
}

.deals-banner__float-card--top {
  top: 8%;
  right: -8%;
  display: flex;
  align-items: center;
  gap: 10px;
  animation: floatCardTop 4s ease-in-out infinite;
}
.deals-banner__float-card--bottom {
  bottom: 10%;
  left: -8%;
  text-align: center;
  animation: floatCardBottom 4.5s ease-in-out infinite;
  animation-delay: -2s;
}

@keyframes floatCardTop {
  0%, 100% { transform: translateY(0px);  }
  50%       { transform: translateY(-8px); }
}
@keyframes floatCardBottom {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(8px); }
}

.deals-banner__float-card-icon {
  font-size: 1.4rem;
  line-height: 1;
}
.deals-banner__float-card-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.deals-banner__float-card-label {
  font-size: 0.70rem;
  color: rgba(255,255,255,0.55);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
}
.deals-banner__float-card-value {
  font-size: 0.88rem;
  color: #fff;
  font-weight: 700;
  display: block;
}
.deals-banner__float-card-stars {
  color: #FFB800;
  font-size: 0.85rem;
  letter-spacing: 1px;
  line-height: 1;
}
.deals-banner__float-card-review {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.75);
  font-weight: 600;
  margin-top: 4px;
}

/* ─────────────────────────────────────────────────────────────
   Expired Overlay
───────────────────────────────────────────────────────────── */
.deals-banner__expired {
  position: absolute;
  inset: 0;
  z-index: 20;
  background: rgba(13, 13, 26, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}
.deals-banner__expired-content {
  text-align: center;
  color: #fff;
  padding: 40px;
}
.deals-banner__expired-icon {
  font-size: 4rem;
  display: block;
  margin-bottom: 16px;
}
.deals-banner__expired-content h3 {
  font-size: 2rem;
  font-weight: 800;
  margin: 0 0 8px;
}
.deals-banner__expired-content p {
  color: rgba(255,255,255,0.65);
  margin: 0 0 24px;
}

/* ─────────────────────────────────────────────────────────────
   Reduced Motion
───────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .deals-banner__orb,
  .deals-banner__tag-dot,
  .deals-banner__badge-glow-ring,
  .deals-banner__time-sep span,
  .deals-banner__image-ring,
  .deals-banner__float-card--top,
  .deals-banner__float-card--bottom {
    animation: none !important;
  }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — Tablet
───────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .deals-banner__grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .deals-banner__float-card--top    { right: -4%; }
  .deals-banner__float-card--bottom { left:  -4%; }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — Mobile
───────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  #{{ section_id }} {
    padding: 56px 0;
    min-height: auto;
  }

  .deals-banner__grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  /* Image column goes first on mobile */
  .deals-banner__image-col {
    order: -1;
    max-width: 340px;
    margin: 0 auto;
    width: 100%;
  }

  .deals-banner__content {
    align-items: center;
    text-align: center;
  }

  .deals-banner__headline,
  .deals-banner__subtext {
    text-align: center;
    max-width: 100%;
  }

  .deals-banner__badge-inner {
    clip-path: none;
    border-radius: 14px;
    padding: 12px 24px;
  }

  .deals-banner__countdown-grid {
    justify-content: center;
  }

  .deals-banner__time-display {
    width: 68px;
    height: 68px;
  }

  .deals-banner__cta-wrap {
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .deals-banner__cta-btn {
    width: 100%;
    justify-content: center;
    padding: 18px 36px;
    font-size: 1.05rem;
  }

  .deals-banner__trust {
    justify-content: center;
  }

  .deals-banner__float-card--top {
    top: -14px;
    right: 0;
  }
  .deals-banner__float-card--bottom {
    bottom: -14px;
    left: 0;
  }
}

@media (max-width: 480px) {
  .deals-banner__time-display {
    width: 58px;
    height: 58px;
  }
  .deals-banner__time-sep { gap: 5px; }
  .deals-banner__countdown-grid { gap: 5px; }

  .deals-banner__float-card {
    display: none; /* hide on very small screens */
  }
}
</style>


{% comment %} ══════════════════════════════════════════════════════════════
  SCRIPTS — GSAP + Countdown Timer
══════════════════════════════════════════════════════════════ {% endcomment %}

{% comment %} Load GSAP from CDN (only once per page) {% endcomment %}
<script>
(function() {
  if (window.__gsapLoaded) return;
  window.__gsapLoaded = true;

  function loadScript(src, cb) {
    const s = document.createElement('script');
    s.src = src;
    s.defer = true;
    s.onload = cb;
    document.head.appendChild(s);
  }

  const GSAP_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
  const ST_CDN   = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';

  loadScript(GSAP_CDN, function() {
    loadScript(ST_CDN, function() {
      window.__gsapReady = true;
      document.dispatchEvent(new CustomEvent('gsap:ready'));
    });
  });
})();
</script>

<script>
(function() {
  'use strict';

  /* ── Helpers ─────────────────────────────────────────── */
  const pad     = (n) => String(Math.max(0, n)).padStart(2, '0');
  const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Section reference ───────────────────────────────── */
  const section = document.getElementById('{{ section_id }}');
  if (!section) return;

  /* ── Countdown state ─────────────────────────────────── */
  const endDateRaw  = section.dataset.endDatetime;
  const endTime     = endDateRaw ? new Date(endDateRaw).getTime() : null;

  let   prevValues  = { days: -1, hours: -1, minutes: -1, seconds: -1 };
  let   timerRAF    = null;
  let   gsapCtx     = null;

  /* ── DOM refs ────────────────────────────────────────── */
  const dom = {
    badge:     section.querySelector('[data-deals-badge]'),
    headline:  section.querySelector('[data-deals-headline]'),
    subtext:   section.querySelector('[data-deals-subtext]'),
    cta:       section.querySelector('[data-deals-cta]'),
    trust:     section.querySelector('[data-deals-trust]'),
    countdown: section.querySelector('[data-deals-countdown]'),
    image:     section.querySelector('[data-deals-image]'),
    bgImg:     section.querySelector('[data-parallax-bg]'),
    expired:   section.querySelector('[data-deals-expired]'),
    ctaBtn:    section.querySelector('.deals-banner__cta-btn'),
    tag:       section.querySelector('.deals-banner__tag'),
  };

  /* ═══════════════════════════════════════════════════════
     COUNTDOWN ENGINE
  ═══════════════════════════════════════════════════════ */
  function getTimeLeft() {
    if (!endTime) return null;
    const diff = endTime - Date.now();
    if (diff <= 0) return null;
    return {
      days:    Math.floor(diff / 86400000),
      hours:   Math.floor((diff % 86400000) / 3600000),
      minutes: Math.floor((diff % 3600000)  / 60000),
      seconds: Math.floor((diff % 60000)    / 1000),
      diff,
    };
  }

  function flipNumber(el, newVal) {
    if (!el) return;
    const topEl    = el.querySelector('.time-top');
    const bottomEl = el.querySelector('.time-bottom');
    if (!topEl || !bottomEl) return;

    /* Populate bottom layer with new value */
    bottomEl.textContent = newVal;

    if (prefersReducedMotion() || !window.gsap) {
      topEl.textContent = newVal;
      return;
    }

    /* Quick flip animation */
    gsap.timeline()
      .to(topEl,    { duration: 0.18, y: '-60%', opacity: 0, ease: 'power2.in' })
      .fromTo(bottomEl,
        { y: '60%', opacity: 0 },
        { duration: 0.18, y: '0%', opacity: 1, ease: 'power2.out' }
      )
      .call(() => {
        topEl.textContent = newVal;
        topEl.style.cssText = '';
        bottomEl.style.cssText = '';
        bottomEl.style.opacity = '0';
      });
  }

  function updateTimeBlock(key, value) {
    const padded = pad(value);
    if (prevValues[key] === padded) return;
    prevValues[key] = padded;
    const el = section.querySelector(`[data-time-val="${key}"]`);
    if (el) flipNumber(el, padded);
  }

  function setUrgentMode(isUrgent) {
    dom.countdown && dom.countdown.classList.toggle(
      'deals-banner__countdown--urgent', isUrgent
    );
  }

  function showExpired() {
    if (dom.expired) {
      dom.expired.style.display = 'flex';
      if (window.gsap && !prefersReducedMotion()) {
        gsap.fromTo(dom.expired,
          { opacity: 0 },
          { opacity: 1, duration: 0.6, ease: 'power2.out' }
        );
      }
    }
    /* Zero out all blocks */
    ['days','hours','minutes','seconds'].forEach(k => {
      const el = section.querySelector(`[data-time-val="${k}"]`);
      if (el) {
        const t = el.querySelector('.time-top');
        if (t) t.textContent = '00';
      }
    });
  }

  function tickCountdown() {
    const t = getTimeLeft();

    if (!t) {
      showExpired();
      return;
    }

    updateTimeBlock('days',    t.days);
    updateTimeBlock('hours',   t.hours);
    updateTimeBlock('minutes', t.minutes);
    updateTimeBlock('seconds', t.seconds);

    /* Urgent when < 1 hour */
    setUrgentMode(t.diff < 3600000);

    timerRAF = setTimeout(tickCountdown, 1000);
  }

  /* ═══════════════════════════════════════════════════════
     GSAP ANIMATIONS
  ═══════════════════════════════════════════════════════ */
  function initAnimations() {
    if (!window.gsap || prefersReducedMotion()) {
      /* Fallback: just show everything */
      [dom.tag, dom.badge, dom.headline, dom.subtext,
       dom.countdown, dom.cta, dom.trust, dom.image].forEach(el => {
        if (el) el.style.opacity = '1';
      });
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    gsapCtx = gsap.context(() => {

      /* ── 1. Initial hide ──────────────────────────────── */
      gsap.set([dom.tag, dom.badge, dom.headline, dom.subtext,
                dom.countdown, dom.cta, dom.trust],
        { opacity: 0, x: -40 }
      );
      if (dom.image) gsap.set(dom.image, { opacity: 0, x: 40, scale: 0.9 });

      /* ── 2. Entrance timeline ─────────────────────────── */
      const entranceTL = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          once: true,
        },
        defaults: { ease: 'power3.out' },
      });

      if (dom.tag) {
        entranceTL.to(dom.tag, {
          opacity: 1, x: 0, duration: 0.5,
        });
      }

      if (dom.badge) {
        entranceTL.to(dom.badge, {
          opacity: 1, x: 0, duration: 0.6,
          scale: { from: 0.6, to: 1 },
          ease: 'back.out(1.8)',
        }, '-=0.25');
      }

      if (dom.headline) {
        entranceTL.to(dom.headline, {
          opacity: 1, x: 0, duration: 0.6,
        }, '-=0.35');
      }

      if (dom.subtext) {
        entranceTL.to(dom.subtext, {
          opacity: 1, x: 0, duration: 0.55,
        }, '-=0.35');
      }

      if (dom.countdown) {
        entranceTL.to(dom.countdown, {
          opacity: 1, x: 0, duration: 0.6,
        }, '-=0.3');
      }

      if (dom.cta) {
        entranceTL.to(dom.cta, {
          opacity: 1, x: 0, duration: 0.7,
          ease: 'back.out(2)',
        }, '-=0.35');
      }

      if (dom.trust) {
        entranceTL.to(dom.trust, {
          opacity: 1, x: 0, duration: 0.5,
        }, '-=0.35');
      }

      if (dom.image) {
        entranceTL.to(dom.image, {
          opacity: 1, x: 0, scale: 1, duration: 0.85,
          ease: 'back.out(1.4)',
        }, '<0.1');
      }

      /* ── 3. CTA breathing loop ────────────────────────── */
      if (dom.ctaBtn && !isMobile()) {
        gsap.to(dom.ctaBtn, {
          scale: 1.03,
          duration: 1.8,
          ease: 'sine.inOut',
          yoyo: true,
          repeat: -1,
        });
      }

      /* ── 4. Parallax scroll ───────────────────────────── */
      if (dom.bgImg && {{ enable_parallax }}) {
        gsap.to(dom.bgImg, {
          yPercent: isMobile() ? 0 : 18,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.5,
          },
        });
      }

      /* ── 5. Section subtle scale on scroll ───────────── */
      if (!isMobile()) {
        gsap.fromTo(section,
          { '--section-scale': '1' },
          {
            scrollTrigger: {
              trigger: section,
              start: 'top 75%',
              end: 'top 20%',
              scrub: true,
            },
            ease: 'none',
          }
        );
      }

    }, section); /* scope to section */
  }

  /* ═══════════════════════════════════════════════════════
     INIT
  ═══════════════════════════════════════════════════════ */
  function init() {
    tickCountdown();
    initAnimations();
  }

  if (window.__gsapReady) {
    init();
  } else {
    document.addEventListener('gsap:ready', init, { once: true });
    /* Also attempt init if GSAP was already loaded before */
    window.addEventListener('load', function() {
      if (!gsapCtx) initAnimations();
    }, { once: true });
    /* Kick off countdown immediately regardless */
    tickCountdown();
  }

  /* ── Cleanup on section removal (theme editor) ──────── */
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      clearTimeout(timerRAF);
      if (gsapCtx) gsapCtx.revert();
    }
  });

})();
</script>



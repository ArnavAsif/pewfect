{% schema %}
{
  "name": "🔥 Deals / Offer Banner",
  "tag": "section",
  "class": "section-deals-banner",
  "settings": [
    {
      "type": "header",
      "content": "⚡ Offer Content"
    },
    {
      "type": "text",
      "id": "tag_line",
      "label": "Flash Sale Tag",
      "default": "⚡ Flash Sale — Limited Time Only"
    },
    {

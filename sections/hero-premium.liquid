    animation: none !important;
    transition: none !important;
  }
  .hero__eyebrow,
  .hero__word,
  .hero__sub,
  .hero__pills,
  .hero__ctas,
  .hero__proof {
    opacity:   1 !important;
    transform: none !important;
  }
  .hero__accent-line-fill { width:100% !important; }
  .hero__stat     { opacity:1 !important; }
  .hero__paw-badge{ opacity:1 !important; }
  .hero__new-badge{ opacity:1 !important; }
}
</style>


{%- comment %} ══════════════════════════════════════════════════════════
   JAVASCRIPT  —  GSAP cinematic load + scroll
══════════════════════════════════════════════════════════ {% endcomment %}

<script>
/* ── Load GSAP + ScrollTrigger once per page ─────────────── */
(function () {
  if (window.__heroGsap) return;
  window.__heroGsap = 'loading';
  const G = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
  const S = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
  function load(src, cb) {
    const el = document.createElement('script');
    el.src = src; el.defer = true; el.onload = cb;
    document.head.appendChild(el);
  }
  load(G, () => load(S, () => {
    window.__heroGsap = 'ready';
    document.dispatchEvent(new CustomEvent('hero:gsap-ready'));
  }));
}());
</script>

<script>
(function () {
  'use strict';

  const sid    = '{{ sid }}';
  const noMo   = () => window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  const mobile = () => window.matchMedia('(max-width:767px)').matches;
  const S      = (sel, ctx) => (ctx || document).querySelector(sel);
  const SA     = (sel, ctx) => [...(ctx || document).querySelectorAll(sel)];

  const hero = document.getElementById(sid);
  if (!hero) return;

  /* ── DOM refs ─────────────────────────────────────────── */
  const eyebrow   = S('[data-hero-eyebrow]',   hero);
  const words     = SA('.hero__word',           hero);
  const acLine    = S('.hero__accent-line-fill',hero);
  const sub       = S('[data-hero-sub]',        hero);
  const pills     = S('[data-hero-pills]',      hero);
  const cta       = S('[data-hero-cta]',        hero);
  const proof     = S('[data-hero-proof]',      hero);
  const imgFrame  = S('[data-hero-img-frame]',  hero);
  const heroImgs  = SA('[data-hero-img]',       hero);
  const stats     = SA('[data-hero-float]',     hero);
  const pawBadge  = S('[data-hero-paw]',        hero);
  const badge     = S('[data-hero-badge]',      hero);
  const visual    = S('[data-hero-visual]',     hero);
  const mobileCta = S('[data-hero-mobile-cta]', document);

  let ctx = null;

  /* ══════════════════════════════════════════════════════
     REDUCED MOTION FALLBACK
  ══════════════════════════════════════════════════════ */
  function revealAll() {
    const els = [eyebrow, sub, pills, cta, proof, badge];
    els.forEach(el => {
      if (!el) return;
      el.style.opacity   = '1';
      el.style.transform = 'none';
    });
    words.forEach(w => { w.style.opacity = '1'; w.style.transform = 'none'; });
    stats.forEach(s => {
      s.style.opacity = '1';
      s.classList.add('is-floating');
    });
    if (pawBadge) {
      pawBadge.style.opacity   = '1';
      pawBadge.style.transform = 'none';
      pawBadge.classList.add('is-spinning');
    }
    if (acLine) acLine.style.width = '100%';
  }

  /* ══════════════════════════════════════════════════════
     MAIN ANIMATION
  ══════════════════════════════════════════════════════ */
  function initAnimations() {
    if (!window.gsap) { revealAll(); return; }
    if (noMo())       { revealAll(); return; }

    gsap.registerPlugin(ScrollTrigger);

    ctx = gsap.context(() => {

      /* ─── 1. SET INITIAL STATES ─────────────────────────
         BUG FIX: gsap.set() BEFORE gsap.to/fromTo to guarantee
         start values are applied before animation begins.
      ─────────────────────────────────────────────────── */
      if (pawBadge) {
        gsap.set(pawBadge, { scale: 0.4, opacity: 0 }); /* ← was set AFTER gsap.to — now correct */
      }
      if (badge) {
        gsap.set(badge, { scale: 0.7, opacity: 0, y: -10 });
      }

      /* ─── 2. ENTRANCE TIMELINE ──────────────────────── */
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      if (eyebrow) {
        tl.fromTo(eyebrow,
          { opacity: 0, y: -12 },
          { opacity: 1, y:  0, duration: 0.65 },
          0.05
        );
      }

      if (words.length) {
        tl.to(words, {
          opacity:  1,
          y:        '0%',
          duration: 0.65,
          stagger: { each: 0.07, ease: 'power2.out' },
          ease:    'power3.out',
        }, eyebrow ? 0.28 : 0.12);
      }

      if (acLine) {
        tl.to(acLine, {
          width:    '100%',
          duration: 0.72,
          ease:     'power2.inOut',
        }, '-=0.30');
      }

      if (sub) {
        tl.to(sub, { opacity: 1, y: 0, duration: 0.60 }, '-=0.42');
      }

      if (pills) {
        tl.to(pills, { opacity: 1, y: 0, duration: 0.50 }, '-=0.38');
      }

      if (cta) {
        tl.to(cta, {
          opacity: 1, y: 0, scale: 1,
          duration: 0.65,
          ease:     'back.out(1.6)',
        }, '-=0.40');
      }

      if (proof) {
        tl.to(proof, { opacity: 1, y: 0, duration: 0.50 }, '-=0.35');
      }

      /* Image frame */
      if (imgFrame) {
        gsap.fromTo(imgFrame,
          { opacity: 0, scale: 0.88, y: 36 },
          { opacity: 1, scale: 1,    y: 0,
            duration: 1.25, delay: 0.10, ease: 'power3.out' }
        );
      }

      /* Stat cards — staggered with floating applied after */
      if (stats.length) {
        gsap.fromTo(stats,
          { opacity: 0, y: 20, scale: 0.90 },
          {
            opacity:  1,
            y:        0,
            scale:    1,
            duration: 0.60,
            stagger:  0.18,
            delay:    0.85,
            ease:     'back.out(1.4)',
            onComplete() {
              /* Add CSS float animation AFTER GSAP entrance is done */
              stats.forEach(s => s.classList.add('is-floating'));
            },
          }
        );
      }

      /* Paw badge
         BUG FIX: gsap.set was after gsap.to in original.
         Now initial state is set above; here we only animate TO final state.
         CSS spin class added after entrance completes to avoid z-index/transform conflict. */
      if (pawBadge) {
        gsap.to(pawBadge, {
          opacity:         1,
          scale:           1,
          duration:        0.60,
          delay:           1.20,
          ease:            'back.out(2)',
          transformOrigin: 'center center',
          onComplete() {
            pawBadge.classList.add('is-spinning');
          },
        });
      }

      /* New badge */
      if (badge) {
        gsap.to(badge, {
          opacity:  1,
          scale:    1,
          y:        0,
          duration: 0.55,
          delay:    1.40,
          ease:     'back.out(1.8)',
        });
      }

      /* ─── 3. IMAGE SLOW ZOOM (continuous) ─────────── */
      const primaryHeroImg = S('.hero__img--desktop', hero) || S('[data-hero-img]', hero);
      if (primaryHeroImg && !mobile()) {
        gsap.fromTo(primaryHeroImg,
          { scale: 1.05 },
          { scale: 1.12, duration: 14, ease: 'none', yoyo: true, repeat: -1 }
        );
      }

      /* ─── 4. SCROLL PARALLAX ───────────────────────── */
      if (!mobile()) {
        const contentEl = S('[data-hero-content]', hero);
        if (contentEl) {
          gsap.to(contentEl, {
            yPercent: -16,
            ease:     'none',
            scrollTrigger: {
              trigger: hero,
              start:   'top top',
              end:     'bottom top',
              scrub:   1.2,
            },
          });
        }

        if (visual) {
          gsap.to(visual, {
            yPercent: -7,
            ease:     'none',
            scrollTrigger: {
              trigger: hero,
              start:   'top top',
              end:     'bottom top',
              scrub:   0.8,
            },
          });
        }

        /* Hero fade on scroll-out */
        gsap.to(hero, {
          opacity: 0.60,
          scale:   0.97,
          ease:    'none',
          scrollTrigger: {
            trigger: hero,
            start:   'bottom 80%',
            end:     'bottom top',
            scrub:   true,
          },
        });
      }

      /* ─── 5. HOVER — image zoom ─────────────────────── */
      if (imgFrame && !mobile()) {
        const img = S('.hero__img--desktop', hero) || S('[data-hero-img]', hero);
        if (img) {
          imgFrame.addEventListener('mouseenter', () => {
            gsap.to(img, { scale: 1.15, duration: 0.80, ease: 'power2.out', overwrite: 'auto' });
          });
          imgFrame.addEventListener('mouseleave', () => {
            gsap.to(img, { scale: 1.05, duration: 0.90, ease: 'power2.inOut', overwrite: 'auto' });
          });
        }
      }

      /* ─── 6. CTA SUBTLE PULSE ───────────────────────
         BUG FIX: original had no `overwrite` and conflicted with hover CSS transform.
         Now using a simpler box-shadow pulse instead of scale, avoiding transform conflicts.
      ─────────────────────────────────────────────── */
      const primaryBtn = S('.hero__btn--primary', hero);
      if (primaryBtn && !mobile()) {
        gsap.to(primaryBtn, {
          boxShadow: [
            '0 6px 22px color-mix(in srgb, var(--hero-accent) 40%, transparent), 0 2px 6px rgba(0,0,0,0.08)',
            '0 10px 32px color-mix(in srgb, var(--hero-accent) 60%, transparent), 0 4px 12px rgba(0,0,0,0.10)',
          ],
          duration: 2.2,
          ease:     'sine.inOut',
          yoyo:     true,
          repeat:   -1,
        });
      }

    }, hero);
  }

  /* ── Mobile sticky CTA ──────────────────────────────── */
  function initMobileCta() {
    if (!mobileCta || !mobile()) return;
    mobileCta.removeAttribute('aria-hidden');
    const btn = S('.hero__mobile-cta-btn', mobileCta);
    if (btn) btn.removeAttribute('tabindex');

    let ticking = false;
    const heroBottom = hero.getBoundingClientRect().bottom + window.scrollY;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrolled = window.scrollY > heroBottom * 0.3;
          mobileCta.classList.toggle('is-visible', scrolled);
          ticking = false;
        });
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* ── Boot ───────────────────────────────────────────── */
  function boot() {
    if (window.__heroGsap === 'ready') {
      initAnimations();
    } else {
      document.addEventListener('hero:gsap-ready', initAnimations, { once: true });
    }
    initMobileCta();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }

  /* ── Shopify Theme Editor ───────────────────────────── */
  document.addEventListener('shopify:section:unload', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    if (ctx) ctx.revert();
    ScrollTrigger?.getAll().forEach(t => t.kill());
  });
  document.addEventListener('shopify:section:load', e => {
    if (e.detail.sectionId !== '{{ section.id }}') return;
    boot();
  });

}());
</script>



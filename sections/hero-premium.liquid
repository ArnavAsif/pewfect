.hero__stat-icon {
  font-size:   1.3rem;
  line-height: 1;
}
.hero__stat-icon-wrap {
  font-size:   1.3rem;
  line-height: 1;
}

/* Paw badge
   BUG FIX: Removed always-on spin animation from CSS.
   GSAP sets initial scale(0), then animates in.

}

/* New badge */
.hero__new-badge {
  position:        absolute;
  top:             8%;
  left:            -2%;
  background:      linear-gradient(135deg, var(--hero-accent), color-mix(in srgb, var(--hero-accent) 72%, #F4C06F));
  color:           #fff;
  font-size:       0.68rem;
  font-weight:     700;
  letter-spacing:  0.12em;
  text-transform:  uppercase;
  padding:         6px 14px;
  border-radius:   100px;
  box-shadow:      0 4px 16px color-mix(in srgb, var(--hero-accent) 40%, transparent);
  z-index:         10;
  opacity:         0;

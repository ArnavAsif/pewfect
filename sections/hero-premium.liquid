/* ══════════════════════════════════════════════════════════
   RIGHT — VISUAL COLUMN
══════════════════════════════════════════════════════════ */
.hero__visual {
  position:        relative;
  display:         flex;
  align-items:     center;
  justify-content: center;
  padding:         clamp(40px,6vh,80px) clamp(24px,4vw,60px);

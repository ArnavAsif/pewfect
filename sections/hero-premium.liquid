/* Float animations applied via .is-floating class (added by JS after GSAP entrance) */
.hero__stat--a.is-floating { animation: stat-float-a 5s ease-in-out infinite 0.4s; }
.hero__stat--b.is-floating { animation: stat-float-b 6s ease-in-out infinite; }

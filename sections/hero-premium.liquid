  /* ── KEY BUG FIX: swap image classes on mobile ── */
  .hero__img--desktop { display: none !important; }
  .hero__img--mobile  { display: block !important; }

  .hero__ring           { display:none; }
  .hero__blob--b,
  .hero__blob--c,
  .hero__blob--d        { display:none; }
  .hero__blob--a        { width:260px; height:260px; top:-70px; right:-50px; }

  .hero__content {
    padding:     22px 20px 36px;
    align-items: {{ text_align_m }};
    text-align:  var(--hero-tal-m);
  }
  .hero__heading { font-size:var(--hero-hm); }
  .hero__sub     { font-size:var(--hero-sm); max-width:100%; }

  .hero__eyebrow {
    {%- if text_align_m == 'center' %}
      margin-left:auto;
      margin-right:auto;
    {%- endif %}
  }

  .hero__pills {
    {%- if text_align_m == 'center' %}
      justify-content:center;
    {%- endif %}
  }

  .hero__ctas {
    flex-direction: column;
    width:          100%;
    align-items:    stretch;
    {%- if text_align_m == 'center' %}justify-content:center;{%- endif %}
  }
  .hero__btn { justify-content:center; text-align:center; }
  .hero__btn--primary { padding:17px 28px; font-size:1rem; }
  .hero__btn--ghost   { padding:15px 28px; }

  .hero__proof {
    flex-direction: column;
    gap:            8px;
    align-items:    center;
    text-align:     center;
    {%- if text_align_m == 'center' %}justify-content:center;{%- endif %}
  }

  .hero__stat { display:none; }
  .hero__paw-badge { bottom:3%; right:3%; }
  .hero__scroll-cue { display:none; }
  .hero__new-badge  { top:5%; left:auto; right:4%; }

  /* Show sticky mobile CTA */
  .hero__mobile-cta { display:block; }
}

/* ── Reduced-motion ─────────────────────────────────────── */
@media (prefers-reduced-motion:reduce) {
  .hero__blob,
  .hero__ring,
  .hero__stat,
  .hero__scroll-dot,
  .hero__paw-badge,
  .hero__img,
  .hero__img-frame,

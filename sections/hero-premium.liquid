{%- liquid
  assign s   = section.settings
  assign sid = 'hero-' | append: section.id
  assign use_gradient = false
  if s.gradient_from != blank and s.gradient_to != blank
    assign use_gradient = true
  endif

  assign bg_color   = s.bg_color   | default: '#F8F6F2'
  assign text_color = s.text_color | default: '#1C1917'
  assign sub_color  = s.sub_color  | default: '#6B6560'
  assign accent     = s.accent_color | default: '#D97757'

  assign heading_size_d = s.heading_size_desktop | default: 72
  assign heading_size_m = s.heading_size_mobile  | default: 38
  assign sub_size_d     = s.sub_size_desktop     | default: 18
  assign sub_size_m     = s.sub_size_mobile      | default: 15

  assign overlay_dec = s.overlay_opacity | divided_by: 100.0

  assign img_desktop = s.image_desktop
  assign img_mobile  = s.image_mobile
  assign img_alt     = s.image_alt | default: 'Happy pet with premium care products'

  assign text_align_d = s.text_align_desktop | default: 'left'
  assign text_align_m = s.text_align_mobile  | default: 'center'

  assign has_mobile_image = false
  if img_mobile != blank
    assign has_mobile_image = true
  endif
-%}

<section
  id="{{ sid }}"
  class="hero"
  aria-label="{{ s.heading | default: 'Hero' | escape }}"
  style="
    {%- if use_gradient -%}
      background: linear-gradient({{ s.gradient_angle | default: 135 }}deg,
        {{ s.gradient_from }}, {{ s.gradient_to }});
    {%- else -%}
      background-color: {{ bg_color }};
    {%- endif -%}
    --hero-accent:    {{ accent }};
    --hero-text:      {{ text_color }};
    --hero-sub:       {{ sub_color }};
    --hero-hd:        {{ heading_size_d }}px;
    --hero-hm:        {{ heading_size_m }}px;
    --hero-sd:        {{ sub_size_d }}px;
    --hero-sm:        {{ sub_size_m }}px;
    --hero-tal-d:     {{ text_align_d }};
    --hero-tal-m:     {{ text_align_m }};
    --hero-bg:        {{ bg_color }};
  "
  data-hero
>

  {%- comment %} ── GRAIN TEXTURE OVERLAY ── {% endcomment %}
  <div class="hero__grain" aria-hidden="true"></div>

  {%- comment %} ── AMBIENT BLOBS ── {% endcomment %}
  <div class="hero__blobs" aria-hidden="true">
    <div class="hero__blob hero__blob--a"></div>
    <div class="hero__blob hero__blob--b"></div>
    <div class="hero__blob hero__blob--c"></div>
    <div class="hero__blob hero__blob--d"></div>
  </div>

  {%- comment %} ── GRID ── {% endcomment %}
  <div class="hero__grid">

    {%- comment %} ════════════════════════════════
      LEFT — Content Column
    ════════════════════════════════ {% endcomment %}
    <div class="hero__content" data-hero-content>

      {%- comment %} Eyebrow tag {% endcomment %}
      {%- if s.eyebrow != blank %}
        <div class="hero__eyebrow" data-hero-eyebrow>
          <span class="hero__eyebrow-dot" aria-hidden="true"></span>
          <span>{{ s.eyebrow }}</span>
        </div>
      {%- endif %}

      {%- comment %} Main heading — words split for animation {% endcomment %}
      {%- if s.heading != blank %}
        <h1
          class="hero__heading"
          data-hero-heading
          id="{{ sid }}-heading"
          aria-label="{{ s.heading | escape }}"
        >
          {%- assign heading_words = s.heading | split: ' ' %}
          {%- for word in heading_words %}
            <span class="hero__word-wrap" aria-hidden="true">
              <span class="hero__word">{{ word }}</span>
            </span>
            {%- unless forloop.last %}<span class="hero__word-space" aria-hidden="true"> </span>{%- endunless %}
          {%- endfor %}
        </h1>
      {%- endif %}

      {%- comment %} Decorative accent line {% endcomment %}
      <div class="hero__accent-line" data-hero-line aria-hidden="true">
        <span class="hero__accent-line-fill"></span>
      </div>

      {%- comment %} Subheading {% endcomment %}
      {%- if s.subheading != blank %}
        <p class="hero__sub" data-hero-sub>
          {{ s.subheading }}
        </p>
      {%- endif %}

      {%- comment %} Optional feature pills {% endcomment %}
      {%- if s.show_feature_pills %}
        <div class="hero__pills" data-hero-pills aria-label="Key features">
          {%- assign pills = s.feature_pills | split: ',' %}
          {%- for pill in pills %}
            <span class="hero__pill">
              <span class="hero__pill-dot" aria-hidden="true"></span>
              {{ pill | strip }}
            </span>
          {%- endfor %}
        </div>
      {%- endif %}

      {%- comment %} CTA buttons {% endcomment %}
      <div class="hero__ctas" data-hero-cta>

        {%- if s.cta_text != blank %}
          <a
            href="{{ s.cta_url | default: '/collections/all' }}"
            class="hero__btn hero__btn--primary"
            aria-label="{{ s.cta_text | escape }}"
          >
            <span class="hero__btn-label">{{ s.cta_text }}</span>
            <span class="hero__btn-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24"
                   fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L12 5M19 12L12 19"
                      stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="hero__btn-glow" aria-hidden="true"></span>
            <span class="hero__btn-ripple" aria-hidden="true"></span>
          </a>
        {%- endif %}

        {%- if s.cta2_text != blank %}
          <a
            href="{{ s.cta2_url | default: '/pages/about' }}"
            class="hero__btn hero__btn--ghost"
            aria-label="{{ s.cta2_text | escape }}"
          >
            <span>{{ s.cta2_text }}</span>
          </a>
        {%- endif %}

      </div>

      {%- comment %} Social proof strip {% endcomment %}
      {%- if s.show_social_proof %}
        <div class="hero__proof" data-hero-proof>
          <div class="hero__proof-avatars" aria-hidden="true">
            {%- for i in (1..5) %}
              <span class="hero__proof-avatar hero__proof-avatar--{{ i }}"></span>
            {%- endfor %}
          </div>
          <div class="hero__proof-text">
            <div class="hero__proof-stars" aria-label="5 star rating">
              {%- for i in (1..5) %}<span aria-hidden="true">★</span>{%- endfor %}
            </div>
            <p>{{ s.social_proof_text | default: 'Trusted by 50,000+ pet parents' }}</p>
          </div>
        </div>
      {%- endif %}

    </div>{%- comment %} /.hero__content {% endcomment %}

    {%- comment %} ════════════════════════════════
      RIGHT — Visual Column
    ════════════════════════════════ {% endcomment %}
    <div class="hero__visual" data-hero-visual aria-hidden="true">

      {%- comment %} Decorative rings {% endcomment %}
      <div class="hero__ring hero__ring--outer"></div>
      <div class="hero__ring hero__ring--mid"></div>
      <div class="hero__ring hero__ring--inner"></div>

      {%- comment %} Main image frame {% endcomment %}
      <div class="hero__img-frame" data-hero-img-frame>

        {%- comment %} Image overlay tint {% endcomment %}
        {%- if s.overlay_opacity > 0 %}
          <div
            class="hero__img-overlay"
            style="
              background: {{ s.overlay_color | default: '#F8F6F2' }};
              opacity:    {{ overlay_dec }};
            "
          ></div>
        {%- endif %}

        {%- comment %}
          ── IMAGE RENDERING — Bug-fixed logic ──
          BUG: Original code used `img_mobile | default: img_desktop` in the liquid assign,
          so `img_mobile != img_desktop` was never true when no mobile image was uploaded.
          Then CSS hid the desktop image on mobile → blank mobile view.
          FIX: Track `has_mobile_image` separately, always render a mobile-visible image.
        {% endcomment %}

        {%- if img_desktop != blank %}
          {{
            img_desktop
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 800, 1000, 1200, 1400',
              sizes: '(max-width: 767px) 100vw, 52vw',
              alt: img_alt,
              class: 'hero__img hero__img--desktop',
              data-hero-img: ''
          }}
        {%- endif %}

        {%- comment %} Mobile image: use mobile-specific if uploaded, else reuse desktop {% endcomment %}
        {%- if has_mobile_image %}
          {{
            img_mobile
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 900',
              sizes: '100vw',
              alt: img_alt,
              class: 'hero__img hero__img--mobile',
              data-hero-img: ''
          }}
        {%- elsif img_desktop != blank %}
          {%- comment %} Fallback: reuse desktop image for mobile, just different class {% endcomment %}
          {{
            img_desktop
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 900',
              sizes: '100vw',
              alt: img_alt,
              class: 'hero__img hero__img--mobile',
              data-hero-img: ''
          }}
        {%- else %}
          {%- comment %} No images at all — show illustrated placeholder {% endcomment %}
          <div class="hero__img-placeholder" data-hero-img>
            <div class="hero__placeholder-inner">
              <span class="hero__placeholder-emoji" aria-hidden="true">🐾</span>
              <svg viewBox="0 0 480 560" fill="none"
                   xmlns="http://www.w3.org/2000/svg"
                   class="hero__placeholder-svg"
                   aria-hidden="true">
                <ellipse cx="240" cy="340" rx="180" ry="200" fill="{{ accent }}" opacity="0.08"/>
                <ellipse cx="165" cy="155" rx="52"  ry="70"  fill="{{ accent }}" opacity="0.14"/>
                <ellipse cx="315" cy="155" rx="52"  ry="70"  fill="{{ accent }}" opacity="0.14"/>
                <ellipse cx="110" cy="230" rx="42"  ry="58"  fill="{{ accent }}" opacity="0.10"/>
                <ellipse cx="370" cy="230" rx="42"  ry="58"  fill="{{ accent }}" opacity="0.10"/>
                <text x="240" y="370" text-anchor="middle" font-size="120"
                      fill="{{ accent }}" opacity="0.25">🐶</text>
                <text x="240" y="490" text-anchor="middle" font-size="15"
                      fill="{{ sub_color }}" font-weight="600" opacity="0.5">
                  Upload a hero image in Theme Editor
                </text>
              </svg>
            </div>
          </div>
        {%- endif %}

      </div>{%- comment %} /.hero__img-frame {% endcomment %}

      {%- comment %} Floating stat cards {% endcomment %}
      {%- if s.show_stat_cards %}
        <div class="hero__stat hero__stat--a" data-hero-float="a" role="img"
             aria-label="{{ s.stat_a_num | default: '50k+' }} {{ s.stat_a_label | default: 'Happy Pets' }}">
          <span class="hero__stat-icon-wrap" aria-hidden="true">🐶</span>
          <div>
            <span class="hero__stat-num">{{ s.stat_a_num | default: '50k+' }}</span>
            <span class="hero__stat-label">{{ s.stat_a_label | default: 'Happy Pets' }}</span>
          </div>
        </div>
        <div class="hero__stat hero__stat--b" data-hero-float="b" role="img"
             aria-label="{{ s.stat_b_num | default: '4.9' }} {{ s.stat_b_label | default: 'Avg Rating' }}">
          <span class="hero__stat-icon" aria-hidden="true">⭐</span>
          <div>
            <span class="hero__stat-num">{{ s.stat_b_num | default: '4.9' }}</span>
            <span class="hero__stat-label">{{ s.stat_b_label | default: 'Avg Rating' }}</span>
          </div>
        </div>
        {%- if s.show_stat_c %}
          <div class="hero__stat hero__stat--c" data-hero-float="c" role="img"
               aria-label="{{ s.stat_c_num | default: '100%' }} {{ s.stat_c_label | default: 'Natural' }}">
            <span class="hero__stat-icon" aria-hidden="true">🌿</span>
            <div>
              <span class="hero__stat-num">{{ s.stat_c_num | default: '100%' }}</span>
              <span class="hero__stat-label">{{ s.stat_c_label | default: 'Natural' }}</span>
            </div>
          </div>
        {%- endif %}
      {%- endif %}

      {%- comment %} Decorative paw badge {% endcomment %}
      <div class="hero__paw-badge" data-hero-paw aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="31"
                  fill="{{ accent }}" opacity="0.10"
                  stroke="{{ accent }}" stroke-width="1"
                  stroke-dasharray="5 3"/>
          <text x="32" y="42" text-anchor="middle" font-size="28">🐾</text>
        </svg>
      </div>

      {%- comment %} New badge {% endcomment %}
      {%- if s.show_new_badge and s.new_badge_text != blank %}
        <div class="hero__new-badge" data-hero-badge aria-hidden="true">
          <span>{{ s.new_badge_text }}</span>
        </div>
      {%- endif %}

    </div>{%- comment %} /.hero__visual {% endcomment %}

  </div>{%- comment %} /.hero__grid {% endcomment %}

  {%- comment %} ── SCROLL CUE ── {% endcomment %}
  {%- if s.show_scroll_cue %}
    <div class="hero__scroll-cue" data-hero-scroll-cue aria-hidden="true">
      <div class="hero__scroll-mouse">
        <div class="hero__scroll-dot"></div>
      </div>
      <span class="hero__scroll-label">Scroll</span>
    </div>
  {%- endif %}

  {%- comment %} ── MOBILE STICKY CTA ── {% endcomment %}
  {%- if s.cta_text != blank and s.show_mobile_sticky_cta %}
    <div class="hero__mobile-cta" data-hero-mobile-cta aria-hidden="true">
      <a href="{{ s.cta_url | default: '/collections/all' }}"
         class="hero__mobile-cta-btn"
         tabindex="-1">
        {{ s.cta_text }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M5 12H19M19 12L12 5M19 12L12 19"
                stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  {%- endif %}

</section>


{%- comment %} ══════════════════════════════════════════════════════════
   STYLES
══════════════════════════════════════════════════════════ {% endcomment %}
<style>

/* ── Utility ──────────────────────────────────────────────── */
.visually-hidden {
  position:absolute; width:1px; height:1px;
  padding:0; margin:-1px; overflow:hidden;
  clip:rect(0,0,0,0); white-space:nowrap; border:0;
}

/* ── Section base ─────────────────────────────────────────── */
#{{ sid }} {
  position:   relative;
  min-height: 100svh;
  display:    flex;
  align-items:center;
  overflow:   hidden;
  isolation:  isolate;
}

/* ── Grain texture ────────────────────────────────────────── */
.hero__grain {
  position:       absolute;
  inset:          0;
  z-index:        1;
  pointer-events: none;
  opacity:        0.030;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 180px 180px;
}

/* ── Ambient blobs ────────────────────────────────────────── */
.hero__blobs {
  position:       absolute;
  inset:          0;
  z-index:        0;
  pointer-events: none;
  overflow:       hidden;
}
.hero__blob {
  position:      absolute;
  border-radius: 50%;
  filter:        blur(90px);
  will-change:   transform;
}
.hero__blob--a {
  width:    560px;
  height:   560px;
  top:      -180px;
  right:    -100px;
  background: radial-gradient(circle,
    color-mix(in srgb, var(--hero-accent) 24%, transparent),
    transparent 68%);
  animation: blob-drift-a 14s ease-in-out infinite;
}
.hero__blob--b {
  width:    400px;
  height:   400px;
  bottom:   -120px;
  left:     -80px;
  background: radial-gradient(circle,
    color-mix(in srgb, var(--hero-accent) 16%, transparent),
    transparent 68%);
  animation: blob-drift-b 18s ease-in-out infinite;
}
.hero__blob--c {
  width:    280px;
  height:   280px;
  top:      38%;
  left:     38%;
  background: radial-gradient(circle,
    color-mix(in srgb, #F4C06F 18%, transparent),
    transparent 68%);
  animation: blob-drift-c 22s ease-in-out infinite;
}
.hero__blob--d {
  width:    320px;
  height:   320px;
  bottom:   15%;
  right:    10%;
  background: radial-gradient(circle,
    color-mix(in srgb, var(--hero-accent) 10%, transparent),
    transparent 68%);
  animation: blob-drift-b 26s ease-in-out infinite reverse;
  animation-delay: -8s;
}
@keyframes blob-drift-a {
  0%,100% { transform:translate(0,0) scale(1); }
  33%     { transform:translate(-32px,28px) scale(1.07); }
  66%     { transform:translate(22px,-20px) scale(0.94); }
}
@keyframes blob-drift-b {
  0%,100% { transform:translate(0,0); }
  50%     { transform:translate(30px,-24px); }
}
@keyframes blob-drift-c {
  0%,100% { transform:translate(0,0) scale(1); }
  40%     { transform:translate(-20px,32px) scale(1.09); }
  80%     { transform:translate(24px,12px) scale(0.93); }
}

/* ── Grid ─────────────────────────────────────────────────── */
.hero__grid {
  position:           relative;
  z-index:            2;
  display:            grid;
  grid-template-columns: 1fr 1.08fr;
  gap:                0;
  width:              100%;
  min-height:         100svh;
  max-width:          none;
}

/* ══════════════════════════════════════════════════════════
   LEFT — CONTENT COLUMN
══════════════════════════════════════════════════════════ */
.hero__content {
  display:        flex;
  flex-direction: column;
  justify-content:center;
  padding:        clamp(60px,8vh,110px) clamp(28px,5vw,80px)
                  clamp(60px,8vh,110px) clamp(28px,6vw,100px);
  gap:            0;
  text-align:     var(--hero-tal-d);
  position:       relative;
  z-index:        3;
}

/* Eyebrow */
.hero__eyebrow {
  display:        inline-flex;
  align-items:    center;
  gap:            8px;
  font-size:      0.74rem;
  font-weight:    700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color:          var(--hero-accent);
  margin-bottom:  22px;
  width:          fit-content;
  opacity:        0;
  will-change:    opacity, transform;
  {%- if text_align_d == 'center' %}margin-left:auto;margin-right:auto;{%- endif %}
  {%- if text_align_d == 'right'  %}margin-left:auto;{%- endif %}
}
.hero__eyebrow-dot {
  width:         8px;
  height:        8px;
  border-radius: 50%;
  background:    var(--hero-accent);
  flex-shrink:   0;
  animation:     eyebrow-pulse 2.4s ease-in-out infinite;
}
@keyframes eyebrow-pulse {
  0%,100% { transform:scale(1);   box-shadow:0 0 0 0 color-mix(in srgb, var(--hero-accent) 60%, transparent); }
  50%     { transform:scale(1.2); box-shadow:0 0 0 6px transparent; }
}

/* Heading */
.hero__heading {
  font-size:      var(--hero-hd);
  font-weight:    800;
  line-height:    1.07;
  letter-spacing: -0.038em;
  color:          var(--hero-text);
  margin:         0 0 18px;
  text-wrap:      balance;
}
.hero__word-wrap {
  display:       inline-block;
  overflow:      hidden;
  vertical-align:bottom;
  line-height:   1.14;
}
.hero__word {
  display:    inline-block;
  opacity:    0;
  transform:  translateY(110%);
  will-change:opacity, transform;
}
.hero__word-space {
  display: inline-block;
  width:   0.28em;
}

/* Accent line */
.hero__accent-line {
  width:         72px;
  height:        3px;
  border-radius: 3px;
  background:    color-mix(in srgb, var(--hero-accent) 25%, transparent);
  margin-bottom: 20px;
  overflow:      hidden;
  {%- if text_align_d == 'center' %}margin-left:auto;margin-right:auto;{%- endif %}
  {%- if text_align_d == 'right'  %}margin-left:auto;{%- endif %}
}
.hero__accent-line-fill {
  display:       block;
  height:        100%;
  background:    var(--hero-accent);
  border-radius: inherit;
  width:         0%;
  will-change:   width;
}

/* Subheading */
.hero__sub {
  font-size:   var(--hero-sd);
  color:       var(--hero-sub);
  line-height: 1.74;
  margin:      0 0 30px;
  font-weight: 400;
  max-width:   440px;
  opacity:     0;
  transform:   translateY(18px);
  will-change: opacity, transform;
  {%- if text_align_d == 'center' %}margin-left:auto;margin-right:auto;{%- endif %}
  {%- if text_align_d == 'right'  %}margin-left:auto;{%- endif %}
}

/* Feature pills */
.hero__pills {
  display:      flex;
  flex-wrap:    wrap;
  gap:          8px;
  margin-bottom:28px;
  opacity:      0;
  transform:    translateY(14px);
  will-change:  opacity, transform;
  {%- if text_align_d == 'center' %}justify-content:center;{%- endif %}
  {%- if text_align_d == 'right'  %}justify-content:flex-end;{%- endif %}
}
.hero__pill {
  display:       inline-flex;
  align-items:   center;
  gap:           6px;
  padding:       6px 14px;
  border-radius: 100px;
  background:    color-mix(in srgb, var(--hero-accent) 10%, transparent);
  border:        1.5px solid color-mix(in srgb, var(--hero-accent) 22%, transparent);
  color:         var(--hero-accent);
  font-size:     0.76rem;
  font-weight:   600;
  letter-spacing:0.04em;
  white-space:   nowrap;
  transition:    background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
}
.hero__pill:hover {
  background:   color-mix(in srgb, var(--hero-accent) 18%, transparent);
  border-color: color-mix(in srgb, var(--hero-accent) 40%, transparent);
  transform:    translateY(-1px);
}
.hero__pill-dot {
  width:         5px;
  height:        5px;
  border-radius: 50%;
  background:    var(--hero-accent);
  opacity:       0.7;
  flex-shrink:   0;
}

/* CTA buttons */
.hero__ctas {
  display:      flex;
  align-items:  center;
  gap:          14px;
  flex-wrap:    wrap;
  opacity:      0;
  transform:    translateY(16px) scale(0.97);
  will-change:  opacity, transform;
  margin-bottom:34px;
  {%- if text_align_d == 'center' %}justify-content:center;{%- endif %}
  {%- if text_align_d == 'right'  %}justify-content:flex-end;{%- endif %}
}
.hero__btn {
  position:        relative;
  display:         inline-flex;
  align-items:     center;
  gap:             10px;
  text-decoration: none;
  font-weight:     700;
  letter-spacing:  0.04em;
  border-radius:   100px;
  cursor:          pointer;
  overflow:        hidden;
  white-space:     nowrap;
  border:          none;
}
.hero__btn--primary {
  background: linear-gradient(
    135deg,
    var(--hero-accent),
    color-mix(in srgb, var(--hero-accent) 72%, #F4C06F)
  );
  color:      #fff;
  padding:    16px 36px;
  font-size:  1rem;
  box-shadow:
    0 6px 22px color-mix(in srgb, var(--hero-accent) 40%, transparent),
    0 2px 6px rgba(0,0,0,0.08);
  transition:
    transform  0.38s cubic-bezier(0.34,1.56,0.64,1),
    box-shadow 0.30s ease;
}
.hero__btn--primary:hover,
.hero__btn--primary:focus-visible {
  transform:  translateY(-3px) scale(1.025);
  box-shadow:
    0 16px 40px color-mix(in srgb, var(--hero-accent) 52%, transparent),
    0 4px 12px rgba(0,0,0,0.10);
  outline:none;
}
.hero__btn--primary:focus-visible {
  outline:        3px solid var(--hero-accent);
  outline-offset: 4px;
}
.hero__btn--primary:active { transform:scale(0.97); }

.hero__btn-label { position:relative; z-index:1; }
.hero__btn-arrow {
  position:   relative;
  z-index:    1;
  display:    flex;
  align-items:center;
  transition: transform 0.28s ease;
}
.hero__btn--primary:hover .hero__btn-arrow,
.hero__btn--primary:focus-visible .hero__btn-arrow {
  transform: translateX(4px);
}
.hero__btn-glow {
  position:   absolute;
  inset:      0;
  background: linear-gradient(135deg, rgba(255,255,255,0.22), transparent 55%);
  border-radius:inherit;
  pointer-events:none;
  z-index:    0;
}

/* Ripple on click */
.hero__btn-ripple {
  position:      absolute;
  inset:         0;
  border-radius: inherit;
  pointer-events:none;
  z-index:       0;
  overflow:      hidden;
}
.hero__btn--primary:active .hero__btn-ripple::after {
  content:       '';
  position:      absolute;
  top:           50%;
  left:          50%;
  width:         0;
  height:        0;
  background:    rgba(255,255,255,0.35);
  border-radius: 50%;
  transform:     translate(-50%,-50%);
  animation:     btn-ripple 0.5s ease-out forwards;
}
@keyframes btn-ripple {
  to { width:240px; height:240px; opacity:0; }
}

.hero__btn--ghost {
  background:  transparent;
  color:       var(--hero-text);
  border:      2px solid color-mix(in srgb, var(--hero-text) 20%, transparent);
  padding:     14px 28px;
  font-size:   0.92rem;
  transition:
    background  0.28s ease,
    border-color 0.28s ease,
    color       0.28s ease,
    transform   0.30s cubic-bezier(0.34,1.56,0.64,1);
}
.hero__btn--ghost:hover,
.hero__btn--ghost:focus-visible {
  background:   color-mix(in srgb, var(--hero-text) 6%, transparent);
  border-color: color-mix(in srgb, var(--hero-text) 50%, transparent);
  transform:    translateY(-2px);
  outline:      none;
}
.hero__btn--ghost:focus-visible {
  outline:        2px solid var(--hero-text);
  outline-offset: 3px;
}

/* Social proof */
.hero__proof {
  display:     flex;
  align-items: center;
  gap:         14px;
  opacity:     0;
  will-change: opacity, transform;
  {%- if text_align_d == 'center' %}justify-content:center;{%- endif %}
  {%- if text_align_d == 'right'  %}justify-content:flex-end;{%- endif %}
}
.hero__proof-avatars {
  display:   flex;
  flex-wrap: nowrap;
}
.hero__proof-avatar {
  width:          38px;
  height:         38px;
  border-radius:  50%;
  border:         2.5px solid color-mix(in srgb, var(--hero-bg,#F8F6F2) 90%, transparent);
  overflow:       hidden;

/* ══════════════════════════════════════════════════════════
   RESPONSIVE — Mobile  ≤ 767px
   BUG FIX: Added `display:block` for .hero__img--mobile here.
   Added `display:none` for .hero__img--desktop here.
   Now the mobile fallback image (output as .hero__img--mobile even when
   it's the same desktop image) always shows on mobile.
══════════════════════════════════════════════════════════ */
@media (max-width:767px) {
  #{{ sid }} { min-height:auto; padding:0; }

  .hero__grid {
    grid-template-columns: 1fr;
    grid-template-rows:    auto auto;

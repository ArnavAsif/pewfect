}
.hero__proof-avatar:first-child { margin-left:0; }
/* Tinted avatar placeholders */
.hero__proof-avatar--1 { background: #FDDCB5; }
.hero__proof-avatar--2 { background: #C8E6D4; }
.hero__proof-avatar--3 { background: #D4C5F0; }
.hero__proof-avatar--4 { background: #FCC8C8; }
.hero__proof-avatar--5 { background: #C8E0F4; }
.hero__proof-avatar--1::after { content:'🐶'; }
.hero__proof-avatar--2::after { content:'🐱'; }
.hero__proof-avatar--3::after { content:'🐰'; }
.hero__proof-avatar--4::after { content:'🐹'; }
.hero__proof-avatar--5::after { content:'🦜'; }

.hero__proof-text { display:flex; flex-direction:column; gap:2px; }
.hero__proof-stars {
  color:          #F4B942;
  font-size:      0.80rem;
  letter-spacing: 1px;
  line-height:    1;
  display:        flex;
  gap:            1px;
}
.hero__proof-text p {
  font-size:   0.77rem;
  color:       var(--hero-sub);

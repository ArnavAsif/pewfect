/* ══════════════════════════════════════════════════════════
   RESPONSIVE — Tablet  ≤ 1100px
══════════════════════════════════════════════════════════ */
@media (max-width:1100px) {
  .hero__grid { grid-template-columns:1fr 1fr; }

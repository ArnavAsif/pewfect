/* Decorative rings */
.hero__ring {
  position:      absolute;
  border-radius: 50%;
  border-style:  solid;
  pointer-events:none;
  will-change:   transform;
}
.hero__ring--outer {
  width:        90%;
  height:       90%;
  border-width: 1.5px;
